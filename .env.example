# Mẫu cấu hình môi trường phát triển & SSH Tunnel dự án Mission (YC-HT-02, YC-HT-03).
# Sao chép thành .env và điền giá trị thực tế; tệp .env tuyệt đối không được commit.

# ==============================================================================
# 1. THÔNG TIN TRUY CẬP SERVER DEV & ĐƯỜNG HẦM SSH (SSH TUNNEL)
# ==============================================================================
DEV_SERVER_HOST=
DEV_SERVER_SSH_PORT=2222
DEV_SERVER_USER=
DEV_SERVER_PASSWORD=
DEV_SERVER_INFRA_DIR=/home/provision/mission-infra

# Danh sách cổng hạ tầng trên server dev được ánh xạ về 127.0.0.1 qua SSH (-L local:127.0.0.1:remote)
# Mặc định gồm: Postgres(35432), Valkey/Redis(35379), Keycloak(35080), Apicurio(35081), Kafka UI(35082),
# Kafka Connect(35083), Kafka External(35094), ClickHouse(35123), Grafana(35300), MinIO(35900,35901), OpenSearch(35920)
TUNNEL_BIND_ADDRESS=127.0.0.1
TUNNEL_LOCAL_FORWARDS="35432:127.0.0.1:35432 35379:127.0.0.1:35379 35080:127.0.0.1:35080 35081:127.0.0.1:35081 35082:127.0.0.1:35082 35083:127.0.0.1:35083 35094:127.0.0.1:35094 35123:127.0.0.1:35123 35300:127.0.0.1:35300 35900:127.0.0.1:35900 35901:127.0.0.1:35901 35920:127.0.0.1:35920"

# Danh sách cổng dịch vụ chạy cục bộ muốn mở ngược lên server dev qua SSH (-R remote:127.0.0.1:local), để trống nếu không dùng
TUNNEL_REMOTE_FORWARDS=""

# ==============================================================================
# 2. CẤU HÌNH ĐỘNG CHO BACKEND (SPRING BOOT / GO / PYTHON)
# Khi bật SSH tunnel (`./scripts/dev-tunnel.sh start`), toàn bộ hạ tầng truy cập qua 127.0.0.1
# ==============================================================================
# PostgreSQL 16 (dùng chung cho mission-core và các microservice)
DB_HOST=127.0.0.1
DB_PORT=35432
DB_NAME=mission
DB_USER=mission
DB_PASSWORD=
DATABASE_URL=postgres://mission:@127.0.0.1:35432/mission?sslmode=disable

# Valkey / Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=35379
REDIS_PASSWORD=
REDIS_ADDR=127.0.0.1:35379

# Redpanda / Kafka & Apicurio Schema Registry
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:35094
APICURIO_URL=http://127.0.0.1:35081/apis/registry/v2

# Keycloak (SSO / OIDC)
KEYCLOAK_URL=http://localhost:35080
KEYCLOAK_REALM=mission
KEYCLOAK_ISSUER_URI=http://localhost:35080/realms/mission

# OPA (Open Policy Agent) & OpenBao (KMS / Transit)
OPA_URL=http://127.0.0.1:35181
OPENBAO_URL=http://127.0.0.1:35200
OPENBAO_TOKEN=

# MinIO (S3 Object Storage)
MINIO_ENDPOINT=http://127.0.0.1:35900
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# Cổng lắng nghe của các dịch vụ Backend
CORE_PORT=8080
TENANT_REGISTRY_PORT=8083
ORG_SERVICE_PORT=8084
WORKFLOW_SERVICE_PORT=8087
UI_PACK_SERVICE_PORT=8090
SCORING_ENGINE_PORT=8091
NOTIFICATION_SERVICE_PORT=8092
SIGNATURE_SERVICE_PORT=8093
REPORT_SERVICE_PORT=8094
SYNC_AGENT_PORT=8095
AUDIT_COLLECTOR_PORT=8096

# ==============================================================================
# 3. CẤU HÌNH ĐỘNG CHO FRONTEND (WEB SHELL + 11 MICRO-FRONTEND)
# Thay đổi tại .env có hiệu lực ngay khi tải lại trang trên trình duyệt — không cần build lại
# ==============================================================================
WEB_PORT=4200
CELL=cell-tw
TENANT=default
API_BASE_URL=/api
UI_PACK_BASE_URL=/ui-packs
AUTH_ENABLED=true
AUTH_ISSUER=http://localhost:35080/realms/mission
AUTH_CLIENT_ID=mission-web
USE_MOCK_API=false

# Đích reverse-proxy cho các lời gọi /api/v1/* từ trình duyệt qua cổng WEB_PORT (tránh lỗi CORS và không cần mở nhiều cổng)
API_PROXY_TARGET=http://127.0.0.1:8080
TENANT_REGISTRY_URL=http://127.0.0.1:8083
ORG_SERVICE_URL=http://127.0.0.1:8084
UI_PACK_SERVICE_URL=http://127.0.0.1:8090
