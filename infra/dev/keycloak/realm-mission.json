{
  "realm": "mission",
  "enabled": true,
  "displayName": "Hệ thống Giao nhiệm vụ, Quản lý OKR/KPI & Đánh giá Cán bộ",
  "loginTheme": "mission",
  "organizationsEnabled": true,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "vi",
    "en"
  ],
  "defaultLocale": "vi",
  "bruteForceProtected": true,
  "passwordPolicy": "length(8)",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "attributes": {
    "acr.loa.map": "{\"aal1\": 1, \"aal2\": 2}"
  },
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "browserFlow": "mission-browser",
  "roles": {
    "realm": [
      {
        "name": "platform_admin",
        "description": "AC-01 Quản trị nền tảng (Viettel)"
      },
      {
        "name": "wf_template_author",
        "description": "AC-01 Vai trò con: soạn mẫu luồng duyệt (BS-01, SCR-1505)"
      },
      {
        "name": "tenant_admin",
        "description": "AC-02 Quản trị tenant"
      },
      {
        "name": "policy_author",
        "description": "AC-03 Quản trị nghiệp vụ, BA cấu hình"
      },
      {
        "name": "leader",
        "description": "AC-04 Lãnh đạo, người đứng đầu"
      },
      {
        "name": "manager",
        "description": "AC-05 Cán bộ quản lý trực tiếp"
      },
      {
        "name": "member",
        "description": "AC-06 Cán bộ, công chức, viên chức, đảng viên"
      },
      {
        "name": "appraiser",
        "description": "AC-07 Cơ quan tổ chức cán bộ (thẩm định)"
      },
      {
        "name": "decider",
        "description": "AC-08 Cấp có thẩm quyền quyết định"
      },
      {
        "name": "second_approver",
        "description": "AC-09 Người duyệt thứ hai (four-eyes)"
      },
      {
        "name": "inspector",
        "description": "AC-10 Cơ quan kiểm tra, giám sát"
      },
      {
        "name": "ai_readonly",
        "description": "AC-12 Trợ lý AI (chỉ đọc)"
      },
      {
        "name": "svc_org_service",
        "description": "Tài khoản dịch vụ org-service (SVC-03) gọi API nội bộ của integration-gateway: /internal/v1/integ/sync-runs, mapping-xref (DV-13-06)"
      }
    ]
  },
  "clientScopes": [
    {
      "name": "basic",
      "description": "OpenID Connect scope for add all basic claims to the token",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "claim.name": "auth_time",
            "jsonType.label": "long",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect built-in scope: profile",
      "protocol": "openid-connect",
