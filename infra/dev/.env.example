# Mẫu cấu hình hạ tầng dev. Sao chép thành .env (hoặc chạy scripts/gen-env.sh để sinh mật khẩu).
# .env KHÔNG được commit.

# Địa chỉ công khai dùng trong URL trả cho trình duyệt (Keycloak, Kafka EXTERNAL)
PUBLIC_HOST=localhost
BIND_ADDR=0.0.0.0
# Thư mục dữ liệu bind mount (đặt trên ổ còn nhiều chỗ)
DATA_DIR=./data

PG_SUPERUSER=postgres
PG_SUPERUSER_PASSWORD=__GENERATE__
MISSION_DB_PASSWORD=__GENERATE__
KEYCLOAK_DB_PASSWORD=__GENERATE__
VALKEY_PASSWORD=__GENERATE__
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
MINIO_ROOT_USER=mission
MINIO_ROOT_PASSWORD=__GENERATE__
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=__GENERATE__
CLICKHOUSE_PASSWORD=__GENERATE__
GRAFANA_ADMIN_PASSWORD=__GENERATE__
# WEB-056: mật khẩu chung của các tài khoản thử trong realm `mission`, khoá TOTP thử (chuỗi chữ và số, dùng để sinh
# mã OTP trong kiểm thử tự động WEB-057) và secret client mission-core. Chỉ cho dev, không dùng ở môi trường khác.
KC_TEST_USER_PASSWORD=__GENERATE__
KC_TEST_OTP_SECRET=__GENERATE__
MISSION_CORE_CLIENT_SECRET=__GENERATE__

# Cổng (dải 35xxx, tránh các cổng đã dùng trên server dev)
PG_PORT=35432
VALKEY_PORT=35379
KEYCLOAK_PORT=35080
MINIO_API_PORT=35900
MINIO_CONSOLE_PORT=35901
MAILPIT_SMTP_PORT=35025
MAILPIT_UI_PORT=35825
KAFKA_EXTERNAL_PORT=35094
APICURIO_PORT=35081
CONNECT_PORT=35083
KAFKA_UI_PORT=35082
OPENSEARCH_PORT=35920
CLICKHOUSE_HTTP_PORT=35123
GRAFANA_PORT=35300
OTLP_GRPC_PORT=35317
OTLP_HTTP_PORT=35318
GATEWAY_PORT=35000
WEB_PORT=35200

KEYCLOAK_PUBLIC_URL=http://localhost:35080
WEB_PUBLIC_URL=http://localhost:35200
WEB_AUTH_ENABLED=false
WEB_USE_MOCK_API=true
