# =============================================================================
# CẤU HÌNH HẠ TẦNG DEV DÙNG CHUNG — DỰ ÁN MISSION
# Sao chép tệp này thành .env (không commit .env lên Git) và điền mật khẩu.
#
# Mọi cổng dịch vụ đều nằm trong dải 35xxx và đọc động qua biến môi trường.
# Khi máy chủ dev không mở nhiều cổng tường lửa, giữ DEV_HOST=127.0.0.1 và
# mở cổng hầm SSH (SSH local port forwarding) từ máy trạm về 127.0.0.1:35xxx.
# =============================================================================

# Profile khởi chạy mặc định (core | core,security | core,security,events | all)
COMPOSE_PROFILES=core

# Địa chỉ IP/hostname dùng cho Kafka advertised listener và kết nối từ máy trạm
# Đặt 127.0.0.1 khi kết nối qua hầm SSH (SSH tunnel)
DEV_HOST=127.0.0.1

# --- PostgreSQL 17 (+ pg_partman) & PgBouncer (transaction mode) ---
POSTGRES_PORT=35432
PGBOUNCER_PORT=35433
POSTGRES_DB=mission
POSTGRES_USER=mission_admin
POSTGRES_PASSWORD=<FILL_IN>
# Mật khẩu mặc định cho bộ 4 tài khoản trên mỗi schema:
#   mig_<schema> (Flyway DDL), svc_<schema> (ứng dụng DML qua PgBouncer),
#   ro_<schema> (chỉ đọc), cdc_<schema> (Debezium WAL + outbox_event)
DB_ROLE_PASSWORD_DEFAULT=<FILL_IN>

# --- Valkey 8 ---
VALKEY_PORT=35379
VALKEY_PASSWORD=<FILL_IN>

# --- Keycloak 26 ---
KEYCLOAK_PORT=35080
KEYCLOAK_DB_PASSWORD=<FILL_IN>
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<FILL_IN>
# Bí mật nhập vào realm mission (realm-mission.json)
KC_TEST_USER_PASSWORD=<FILL_IN>
KC_TEST_OTP_SECRET=<FILL_IN>
MISSION_CORE_CLIENT_SECRET=<FILL_IN>
ORG_SERVICE_CLIENT_SECRET=<FILL_IN>

# --- OPA 1.x & OpenBao 2.x (profile: security) ---
OPA_PORT=35181
OPENBAO_PORT=35820
OPENBAO_DEV_ROOT_TOKEN=<FILL_IN>

# --- Kafka 3.9 (KRaft), Apicurio Registry 3.x, Debezium 3.x (profile: events) ---
KAFKA_PORT=35092
KAFKA_EXTERNAL_PORT=35094
APICURIO_PORT=35081
DEBEZIUM_PORT=35083
DEBEZIUM_DB_USER=cdc_debezium

# --- MinIO (S3) & OpenSearch 2.x (profile: search) ---
MINIO_API_PORT=35900
MINIO_CONSOLE_PORT=35901
# Gotenberg 8 (profile backend, document-service DV-11-01)
GOTENBERG_PORT=35330
# Máy chủ mô hình nhỏ chạy CPU (profile backend, ai-gateway DV-14-01)
LLM_MOCK_PORT=35340
# SoftHSM2 và máy chủ dấu thời gian giả lập (profile backend, esign-service DV-10-03)
ESIGN_HSM_PIN=<FILL_IN>
ESIGN_HSM_SO_PIN=<FILL_IN>
TSA_MOCK_PORT=35350
MINIO_ROOT_USER=mission_minio
MINIO_ROOT_PASSWORD=<FILL_IN>
OPENSEARCH_PORT=35200

# --- ClickHouse 25.8 kho phân tích (profile: analytics) ---
CLICKHOUSE_HTTP_PORT=35123
CLICKHOUSE_PASSWORD=<FILL_IN>
# Cube (DV-15-03): mật khẩu tài khoản <db>_cube do migrate.py tạo (ANALYTICS_CUBE_PASSWORD), khoá ký JWT,
# danh sách tenant (UUID, phân tách dấu phẩy) cần làm mới pre-aggregation
CUBE_PORT=35400
ANALYTICS_CUBE_PASSWORD=<FILL_IN>
CUBEJS_API_SECRET=<FILL_IN>
CUBE_REFRESH_TENANTS=
# Cube SQL API cho Superset (DV-15-05): tài khoản kỹ thuật duy nhất được đổi người dùng sang JWT Cube
CUBE_SQL_USER=superset_ky_thuat
CUBE_SQL_PASSWORD=<FILL_IN>
# Superset nhúng (DV-15-05): khoá phiên, khoá ký guest token, quản trị kỹ thuật, tài khoản dịch vụ của analytics-api
SUPERSET_PORT=35088
SUPERSET_WEB_ORIGINS=http://localhost:4200
SUPERSET_SECRET_KEY=<FILL_IN>
SUPERSET_GUEST_TOKEN_SECRET=<FILL_IN>
SUPERSET_ADMIN_USER=quan_tri
SUPERSET_ADMIN_PASSWORD=<FILL_IN>
SUPERSET_SERVICE_USER=analytics_api
SUPERSET_SERVICE_PASSWORD=<FILL_IN>

# --- Observability: OTel, Tempo, Loki, Prometheus, Grafana (profile: obs) ---
OTEL_GRPC_PORT=35317
OTEL_HTTP_PORT=35318
TEMPO_PORT=35320
LOKI_PORT=35310
PROMETHEUS_PORT=35990
GRAFANA_PORT=35300
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=<FILL_IN>

# --- esign-service: MySign theo CSC API v2 (DV-10-02); giá trị thật nằm ở OpenBao, không ghi vào repo ---
ESIGN_MYSIGN_ENABLED=false
ESIGN_MYSIGN_BASE_URL=<FILL_IN>
ESIGN_MYSIGN_TOKEN_URL=<FILL_IN>
ESIGN_MYSIGN_CLIENT_ID=<FILL_IN>
ESIGN_MYSIGN_CLIENT_SECRET=<FILL_IN>
ESIGN_MYSIGN_SCOPE=
ESIGN_TSA_URL=
ESIGN_S3_ENDPOINT=<FILL_IN>
ESIGN_S3_BUCKET=dossier
ESIGN_S3_ACCESS_KEY=<FILL_IN>
ESIGN_S3_SECRET_KEY=<FILL_IN>
# --- esign-service: HSM PKCS#11 (dev: SoftHSM2), dấu thời gian RFC 3161, niêm phong sổ cái (DV-10-03) ---
# ESIGN_HSM_PIN và ESIGN_HSM_SO_PIN đặt ở khối SoftHSM2 phía trên; production nạp PIN từ OpenBao.
ESIGN_HSM_ENABLED=false
ESIGN_HSM_LIBRARY=<FILL_IN>
ESIGN_HSM_SLOT=
ESIGN_HSM_SLOT_LIST_INDEX=0
ESIGN_HSM_PROVISION_DEV_KEYS=true
SOFTHSM2_CONF=<FILL_IN>
ESIGN_TSA_ENABLED=false
ESIGN_TSA_URLS=http://127.0.0.1:35350/
ESIGN_TSA_TRUST_ANCHORS=infra/dev/softhsm/tsa/ca.pem
ESIGN_SEAL_ALLOWED_CLIENTS=ledger-service
ESIGN_ARCHIVE_TS_ENABLED=false
# notification-service kênh ngoài (DV-12-03); giá trị thật nằm ở OpenBao
NOTIFY_CHANNELS=
SMTP_ADDR=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=<FILL_IN>
SMTP_TLS=starttls
SMS_BASE_URL=
SMS_API_KEY=<FILL_IN>
SMS_BRANDNAME=
PUSH_MODE=
FCM_SERVICE_ACCOUNT_FILE=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
PUSH_INTERNAL_URL=
PUSH_INTERNAL_API_KEY=<FILL_IN>
KEYCLOAK_ADMIN_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=<FILL_IN>

# --- esign-service: MySign theo CSC API v2 (DV-10-02); giá trị thật nằm ở OpenBao, không ghi vào repo ---
ESIGN_MYSIGN_ENABLED=false
ESIGN_MYSIGN_BASE_URL=<FILL_IN>
ESIGN_MYSIGN_TOKEN_URL=<FILL_IN>
ESIGN_MYSIGN_CLIENT_ID=<FILL_IN>
ESIGN_MYSIGN_CLIENT_SECRET=<FILL_IN>
ESIGN_MYSIGN_SCOPE=
ESIGN_TSA_URL=
ESIGN_S3_ENDPOINT=<FILL_IN>
ESIGN_S3_BUCKET=dossier
ESIGN_S3_ACCESS_KEY=<FILL_IN>
ESIGN_S3_SECRET_KEY=<FILL_IN>
