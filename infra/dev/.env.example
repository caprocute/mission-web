# =============================================================================
# CẤU HÌNH HẠ TẦNG DEV DÙNG CHUNG — DỰ ÁN MISSION
# Sao chép tệp này thành .env (không commit .env lên Git) và điền mật khẩu.
#
# Mọi cổng dịch vụ đều nằm trong dải 35xxx và đọc động qua biến môi trường.
# Khi máy chủ dev không mở nhiều cổng tường lửa, giữ DEV_HOST=127.0.0.1 và
# mở cổng hầm SSH (SSH local port forwarding) từ máy trạm về 127.0.0.1:35xxx.
# =============================================================================

# Profile khởi chạy mặc định (core | core,security | core,security,events | all)
COMPOSE_PROFILES=core

# Địa chỉ IP/hostname dùng cho Kafka advertised listener và kết nối từ máy trạm
# Đặt 127.0.0.1 khi kết nối qua hầm SSH (SSH tunnel)
DEV_HOST=127.0.0.1

# --- PostgreSQL 17 (+ pg_partman) & PgBouncer (transaction mode) ---
POSTGRES_PORT=35432
PGBOUNCER_PORT=35433
POSTGRES_DB=mission
POSTGRES_USER=mission_admin
POSTGRES_PASSWORD=<FILL_IN>
# Mật khẩu mặc định cho bộ 4 tài khoản trên mỗi schema:
#   mig_<schema> (Flyway DDL), svc_<schema> (ứng dụng DML qua PgBouncer),
#   ro_<schema> (chỉ đọc), cdc_<schema> (Debezium WAL + outbox_event)
# Service Go của profile backend ghép mật khẩu này vào chuỗi kết nối postgres://, nên không dùng ký tự
# phải mã hoá URL (@ : / ? # %).
DB_ROLE_PASSWORD_DEFAULT=<FILL_IN>

# --- Valkey 8 ---
VALKEY_PORT=35379
VALKEY_PASSWORD=<FILL_IN>

# --- Keycloak 26 ---
KEYCLOAK_PORT=35080
KEYCLOAK_DB_PASSWORD=<FILL_IN>
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=<FILL_IN>
# Bí mật nhập vào realm mission (realm-mission.json)
KC_TEST_USER_PASSWORD=<FILL_IN>
KC_TEST_OTP_SECRET=<FILL_IN>
MISSION_CORE_CLIENT_SECRET=<FILL_IN>
ORG_SERVICE_CLIENT_SECRET=<FILL_IN>
# Bí mật client integration-gateway (cổng tích hợp đẩy lô nhân sự về org-service, HT-07).
INTEGRATION_GATEWAY_CLIENT_SECRET=<FILL_IN>
# Bí mật client tenant-registry-provisioner (saga cấp phát tenant gọi Keycloak Admin API, VH-04).
PROVISION_CLIENT_SECRET=<FILL_IN>
# Khoá cột C2 của tenant-registry: base64 của đúng 32 byte ngẫu nhiên (gen-env.sh tự sinh; tay: head -c 32 /dev/urandom | base64)
REGISTRY_C2_KEY=<FILL_IN>
# Khoá ký cookie định tuyến cell của tenant-registry: base64, tối thiểu 32 byte (gen-env.sh sinh như trên)
REGISTRY_ROUTING_COOKIE_C2_KEY=<FILL_IN>

# --- OPA 1.x & OpenBao 2.x (profile: security) ---
OPA_PORT=35181
# Bộ uỷ quyền OPA của service Java (okrkpi.opa): tắt thì API của mission-core trả 401. Timeout gọi OPA: mặc định
# của TL-01 là 50/100 ms cho OPA cùng pod; ở dev (container riêng hoặc qua đường hầm SSH, đo được 1,8–2,5 s) để 5s, nếu không
# lời gọi quá hạn và bị từ chối (fail closed, 403). Hồ sơ Spring dev của mission-core dùng cùng các biến này.
OPA_ENABLED=true
OPA_CONNECT_TIMEOUT=5s
OPA_READ_TIMEOUT=5s
OPENBAO_PORT=35820
OPENBAO_DEV_ROOT_TOKEN=<FILL_IN>

# --- Kafka 3.9 (KRaft), Apicurio Registry 3.x, Debezium 3.x (profile: events) ---
# KAFKA_PORT là listener TUNNEL: quảng bá KAFKA_TUNNEL_ADVERTISED_HOST:KAFKA_PORT, chỉ mở trên
# KAFKA_TUNNEL_BIND của máy chủ; dùng trên máy chủ và qua hầm SSH -L 35092:127.0.0.1:35092.
KAFKA_PORT=35092
KAFKA_TUNNEL_ADVERTISED_HOST=127.0.0.1
KAFKA_TUNNEL_BIND=127.0.0.1
# KAFKA_EXTERNAL_PORT quảng bá DEV_HOST, chỉ dùng khi tường lửa mở cổng này.
KAFKA_EXTERNAL_PORT=35094
APICURIO_PORT=35081
DEBEZIUM_PORT=35083
DEBEZIUM_DB_USER=cdc_debezium

# --- MinIO (S3) & OpenSearch 2.x (profile: search) ---
MINIO_API_PORT=35900
MINIO_CONSOLE_PORT=35901
# Ảnh MinIO: để trống dùng tag đã có trên server dev; máy mới (tag cũ không kéo được nữa) đặt ảnh Chainguard, ví dụ
# cgr.dev/chainguard/minio@sha256:d88920d6a50bd0b088223b688be3b76c63e6205dbe494437f67ba1240ea12880
MINIO_IMAGE=
# Gotenberg 8 (profile backend, document-service DV-11-01)
GOTENBERG_PORT=35330
# Máy chủ mô hình nhỏ chạy CPU (profile backend, ai-gateway DV-14-01)
LLM_MOCK_PORT=35340
# SoftHSM2 và máy chủ dấu thời gian giả lập (profile backend, esign-service DV-10-03)
ESIGN_HSM_PIN=<FILL_IN>
ESIGN_HSM_SO_PIN=<FILL_IN>
TSA_MOCK_PORT=35350
# --- Cổng API dev và service backend dựng từ repo (profile backend, INF-22) ---
# Chạy: scripts/deploy-backend.sh; kiểm thử khói: scripts/smoke-backend.sh (bảng cổng ở README mục 1).
APISIX_PORT=35000
# Tệp PEM chứng thư gốc bổ sung khi dựng ảnh sau proxy chặn TLS, đặt trong infra/dev (ví dụ ./data/build-ca.pem,
# thư mục không commit) vì compose chỉ đọc tệp trong thư mục dự án; để trống nếu không cần.
BUILD_CA_BUNDLE=
# Gốc Keycloak mà trình duyệt và kiểm thử khói dùng để đăng nhập: quyết định claim iss của token, nên service
# và APISIX kiểm iss theo giá trị này. Đăng nhập bằng địa chỉ khác (localhost thay 127.0.0.1) sẽ bị 401.
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:35080
# Gốc web thêm vào redirect URI của client mission-web khi Keycloak nhập realm. Web dev phục vụ sau APISIX (dịch
# vụ `web`), nên mặc định là địa chỉ APISIX; Keycloak đã nhập realm từ trước thì chạy scripts/cap-nhat-goc-web.sh.
WEB_ORIGIN=http://127.0.0.1:35000
# Dịch vụ web (profile backend): bật đăng nhập Keycloak, gọi máy chủ thật qua APISIX; module chưa có máy chủ
# giữ giả lập theo danh sách tiền tố cách nhau bằng dấu cách (ví dụ "dossiers oversight").
WEB_AUTH_ENABLED=true
WEB_USE_MOCK_API=false
WEB_MOCK_API_MODULES=
MISSION_CORE_PORT=35100
# Cổng quản trị (actuator) của mission-core, chỉ mở trên loopback máy chủ.
MISSION_CORE_MGMT_PORT=35101
MISSION_CORE_AUTH_ENABLED=true
TENANT_REGISTRY_PORT=35110
ORG_SERVICE_PORT=35111
WORKFLOW_SERVICE_PORT=35112
SCORING_SERVICE_PORT=35113
DOCUMENT_SERVICE_PORT=35114
EVIDENCE_SERVICE_PORT=35115
ESIGN_SERVICE_PORT=35116
INTEGRATION_GATEWAY_PORT=35117
ANALYTICS_API_PORT=35118
SEARCH_SERVICE_PORT=35119
LEDGER_SERVICE_PORT=35120
NOTIFICATION_SERVICE_PORT=35121
ESIGN_FAKE_PROVIDER=true
MINIO_ROOT_USER=mission_minio
MINIO_ROOT_PASSWORD=<FILL_IN>
OPENSEARCH_PORT=35200

# --- Bộ nhớ service Java (profile backend, INF-22) ---
# Giới hạn container (mem_limit) và heap (-Xmx) cho từng service; thiếu biến riêng thì dùng JAVA_MEM_LIMIT, JAVA_XMX.
# Mặc định cho máy chủ dev 16 GB chạy cùng hạ tầng: tổng heap khoảng 5 GB, tổng giới hạn khoảng 9 GB (giới hạn là
# trần, không phải phần giữ trước). Giữ mem_limit lớn hơn -Xmx ít nhất 384 MB cho metaspace, luồng và bộ đệm ngoài heap.
JAVA_MEM_LIMIT=768m
JAVA_XMX=384m
MISSION_CORE_MEM_LIMIT=1536m
MISSION_CORE_XMX=1g
WORKFLOW_SERVICE_MEM_LIMIT=1g
WORKFLOW_SERVICE_XMX=640m
DOCUMENT_SERVICE_MEM_LIMIT=1g
DOCUMENT_SERVICE_XMX=640m
# Ghi đè riêng khi cần, ví dụ: ORG_SERVICE_MEM_LIMIT=1g, ORG_SERVICE_XMX=640m (tương tự SCORING_SERVICE_, EVIDENCE_SERVICE_,
# ESIGN_SERVICE_, INTEGRATION_GATEWAY_, ANALYTICS_API_, SEARCH_SERVICE_).

# --- ClickHouse 25.8 kho phân tích (profile: analytics) ---
CLICKHOUSE_HTTP_PORT=35123
CLICKHOUSE_PASSWORD=<FILL_IN>
# Cube (DV-15-03): mật khẩu tài khoản <db>_cube do migrate.py tạo (ANALYTICS_CUBE_PASSWORD), khoá ký JWT,
# danh sách tenant (UUID, phân tách dấu phẩy) cần làm mới pre-aggregation
CUBE_PORT=35400
ANALYTICS_CUBE_PASSWORD=<FILL_IN>
CUBEJS_API_SECRET=<FILL_IN>
CUBE_REFRESH_TENANTS=
# Cube SQL API cho Superset (DV-15-05): tài khoản kỹ thuật duy nhất được đổi người dùng sang JWT Cube
CUBE_SQL_USER=superset_ky_thuat
CUBE_SQL_PASSWORD=<FILL_IN>
# Superset nhúng (DV-15-05): khoá phiên, khoá ký guest token, quản trị kỹ thuật, tài khoản dịch vụ của analytics-api
SUPERSET_PORT=35088
SUPERSET_WEB_ORIGINS=http://localhost:4200
SUPERSET_SECRET_KEY=<FILL_IN>
SUPERSET_GUEST_TOKEN_SECRET=<FILL_IN>
SUPERSET_ADMIN_USER=quan_tri
SUPERSET_ADMIN_PASSWORD=<FILL_IN>
SUPERSET_SERVICE_USER=analytics_api
SUPERSET_SERVICE_PASSWORD=<FILL_IN>

# --- Observability: OTel, Tempo, Loki, Prometheus, Grafana (profile: obs) ---
OTEL_GRPC_PORT=35317
OTEL_HTTP_PORT=35318
TEMPO_PORT=35320
LOKI_PORT=35310
PROMETHEUS_PORT=35990
GRAFANA_PORT=35300
GRAFANA_ADMIN=admin
GRAFANA_ADMIN_PASSWORD=<FILL_IN>

# --- esign-service: MySign theo CSC API v2 (DV-10-02); giá trị thật nằm ở OpenBao, không ghi vào repo ---
ESIGN_MYSIGN_ENABLED=false
ESIGN_MYSIGN_BASE_URL=<FILL_IN>
ESIGN_MYSIGN_TOKEN_URL=<FILL_IN>
ESIGN_MYSIGN_CLIENT_ID=<FILL_IN>
ESIGN_MYSIGN_CLIENT_SECRET=<FILL_IN>
ESIGN_MYSIGN_SCOPE=
ESIGN_TSA_URL=
ESIGN_S3_ENDPOINT=<FILL_IN>
ESIGN_S3_BUCKET=dossier
ESIGN_S3_ACCESS_KEY=<FILL_IN>
ESIGN_S3_SECRET_KEY=<FILL_IN>
# --- esign-service: HSM PKCS#11 (dev: SoftHSM2), dấu thời gian RFC 3161, niêm phong sổ cái (DV-10-03) ---
# ESIGN_HSM_PIN và ESIGN_HSM_SO_PIN đặt ở khối SoftHSM2 phía trên; production nạp PIN từ OpenBao.
ESIGN_HSM_ENABLED=false
ESIGN_HSM_LIBRARY=<FILL_IN>
ESIGN_HSM_SLOT=
ESIGN_HSM_SLOT_LIST_INDEX=0
ESIGN_HSM_PROVISION_DEV_KEYS=true
SOFTHSM2_CONF=<FILL_IN>
ESIGN_TSA_ENABLED=false
ESIGN_TSA_URLS=http://127.0.0.1:35350/
ESIGN_TSA_TRUST_ANCHORS=infra/dev/softhsm/tsa/ca.pem
ESIGN_SEAL_ALLOWED_CLIENTS=ledger-service
ESIGN_ARCHIVE_TS_ENABLED=false
# notification-service kênh ngoài (DV-12-03); giá trị thật nằm ở OpenBao
NOTIFY_CHANNELS=
SMTP_ADDR=
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=<FILL_IN>
SMTP_TLS=starttls
SMS_BASE_URL=
SMS_API_KEY=<FILL_IN>
SMS_BRANDNAME=
PUSH_MODE=
FCM_SERVICE_ACCOUNT_FILE=
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
PUSH_INTERNAL_URL=
PUSH_INTERNAL_API_KEY=<FILL_IN>
KEYCLOAK_ADMIN_URL=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=<FILL_IN>

# --- esign-service: MySign theo CSC API v2 (DV-10-02); giá trị thật nằm ở OpenBao, không ghi vào repo ---
ESIGN_MYSIGN_ENABLED=false
ESIGN_MYSIGN_BASE_URL=<FILL_IN>
ESIGN_MYSIGN_TOKEN_URL=<FILL_IN>
ESIGN_MYSIGN_CLIENT_ID=<FILL_IN>
ESIGN_MYSIGN_CLIENT_SECRET=<FILL_IN>
ESIGN_MYSIGN_SCOPE=
ESIGN_TSA_URL=
ESIGN_S3_ENDPOINT=<FILL_IN>
ESIGN_S3_BUCKET=dossier
ESIGN_S3_ACCESS_KEY=<FILL_IN>
ESIGN_S3_SECRET_KEY=<FILL_IN>
# --- esign-service: Viettel-CA và CA chuyên dùng Chính phủ (DV-10-04); bí mật client ở OpenBao, chứng thư gốc là tệp PEM gắn từ ConfigMap ---
ESIGN_VIETTEL_CA_ENABLED=false
ESIGN_VIETTEL_CA_BASE_URL=<FILL_IN>
ESIGN_VIETTEL_CA_TOKEN_URL=<FILL_IN>
ESIGN_VIETTEL_CA_CLIENT_ID=<FILL_IN>
ESIGN_VIETTEL_CA_CLIENT_SECRET=<FILL_IN>
ESIGN_VIETTEL_CA_SCOPE=
ESIGN_VIETTEL_CA_TRUST_ANCHORS=<FILL_IN>
ESIGN_VIETTEL_CA_OCSP_URL=<FILL_IN>
ESIGN_VIETTEL_CA_CRL_URL=
ESIGN_GOV_CA_ENABLED=false
ESIGN_GOV_CA_MODE=REMOTE
ESIGN_GOV_CA_BASE_URL=<FILL_IN>
ESIGN_GOV_CA_TOKEN_URL=<FILL_IN>
ESIGN_GOV_CA_CLIENT_ID=<FILL_IN>
ESIGN_GOV_CA_CLIENT_SECRET=<FILL_IN>
ESIGN_GOV_CA_SCOPE=
ESIGN_GOV_CA_TRUST_ANCHORS=<FILL_IN>
ESIGN_GOV_CA_OCSP_URL=<FILL_IN>
ESIGN_GOV_CA_CRL_URL=

# --- Chỗ lưu dữ liệu (INF-22) ---
# Để trống thì dùng volume có tên mission-dev_<tên>. Trên máy chủ dev dùng chung, dữ liệu đang nằm ở thư mục
# gắn sẵn: đặt đường dẫn tuyệt đối tới đúng thư mục đó trước khi chạy infra/dev/scripts/sync-server.sh apply,
# nếu không Postgres, Kafka, MinIO... sẽ khởi động trên volume trống.
POSTGRES_DATA=
VALKEY_DATA=
KAFKA_DATA=
MINIO_DATA=
OPENSEARCH_DATA=
TEMPO_DATA=
LOKI_DATA=
PROMETHEUS_DATA=
GRAFANA_DATA=
CLICKHOUSE_DATA=
