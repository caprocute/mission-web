<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEN-005 · ADR-16 · TL-01 Phụ lục B "Danh mục công nghệ".

  BOM phiên bản dùng chung cho mọi mã Java của hệ thống (mission-core, thư viện nền
  vt-platform-*, microservice Java). Đây là nơi DUY NHẤT ghim phiên bản phụ thuộc;
  mô-đun con không được tự ghi <version> cho thư viện đã có ở đây.

  Tệp này cố ý không có <parent>: POM cha backend/pom.xml kế thừa từ BOM này qua
  relativePath (để dùng được ngay trong reactor mà không phải cài trước), còn dự án
  Java nằm ngoài reactor thì import BOM theo scope "import" sau khi BOM được phát hành.

  Nguyên tắc chọn phiên bản: giữ đúng dòng phiên bản của Phụ lục B (tháng 10/2026)
  và lấy bản vá mới nhất còn được hỗ trợ của dòng đó, theo chính sách nâng cấp TL-04
  (bản vá trong 30 ngày, vá an ninh nghiêm trọng trong 7 ngày). Thư viện mà Spring Boot
  đã quản lý (Hibernate, Flyway, Log4j2, JUnit, Testcontainers, driver PostgreSQL, Kafka
  client) theo đúng phiên bản Spring Boot ghim để tránh lệch nhị phân giữa các starter.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>vn.viettel.okrkpi</groupId>
  <artifactId>platform-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Mission · BOM phiên bản nền tảng</name>
  <description>Ghim phiên bản phụ thuộc Java theo TL-01 Phụ lục B (ADR-16).</description>

  <properties>
    <!--
      Spring Boot 3.5: dòng Phụ lục B chốt. 3.5.16 là bản vá mới nhất của dòng 3.5
      tại thời điểm dựng khung; không nâng lên 4.x vì Phụ lục B chốt 3.5 và
      Spring Modulith 1.4 chỉ hỗ trợ Boot 3.5.
      Spring Boot 3.5.16 kéo theo: Hibernate ORM 6.6.53.Final (dòng 6.6 Phụ lục B),
      Flyway 11.7.2 (dòng 11), Log4j2 2.24.3 (dòng 2.24), JUnit 5.12.2,
      Testcontainers 1.21.4, PostgreSQL JDBC 42.7.11, Kafka client 3.9.2.
    -->
    <spring-boot.version>3.5.16</spring-boot.version>
    <!-- Spring Modulith 1.4: bản vá mới nhất của dòng 1.4 (dòng tương thích Boot 3.5). -->
    <spring-modulith.version>1.4.13</spring-modulith.version>
    <!-- Resilience4j 2.3: dòng Phụ lục B; 2.3.0 là bản duy nhất của dòng. -->
    <resilience4j.version>2.3.0</resilience4j.version>
    <!-- springdoc-openapi 2.8: dòng tương thích Boot 3.5 (3.x dành cho Boot 4). -->
    <springdoc.version>2.8.17</springdoc.version>
    <!-- ArchUnit 1.4: dòng Phụ lục B, bản vá mới nhất. -->
    <archunit.version>1.4.2</archunit.version>
    <!-- jqwik 1.9: dòng còn chạy trên JUnit Platform 1.12 mà Boot 3.5 dùng. -->
    <jqwik.version>1.9.3</jqwik.version>
    <!-- cel-java: "bản ổn định hiện hành" theo Phụ lục B. -->
    <cel-java.version>0.14.0</cel-java.version>
    <!--
      Apache Camel 4.x LTS: 4.14 là dòng LTS còn hỗ trợ dựng trên Spring Boot 3.5
      (dòng 4.18 dựng trên Spring Boot 4). Bản vá mới nhất 4.14.9.
    -->
    <camel.version>4.14.9</camel.version>
    <!-- Flowable 7.x: bản mới nhất của dòng 7 (dòng 8 dựng trên Spring Boot 4). -->
    <flowable.version>7.2.0</flowable.version>
    <!-- docx4j 11: dòng Jakarta XML Binding cho Java 11+, bản vá mới nhất. -->
    <docx4j.version>11.5.14</docx4j.version>
    <!-- OpenPDF 2.x: bản mới nhất của dòng 2 (thay iText 7 vì AGPL). -->
    <openpdf.version>2.4.0</openpdf.version>
    <!--
      uuid-creator 6.1: sinh UUIDv7 ở ứng dụng (TL-03 "Kiểu dữ liệu chuẩn", NEN-009);
      bản mới nhất của dòng 6, không có phụ thuộc bắc cầu.
    -->
    <uuid-creator.version>6.1.1</uuid-creator.version>
    <!--
      NEN-016 · ADR-12. Annotation @WithSpan của OpenTelemetry instrumentation: dòng 2.15 là
      dòng dựng trên OpenTelemetry API 1.49.0 mà Spring Boot 3.5.16 ghim (tránh lệch hội tụ).
      Bản thân API OpenTelemetry, Resilience4j Spring Boot 3 (resilience4j-bom) và Log4j2
      JsonTemplateLayout (log4j-bom của Spring Boot) đã được quản lý sẵn.
    -->
    <opentelemetry-instrumentation.version>2.15.0</opentelemetry-instrumentation.version>
    <!--
      LMAX Disruptor: bắt buộc cho AsyncLogger/AsyncRoot của Log4j2 (TL-01 "Log có cấu trúc");
      Log4j 2.24 hỗ trợ Disruptor 4.x. Spring Boot không quản lý phiên bản này.
    -->
    <disruptor.version>4.0.0</disruptor.version>
    <!--
      NEN-007 · ADR-03: hợp đồng sự kiện Avro qua Apicurio Registry 3.x (Phụ lục B).
      Apache Avro 1.12: dòng hiện hành, bản vá mới nhất 1.12.2; cùng phiên bản cho thư viện
      chạy (org.apache.avro:avro) và plugin sinh lớp (avro-maven-plugin) để mã sinh khớp runtime.
      Apicurio Registry 3.x: 3.3.3 là bản vá mới nhất của dòng 3; dùng cho plugin kiểm tương thích
      (apicurio-registry-maven-plugin) và ảnh registry chạy thử trong profile schema-compat.
      exec-maven-plugin: bước sinh lớp hằng EventTopics từ contracts/events/catalog.yaml và
      bật/tắt registry thử (suy luận về cách sinh; thẻ NEN-007 cho phép "một bước Maven đơn giản").
    -->
    <avro.version>1.12.2</avro.version>
    <apicurio-registry.version>3.3.3</apicurio-registry.version>
    <exec-maven-plugin.version>3.6.4</exec-maven-plugin.version>
    <!-- NEN-006 · ADR-32: sinh mã giao diện máy chủ và kiểm thử tương thích OpenAPI 3.1. -->
    <openapi-generator.version>7.13.0</openapi-generator.version>
    <openapi-diff.version>2.1.7</openapi-diff.version>
    <swagger-parser.version>2.1.31</swagger-parser.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <!--
        Khai báo tường minh đứng TRƯỚC các BOM import nên thắng phiên bản trong BOM.
        Chỉ dùng khi cần ghim khác Spring Boot, kèm lý do.
      -->
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit-junit5</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.archunit</groupId>
        <artifactId>archunit</artifactId>
        <version>${archunit.version}</version>
      </dependency>
      <dependency>
        <groupId>net.jqwik</groupId>
        <artifactId>jqwik</artifactId>
        <version>${jqwik.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.cel</groupId>
        <artifactId>cel</artifactId>
        <version>${cel-java.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.springdoc</groupId>
        <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
        <version>${springdoc.version}</version>
      </dependency>
      <dependency>
        <groupId>org.docx4j</groupId>
        <artifactId>docx4j-JAXB-ReferenceImpl</artifactId>
        <version>${docx4j.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.librepdf</groupId>
        <artifactId>openpdf</artifactId>
        <version>${openpdf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.f4b6a3</groupId>
        <artifactId>uuid-creator</artifactId>
        <version>${uuid-creator.version}</version>
      </dependency>
      <dependency>
        <groupId>io.opentelemetry.instrumentation</groupId>
        <artifactId>opentelemetry-instrumentation-annotations</artifactId>
        <version>${opentelemetry-instrumentation.version}</version>
      </dependency>
      <dependency>
        <groupId>com.lmax</groupId>
        <artifactId>disruptor</artifactId>
        <version>${disruptor.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro</artifactId>
        <version>${avro.version}</version>
      </dependency>
      <dependency>
        <groupId>org.openapitools.openapidiff</groupId>
        <artifactId>openapi-diff-core</artifactId>
        <version>${openapi-diff.version}</version>
        <exclusions>
          <exclusion>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser-v2-converter</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>io.swagger.parser.v3</groupId>
        <artifactId>swagger-parser</artifactId>
        <version>${swagger-parser.version}</version>
        <exclusions>
          <exclusion>
            <groupId>io.swagger.parser.v3</groupId>
            <artifactId>swagger-parser-v2-converter</artifactId>
          </exclusion>
          <exclusion>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-core</artifactId>
          </exclusion>
          <exclusion>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-models</artifactId>
          </exclusion>
          <exclusion>
            <groupId>io.swagger.core.v3</groupId>
            <artifactId>swagger-annotations</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>io.swagger.parser.v3</groupId>
        <artifactId>swagger-parser-v3</artifactId>
        <version>${swagger-parser.version}</version>
      </dependency>
      <dependency>
        <groupId>io.swagger.parser.v3</groupId>
        <artifactId>swagger-parser-core</artifactId>
        <version>${swagger-parser.version}</version>
      </dependency>
      <dependency>
        <groupId>io.swagger.parser.v3</groupId>
        <artifactId>swagger-parser-safe-url-resolver</artifactId>
        <version>${swagger-parser.version}</version>
      </dependency>

      <!-- BOM bên ngoài: Spring Boot (gồm Hibernate, Flyway, Log4j2, JUnit, Testcontainers). -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.springframework.modulith</groupId>
        <artifactId>spring-modulith-bom</artifactId>
        <version>${spring-modulith.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.github.resilience4j</groupId>
        <artifactId>resilience4j-bom</artifactId>
        <version>${resilience4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.camel.springboot</groupId>
        <artifactId>camel-spring-boot-bom</artifactId>
        <version>${camel.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.flowable</groupId>
        <artifactId>flowable-bom</artifactId>
        <version>${flowable.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
