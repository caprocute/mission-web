{
  "name": "outbox-tenant-data",
  "config": {
    "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
    "plugin.name": "pgoutput",
    "database.hostname": "${env:PG_HOST}",
    "database.port": "${env:PG_PORT}",
    "database.user": "${env:PG_CDC_USER}",
    "database.password": "${env:PG_CDC_PASSWORD}",
    "database.dbname": "tenant_data",
    "slot.name": "dbz_outbox_tenant_data",
    "publication.name": "pub_outbox",
    "publication.autocreate.mode": "disabled",
    "snapshot.mode": "never",
    "table.include.list": "okr.outbox_event,task.outbox_event,product.outbox_event,scoring.outbox_event,appraisal.outbox_event,config.outbox_event,oversight.outbox_event",
    "tombstones.on.delete": "false",
    "heartbeat.interval.ms": "10000",
    "heartbeat.action.query": "INSERT INTO public.debezium_heartbeat (slot_name, beat_at) VALUES ('dbz_outbox_tenant_data', now()) ON CONFLICT (slot_name) DO UPDATE SET beat_at = EXCLUDED.beat_at",
    "transforms": "outbox,headers",
    "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
    "transforms.outbox.table.field.event.id": "id",
    "transforms.outbox.table.field.event.key": "event_key",
    "transforms.outbox.table.field.event.payload": "payload",
    "transforms.outbox.route.by.field": "topic",
    "transforms.outbox.route.topic.replacement": "${routedByValue}",
    "transforms.outbox.table.fields.additional.placement": "headers:header:vt_outbox_headers",
    "transforms.headers.type": "vn.viettel.okrkpi.shared.outbox.connect.OutboxHeadersTransform",
    "transforms.headers.source.header": "vt_outbox_headers",
    "transforms.headers.long.headers": "apicurio.value.globalId",
    "key.converter": "org.apache.kafka.connect.storage.StringConverter",
    "value.converter": "org.apache.kafka.connect.converters.ByteArrayConverter",
    "header.converter": "org.apache.kafka.connect.converters.ByteArrayConverter",
    "producer.override.acks": "all",
    "producer.override.enable.idempotence": "true",
    "producer.override.compression.type": "zstd"
  }
}
