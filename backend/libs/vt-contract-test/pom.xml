    <artifactId>libs</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>vt-contract-test</artifactId>

  <name>Mission · kiểm thử tuân thủ hợp đồng OpenAPI 3.1</name>
  <description>So khớp /v3/api-docs thực tế với contracts/openapi/modules/*.yaml bằng openapi-diff và kiểm schema/examples (ADR-32).</description>

  <dependencies>
