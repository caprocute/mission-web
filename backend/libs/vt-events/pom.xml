<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEN-007 · ADR-03 · baseline mục 7 · TL-03 "Lược đồ sự kiện".

  Thư viện hợp đồng sự kiện dùng chung cho mọi service Java:
    - lớp Java sinh từ lược đồ Avro ở contracts/events/avro (avro-maven-plugin: chuỗi String,
      decimal -> BigDecimal, timestamp-micros -> Instant, date -> LocalDate);
    - lớp hằng vn.viettel.okrkpi.events.EventTopics sinh từ contracts/events/catalog.yaml;
    - kiểm thử JUnit đối chiếu lược đồ với danh mục (đủ 26 mã EVT, topic đúng quy ước, không
      trường C2, không thuộc tính phong bì CloudEvents trong thân).
  Profile -Pschema-compat: chạy Apicurio Registry 3.x trong Docker, đăng ký toàn bộ lược đồ với
  quy tắc BACKWARD_TRANSITIVE rồi test-update bản lược đồ đang sửa (xem contracts/events/README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>vn.viettel.okrkpi</groupId>
    <artifactId>mission-backend-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>vt-events</artifactId>

  <name>Mission · hợp đồng sự kiện Avro (vt-events)</name>
  <description>Lớp Java sinh từ lược đồ Avro EVT-01..EVT-26 và topic kỹ thuật, kèm hằng tên topic (NEN-007).</description>

  <properties>
    <!-- Nguồn sự thật của hợp đồng sự kiện (BACKEND.md mục 2). -->
    <events.contracts.dir>${project.basedir}/../../../contracts/events</events.contracts.dir>
    <events.generated.dir>${project.build.directory}/generated-sources/avro</events.generated.dir>

    <!-- Profile schema-compat (giá trị mặc định cho chạy cục bộ). -->
    <schema.compat.image>apicurio/apicurio-registry:${apicurio-registry.version}</schema.compat.image>
    <schema.compat.port>18081</schema.compat.port>
    <schema.compat.container>vt-events-apicurio</schema.compat.container>
    <schema.compat.rule>BACKWARD_TRANSITIVE</schema.compat.rule>
    <schema.compat.registryUrl>http://127.0.0.1:${schema.compat.port}/apis/registry/v3</schema.compat.registryUrl>
    <schema.compat.groupId>default</schema.compat.groupId>
    <!-- Bản đã phát hành (đăng ký trước) và bản đang sửa (test-update); CI trỏ baselineDir về nhánh đích. -->
    <schema.compat.baselineDir>${events.contracts.dir}/avro</schema.compat.baselineDir>
    <schema.compat.candidateDir>${events.contracts.dir}/avro</schema.compat.candidateDir>
    <schema.compat.docker.skip>false</schema.compat.docker.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.apache.avro</groupId>
      <artifactId>avro</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- Đọc catalog.yaml trong kiểm thử và trong bước sinh EventTopics (Spring Boot quản lý phiên bản). -->
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <!-- Đóng kèm lược đồ và danh mục vào jar để service đọc được lúc chạy (classpath:contracts/events/...). -->
      <resource>
        <targetPath>contracts/events</targetPath>
        <directory>${events.contracts.dir}</directory>
        <includes>
          <include>catalog.yaml</include>
          <include>avro/**/*.avsc</include>
        </includes>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>${exec-maven-plugin.version}</version>
        <executions>
          <!-- Sinh EventTopics.java vào cùng thư mục mã sinh của Avro (đã là gốc mã nguồn biên dịch). -->
          <execution>
            <id>generate-event-topics</id>
            <goals>
              <goal>exec</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <executable>${java.home}/bin/java</executable>
              <classpathScope>test</classpathScope>
              <arguments>
                <argument>-Dstdout.encoding=UTF-8</argument>
                <argument>-classpath</argument>
                <classpath/>
                <argument>${project.basedir}/src/build/java/GenerateEventTopics.java</argument>
                <argument>${events.contracts.dir}/catalog.yaml</argument>
                <argument>${events.generated.dir}</argument>
              </arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.avro</groupId>
        <artifactId>avro-maven-plugin</artifactId>
        <version>${avro.version}</version>
        <executions>
          <execution>
            <id>generate-avro</id>
            <goals>
              <goal>schema</goal>
            </goals>
            <phase>generate-sources</phase>
            <configuration>
              <sourceDirectory>${events.contracts.dir}/avro</sourceDirectory>
              <outputDirectory>${events.generated.dir}</outputDirectory>
              <!-- Lược đồ được tham chiếu (org.bootstrap.v1 bọc EVT-14..EVT-16) phân tích trước. -->
              <imports>
                <import>${events.contracts.dir}/avro/org/DonViDaThayDoi.avsc</import>
                <import>${events.contracts.dir}/avro/org/PhanCongDaThayDoi.avsc</import>
                <import>${events.contracts.dir}/avro/org/NhanSuDaThayDoi.avsc</import>
              </imports>
              <stringType>String</stringType>
              <enableDecimalLogicalType>true</enableDecimalLogicalType>
              <fieldVisibility>PRIVATE</fieldVisibility>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <systemPropertyVariables>
            <events.contracts.dir>${events.contracts.dir}</events.contracts.dir>
            <events.pom>${project.basedir}/pom.xml</events.pom>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Kiểm tương thích lược đồ với Apicurio Registry thật (TL-03 "Quy tắc tiến hoá lược đồ"):
        cd backend && ./mvnw -pl libs/vt-events -Pschema-compat verify
      Thứ tự trong pha integration-test: register (toàn bộ bản baselineDir) rồi test-update
      (bản candidateDir). Ví dụ kiểm bản sửa so với bản đã phát hành:
        ./mvnw -pl libs/vt-events -Pschema-compat verify \
          -Dschema.compat.baselineDir=/duong-dan/ban-phat-hanh/avro \
          -Dschema.compat.candidateDir=/duong-dan/ban-dang-sua/avro
      Dùng registry có sẵn: -Dschema.compat.docker.skip=true -Dschema.compat.registryUrl=...
      Danh sách artifact phải khớp catalog.yaml; EventCatalogTest kiểm điều này.
    -->
