      <id>schema-compat</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>${exec-maven-plugin.version}</version>
            <executions>
              <execution>
                <id>apicurio-start</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>pre-integration-test</phase>
                <configuration>
                  <skip>${schema.compat.docker.skip}</skip>
                  <executable>bash</executable>
                  <arguments>
                    <argument>${project.basedir}/src/test/registry/apicurio.sh</argument>
                    <argument>start</argument>
                    <argument>${schema.compat.image}</argument>
                    <argument>${schema.compat.port}</argument>
                    <argument>${schema.compat.container}</argument>
                    <argument>${schema.compat.rule}</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>apicurio-stop</id>
                <goals>
                  <goal>exec</goal>
                </goals>
                <phase>post-integration-test</phase>
                <configuration>
                  <skip>${schema.compat.docker.skip}</skip>
                  <executable>bash</executable>
                  <arguments>
                    <argument>${project.basedir}/src/test/registry/apicurio.sh</argument>
                    <argument>stop</argument>
                    <argument>${schema.compat.container}</argument>
