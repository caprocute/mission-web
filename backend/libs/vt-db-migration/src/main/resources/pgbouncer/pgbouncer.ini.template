;; NEN-033 · Cấu hình PgBouncer tham chiếu cho Mission (TL-03 "Kết nối và PgBouncer",
;; "Đặt ngữ cảnh tenant an toàn qua PgBouncer chế độ giao dịch").
;; Dùng cho NEN-020 (dev), NEN-034 (kiểm thử rò rỉ) và INF-11 (CloudNativePG Pooler).
;; Yêu cầu PgBouncer >= 1.21 (max_prepared_statements); TL-01 Phụ lục B chọn 1.23.
;; Biến ${...} được thay khi triển khai; không ghi mật khẩu vào tệp này.

[databases]
;; Silo: một CSDL dữ liệu tenant + cell_shared.
;;   td_hcm      = host=${PG_HOST} port=5432 dbname=td_hcm pool_size=60
;; Bridge: một mục cho MỖI CSDL dữ liệu tenant, tối đa 30 kết nối máy chủ mỗi CSDL (TL-03 L661).
;;   td_thainguyen = host=${PG_HOST} port=5432 dbname=td_thainguyen max_db_connections=30
;;   td_quangngai  = host=${PG_HOST} port=5432 dbname=td_quangngai max_db_connections=30
;; Pool: một CSDL chung cho mọi tenant.
;;   td_pool     = host=${PG_HOST} port=5432 dbname=td_pool pool_size=60
${PGBOUNCER_DATABASES}
cell_shared = host=${PG_HOST} port=5432 dbname=cell_shared

[pgbouncer]
listen_addr = 0.0.0.0
listen_port = 6432

;; Chế độ giao dịch: kết nối máy chủ chỉ gắn với khách trong một giao dịch. Vì vậy ngữ cảnh tenant
;; CHỈ được đặt bằng set_config('app.tenant_id', ?, true) / SET LOCAL trong giao dịch tường minh;
;; SET mức phiên bị cấm vì sẽ rò sang giao dịch của tenant khác dùng lại kết nối.
pool_mode = transaction

;; Câu lệnh chuẩn bị ở mức giao thức trong chế độ giao dịch (PgBouncer >= 1.21), để JDBC giữ
;; prepareThreshold mặc định.
max_prepared_statements = 200

;; Không cần reset ở chế độ giao dịch; kiểm kết nối trước khi giao lại.
server_reset_query =
server_check_query = select 1

;; Định cỡ (TL-03 "Kết nối và PgBouncer"): ~36 kết nối hoạt động ở CELL-HCM giờ cao điểm,
;; 25-60 kết nối máy chủ; mỗi pod HikariCP 20-40 kết nối tới PgBouncer.
default_pool_size = 60
max_client_conn = 4000

auth_type = scram-sha-256
auth_file = ${PGBOUNCER_AUTH_FILE}

;; TLS tới máy chủ và khách (TL-04 SEC: TLS 1.3 nội bộ); đường dẫn chứng chỉ do INF-11 cấp.
server_tls_sslmode = verify-full
client_tls_sslmode = require
