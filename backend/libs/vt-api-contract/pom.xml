<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEN-006 · ADR-32: Sinh giao diện controller và DTO từ 11 hợp đồng OpenAPI 3.1
  trong contracts/openapi/modules/*.yaml.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>vn.viettel.okrkpi</groupId>
    <artifactId>libs</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>vt-api-contract</artifactId>

  <name>Mission · hợp đồng API OpenAPI 3.1 (máy chủ)</name>
  <description>Giao diện Spring MVC và DTO sinh từ contracts/openapi/modules/*.yaml (ADR-32).</description>

  <properties>
    <contracts.modules.dir>${project.basedir}/../../../contracts/dist</contracts.modules.dir>
    <maven-antrun-plugin.version>3.1.0</maven-antrun-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.annotation</groupId>
      <artifactId>jakarta.annotation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>jakarta.validation</groupId>
      <artifactId>jakarta.validation-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        1. Tự động gộp hợp đồng OpenAPI (contracts/openapi/modules/*.yaml -> contracts/dist/*.yaml)
           nếu contracts/dist chưa tồn tại, bảo đảm chạy ổn định trong một lệnh Maven duy nhất.
        2. Sau khi openapi-generator chạy, sửa lỗi thoát dấu ngoặc kép (\\" -> \\\") bên trong
           @ExampleObject của OpenAPI Generator 7.13.0.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <version>${maven-antrun-plugin.version}</version>
        <executions>
          <execution>
            <id>bundle-contracts-if-missing</id>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>initialize</phase>
            <configuration>
              <target>
                <exec executable="sh" failonerror="true">
                  <arg value="${project.basedir}/../../tools/contracts-bundle.sh"/>
                  <arg value="--if-missing"/>
                </exec>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>fix-example-object-quotes</id>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>process-sources</phase>
            <configuration>
              <target>
                <replace dir="${project.build.directory}/generated-sources/openapi" token="\\&quot;" value="'">
                  <include name="**/*.java"/>
                </replace>
                <replace dir="${project.build.directory}/generated-sources/openapi" token="TRUE(&quot;true&quot;)" value="TRUE(Boolean.TRUE)">
                  <include name="**/*.java"/>
                </replace>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <configuration>
          <generatorName>spring</generatorName>
          <skipIfSpecIsUnchanged>true</skipIfSpecIsUnchanged>
          <generateSupportingFiles>false</generateSupportingFiles>
          <generateModelTests>false</generateModelTests>
          <generateModelDocumentation>false</generateModelDocumentation>
          <generateApiTests>false</generateApiTests>
          <generateApiDocumentation>false</generateApiDocumentation>
          <configOptions>
            <interfaceOnly>true</interfaceOnly>
            <useSpringBoot3>true</useSpringBoot3>
            <useTags>false</useTags>
            <useBeanValidation>true</useBeanValidation>
            <skipDefaultInterface>true</skipDefaultInterface>
            <openApiNullable>false</openApiNullable>
            <documentationProvider>springdoc</documentationProvider>
            <annotationLibrary>swagger2</annotationLibrary>
          </configOptions>
        </configuration>
        <executions>
          <execution>
            <id>generate-appraisals</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/appraisals.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.appraisals.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.appraisals.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>generate-config</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/config.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.config.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.config.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>generate-dossiers</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/dossiers.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.dossiers.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.dossiers.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>generate-jobs</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/jobs.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.jobs.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.jobs.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>generate-okr</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/okr.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.okr.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.okr.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>generate-org</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/org.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.org.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.org.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>generate-oversight</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/oversight.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.oversight.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.oversight.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>generate-platform</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/platform.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.platform.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.platform.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>generate-policies</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/policies.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.policies.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.policies.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>generate-products</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/products.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.products.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.products.model</modelPackage>
            </configuration>
          </execution>
          <execution>
            <id>generate-tasks</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contracts.modules.dir}/tasks.yaml</inputSpec>
              <output>${project.build.directory}/generated-sources/openapi</output>
              <apiPackage>vn.viettel.okrkpi.contract.tasks.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.contract.tasks.model</modelPackage>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!--
        Đóng gói thêm các classifier JAR theo x-mission.owner để dịch vụ độc lập
        (SVC-07 esign-service, SVC-13 ledger-service, SVC-10 ai-service, SVC-11 oversight)
        và SVC-05 mission-core có thể chỉ kéo phần hợp đồng của mình.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven-jar-plugin.version}</version>
        <executions>
          <execution>
            <id>jar-mission-core</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>mission-core</classifier>
              <includes>
                <include>vn/viettel/okrkpi/contract/domain/**</include>
                <include>vn/viettel/okrkpi/contract/application/**</include>
                <include>vn/viettel/okrkpi/contract/appraisals/**</include>
                <include>vn/viettel/okrkpi/contract/config/**</include>
                <include>vn/viettel/okrkpi/contract/dossiers/**</include>
                <include>vn/viettel/okrkpi/contract/jobs/**</include>
                <include>vn/viettel/okrkpi/contract/okr/**</include>
                <include>vn/viettel/okrkpi/contract/org/**</include>
                <include>vn/viettel/okrkpi/contract/platform/**</include>
                <include>vn/viettel/okrkpi/contract/policies/**</include>
                <include>vn/viettel/okrkpi/contract/products/**</include>
                <include>vn/viettel/okrkpi/contract/tasks/**</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>jar-esign</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>esign</classifier>
              <includes>
                <include>vn/viettel/okrkpi/contract/dossiers/**</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>jar-ledger</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>ledger</classifier>
              <includes>
                <include>vn/viettel/okrkpi/contract/oversight/**</include>
              </includes>
            </configuration>
          </execution>
          <execution>
            <id>jar-ai</id>
            <goals>
              <goal>jar</goal>
            </goals>
            <configuration>
              <classifier>ai</classifier>
              <includes>
                <include>vn/viettel/okrkpi/contract/platform/**</include>
                <include>vn/viettel/okrkpi/contract/policies/**</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>vn/viettel/okrkpi/contract/*/api/**</exclude>
            <exclude>vn/viettel/okrkpi/contract/*/model/**</exclude>
          </excludes>
        </configuration>
      </plugin>

      <plugin>
        <groupId>com.github.spotbugs</groupId>
        <artifactId>spotbugs-maven-plugin</artifactId>
        <configuration>
          <excludeFilterFile>${project.basedir}/spotbugs-exclude.xml</excludeFilterFile>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
