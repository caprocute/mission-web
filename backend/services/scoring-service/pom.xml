<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEN-019 · ADR-01, ADR-16, ADR-24 · TL-04 WI-20, WI-23.
  Mẫu microservice Java chuẩn (Spring Boot 3.5, Java 21, kiến trúc lục giác).
  Khi tạo service mới bằng scripts/new-service.sh, tệp này được chép sang
  backend/services/<ten-dich-vu>/pom.xml và đổi artifactId tương ứng.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>vn.viettel.okrkpi</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>scoring-service</artifactId>

  <name>Mission · scoring-service</name>
  <description>SVC-07 scoring-service: bộ máy tính điểm thuần, lược đồ scoring, chuẩn hoá đầu vào RFC 8785 và ghi lô (DV-07-01).</description>

  <properties>
    <pitest.targetClasses>vn.viettel.okrkpi.scoring.*</pitest.targetClasses>
    <contract.dir>${project.basedir}/../../../contracts/openapi</contract.dir>
    <!-- Microservice API dùng Generational ZGC theo TL-04 WI-20. -->
    <jib.jvm.gc>-XX:+UseZGC</jib.jvm.gc>
  </properties>

  <dependencies>
    <dependency>
      <groupId>vn.viettel.okrkpi</groupId>
      <artifactId>vt-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>vn.viettel.okrkpi</groupId>
      <artifactId>vt-platform-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>vn.viettel.okrkpi</groupId>
      <artifactId>vt-events</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>vn.viettel.okrkpi</groupId>
      <artifactId>vt-db-migration</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
    </dependency>
    <!-- DV-07-03: kiểm token Keycloak cho /api/** và bật PermissionInterceptor (OPA) của vt-platform-starter. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <!-- CopyManager của PgJDBC cho đường ghi lô COPY (TL-03 "Schema scoring"). -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
    </dependency>

    <!-- DV-07-02: biên dịch CEL (NEN-041) và bảng DMN bằng Flowable DMN độc lập, kho định nghĩa H2 trong bộ nhớ. -->
    <dependency>
      <groupId>vn.viettel.okrkpi</groupId>
      <artifactId>vt-cel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.flowable</groupId>
      <artifactId>flowable-dmn-engine</artifactId>
      <version>${flowable.version}</version>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-test</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- DV-07-03: kiểm thử hợp đồng getAppraisalScoreTrace (cùng thư viện với org-service). -->
    <dependency>
      <groupId>com.atlassian.oai</groupId>
      <artifactId>swagger-request-validator-core</artifactId>
      <version>2.46.1</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- TestPostgres, MigrationConventionsTest, TenantIsolationCatalogTest (NEN-030, NEN-034). -->
    <dependency>
      <groupId>vn.viettel.okrkpi</groupId>
      <artifactId>vt-db-migration</artifactId>
      <version>${project.version}</version>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
      <testResource>
        <targetPath>contract</targetPath>
        <directory>${contract.dir}</directory>
        <includes>
          <include>modules/appraisals.yaml</include>
          <include>common/common.yaml</include>
        </includes>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <groupId>org.openapitools</groupId>
        <artifactId>openapi-generator-maven-plugin</artifactId>
        <version>${openapi-generator.version}</version>
        <executions>
          <!-- DV-07-01: ba thao tác x-mission.owner SVC-07 của appraisals.yaml (API-first, chỉ giao diện). -->
          <execution>
            <id>scoring-api</id>
            <goals>
              <goal>generate</goal>
            </goals>
            <configuration>
              <inputSpec>${contract.dir}/modules/appraisals.yaml</inputSpec>
              <generatorName>spring</generatorName>
              <openapiNormalizer>FILTER=operationId:getAppraisalScoreTrace|recomputeAppraisalProfile|previewAppraisalTaskScore|simulateAppraisalScore</openapiNormalizer>
              <apiPackage>vn.viettel.okrkpi.scoring.infrastructure.web.api</apiPackage>
              <modelPackage>vn.viettel.okrkpi.scoring.infrastructure.web.model</modelPackage>
              <generateSupportingFiles>false</generateSupportingFiles>
              <generateApiTests>false</generateApiTests>
              <generateModelTests>false</generateModelTests>
              <generateApiDocumentation>false</generateApiDocumentation>
              <generateModelDocumentation>false</generateModelDocumentation>
              <configOptions>
                <interfaceOnly>true</interfaceOnly>
                <useSpringBoot3>true</useSpringBoot3>
                <useTags>false</useTags>
                <openApiNullable>false</openApiNullable>
                <annotationLibrary>none</annotationLibrary>
                <documentationProvider>none</documentationProvider>
                <useBeanValidation>true</useBeanValidation>
                <skipDefaultInterface>true</skipDefaultInterface>
              </configOptions>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <configuration>
          <container>
            <mainClass>vn.viettel.okrkpi.scoring.ScoringServiceApplication</mainClass>
            <ports>
              <port>8080</port>
              <port>8081</port>
            </ports>
            <labels>
              <org.opencontainers.image.title>${project.artifactId}</org.opencontainers.image.title>
              <org.opencontainers.image.version>${project.version}</org.opencontainers.image.version>
              <io.mission.service.name>${project.artifactId}</io.mission.service.name>
              <io.mission.service.version>${project.version}</io.mission.service.version>
            </labels>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
