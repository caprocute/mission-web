{
  "name": "@vt/cel-js-runner",
  "version": "1.0.0",
  "private": true,
  "description": "Bộ chạy cel-js đối chiếu biểu thức Policy Pack với cel-java (CORE-05-07, BR-15-07)",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "esbuild src/server.mjs --bundle --platform=node --format=esm --target=node22 --external:cel-js --external:@marcbachmann/cel-js --outfile=dist/server.mjs",
    "start": "node dist/server.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "@marcbachmann/cel-js": "8.0.0",
    "cel-js": "0.8.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
