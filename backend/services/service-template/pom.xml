<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEN-019 · ADR-01, ADR-16, ADR-24 · TL-04 WI-20, WI-23.
  Mẫu microservice Java chuẩn (Spring Boot 3.5, Java 21, kiến trúc lục giác).
  Khi tạo service mới bằng scripts/new-service.sh, tệp này được chép sang
  backend/services/<ten-dich-vu>/pom.xml và đổi artifactId tương ứng.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>vn.viettel.okrkpi</groupId>
    <artifactId>services</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>service-template</artifactId>

  <name>Mission · service-template</name>
  <description>Mẫu microservice Java lục giác với vt-platform-starter, Actuator probe cổng 8081, tắt êm 25s và Jib (NEN-019).</description>

  <properties>
    <pitest.targetClasses>vn.viettel.okrkpi.template.*</pitest.targetClasses>
    <!-- Microservice API dùng Generational ZGC theo TL-04 WI-20. -->
    <jib.jvm.gc>-XX:+UseZGC</jib.jvm.gc>
  </properties>

  <dependencies>
    <dependency>
      <groupId>vn.viettel.okrkpi</groupId>
      <artifactId>vt-kernel</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>vn.viettel.okrkpi</groupId>
      <artifactId>vt-platform-starter</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.micrometer</groupId>
      <artifactId>micrometer-registry-prometheus</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.zaxxer</groupId>
      <artifactId>HikariCP</artifactId>
    </dependency>
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-starter-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <configuration>
          <container>
            <mainClass>vn.viettel.okrkpi.template.ServiceTemplateApplication</mainClass>
            <ports>
              <port>8080</port>
              <port>8081</port>
            </ports>
            <labels>
              <org.opencontainers.image.title>${project.artifactId}</org.opencontainers.image.title>
              <org.opencontainers.image.version>${project.version}</org.opencontainers.image.version>
              <io.mission.service.name>${project.artifactId}</io.mission.service.name>
              <io.mission.service.version>${project.version}</io.mission.service.version>
            </labels>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
