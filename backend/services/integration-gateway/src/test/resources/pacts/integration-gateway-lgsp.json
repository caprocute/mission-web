{
  "consumer": {
    "name": "integration-gateway"
  },
  "provider": {
    "name": "lgsp-chi-tieu-ktxh"
  },
  "interactions": [
    {
      "description": "kéo trang chỉ tiêu kinh tế xã hội theo thời điểm cập nhật",
      "providerStates": [
        {
          "name": "LGSP có chỉ tiêu GRDP quý 2 năm 2026 đã công bố",
          "params": {
            "maChiTieu": "GRDP"
          }
        }
      ],
      "request": {
        "method": "GET",
        "path": "/api/chi-tieu-ktxh",
        "query": {
          "capNhatTu": [
            "1970-01-01T00:00:00Z"
          ],
          "gioiHan": [
            "200"
          ]
        },
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer ma-gia-lap"
        }
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "body": {
          "items": [
            {
              "maChiTieu": "GRDP",
              "kyBaoCao": "2026-Q2",
              "maDiaBan": "T01",
              "giaTri": 7.2,
              "donViTinh": "%",
              "daCongBo": true,
              "thoiDiemCongBo": "2026-07-15T09:00:00+07:00",
              "capNhatLuc": "2026-07-15T09:00:00+07:00"
            }
          ],
          "next": "2026-07-15T02:00:00Z"
        },
        "matchingRules": {
          "body": {
            "$.items": {
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.items[*].maChiTieu": {
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[\\p{L}\\p{N}._\\-/]{1,64}"
                }
              ]
            },
            "$.items[*].kyBaoCao": {
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9A-Z\\-]{4,16}"
                }
              ]
            },
            "$.items[*].maDiaBan": {
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].giaTri": {
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.items[*].donViTinh": {
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].daCongBo": {
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.items[*].thoiDiemCongBo": {
              "matchers": [
                {
                  "match": "timestamp",
                  "format": "yyyy-MM-dd'T'HH:mm:ss[.SSS]XXX"
                }
              ]
            },
            "$.items[*].capNhatLuc": {
              "matchers": [
                {
                  "match": "timestamp",
                  "format": "yyyy-MM-dd'T'HH:mm:ss[.SSS]XXX"
                }
              ]
            },
            "$.next": {
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          }
        }
      }
    }
  ],
  "metadata": {
    "pactSpecification": {
      "version": "3.0.0"
    },
    "vt": {
      "task": "DV-13-11",
      "nguon": "đối tác giả lập (YC-PT-13)"
    }
  }
}
