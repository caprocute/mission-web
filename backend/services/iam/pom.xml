<?xml version="1.0" encoding="UTF-8"?>
<!--
  SVC-02 iam: Keycloak là phần mềm có sẵn; mô-đun này gom phần nền tảng tự viết quanh Keycloak.
  - realm-template: kiểm thử mẫu realm production (DV-02-01), mẫu realm nằm ở deploy/charts/iam.
  - keycloak-events: event listener SPI đẩy sự kiện xác thực lên iam.auth.event.v1 và EVT-21 (DV-02-05).
  - revocation-consumer: consumer ghi danh sách phiên bị thu hồi vào Valkey cho APISIX (DV-02-05).
  Pom độc lập dùng spring-boot-starter-parent như bản DV-02-01 (chưa nằm trong reactor backend/pom.xml);
  phụ thuộc vt-events lấy từ kho Maven cục bộ sau khi build backend.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.5.16</version>
    <relativePath/>
  </parent>
  <groupId>vn.viettel.okrkpi</groupId>
  <artifactId>iam</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>iam (SVC-02)</name>
  <modules>
    <module>realm-template</module>
    <module>keycloak-events</module>
    <module>revocation-consumer</module>
    <module>user-sync</module>
  </modules>
  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <keycloak.version>26.4.0</keycloak.version>
    <vt-events.version>0.1.0-SNAPSHOT</vt-events.version>
    <keycloak.image>mirror.gcr.io/keycloak/keycloak:26.4.0</keycloak.image>
    <keycloak-config-cli.image>adorsys/keycloak-config-cli:6.5.1-26</keycloak-config-cli.image>
  </properties>
</project>
