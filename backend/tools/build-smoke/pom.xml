<?xml version="1.0" encoding="UTF-8"?>
<!--
  NEN-005 · Mô-đun mẫu chỉ để chứng minh chuỗi plugin của POM cha chạy được
  (Spotless, JaCoCo, SpotBugs, PIT, Jib). Xoá khi NEN-009 có mô-đun thật.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>vn.viettel.okrkpi</groupId>
    <artifactId>mission-backend-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>build-smoke</artifactId>

  <name>Mission · mô-đun mẫu kiểm chuỗi build</name>

  <properties>
    <pitest.targetClasses>vn.viettel.okrkpi.tools.buildsmoke.*</pitest.targetClasses>
    <jib.to.image>build-smoke:${project.version}</jib.to.image>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <configuration>
          <container>
            <mainClass>vn.viettel.okrkpi.tools.buildsmoke.BuildSmokeMain</mainClass>
          </container>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
