<?xml version="1.0" encoding="UTF-8"?>
<!--
  Dự án Maven mẫu tối thiểu làm fixture kiểm thử thư viện vt-pipeline (INF-05).
  KHÔNG phải backend thật: khung Maven thật của mission-core do NEN-005 dựng trong backend/ ở gốc repo.
  Fixture mô phỏng đúng những gì vtJavaPipeline cần ở một POM backend: ./mvnw, hồ sơ `ci` chạy kiểm thử
  đơn vị, kiểm thử kiến trúc ArchUnit và JaCoCo (độ phủ dòng ≥ 80%), plugin Jib dựng ảnh distroless JRE 21
  theo digest, chạy không root (SEC-49, SEC-55).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>vn.vt.mission</groupId>
  <artifactId>fixture-service</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <packaging>jar</packaging>
  <name>Fixture kiểm thử vt-pipeline</name>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.build.outputTimestamp>2026-01-01T00:00:00Z</project.build.outputTimestamp>
    <junit.version>5.11.4</junit.version>
    <archunit.version>1.3.0</archunit.version>
    <jacoco.version>0.8.12</jacoco.version>
    <jib.version>3.4.4</jib.version>
    <!-- Ảnh nền JRE 21 distroless chạy không root, luôn ghim theo digest (SEC-49, SEC-55).
         Pipeline ghi đè bằng ảnh nền trong Harbor: -Djib.from.image=harbor.vt.local/base/java21-distroless@sha256:... -->
    <jib.from.image>gcr.io/distroless/java21-debian13:nonroot@sha256:f3ac871fb5802c2739bb23b67212e67f341cbe754131528d2e9849072f9efb9a</jib.from.image>
    <jib.to.image>localhost/okr/fixture-service</jib.to.image>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <version>${archunit.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.4.2</version>
      </plugin>
      <plugin>
        <groupId>com.google.cloud.tools</groupId>
        <artifactId>jib-maven-plugin</artifactId>
        <version>${jib.version}</version>
        <configuration>
          <from>
            <image>${jib.from.image}</image>
            <platforms>
              <platform>
                <architecture>amd64</architecture>
                <os>linux</os>
              </platform>
            </platforms>
          </from>
          <to>
            <image>${jib.to.image}</image>
          </to>
          <container>
            <mainClass>vn.vt.mission.fixture.FixtureApp</mainClass>
            <!-- UID 10001 theo chart vt-service (INF-01, SEC-49) -->
            <user>10001:10001</user>
            <labels>
              <org.opencontainers.image.title>fixture-service</org.opencontainers.image.title>
            </labels>
          </container>
          <outputPaths>
            <digest>${project.build.directory}/jib-image.digest</digest>
            <imageJson>${project.build.directory}/jib-image.json</imageJson>
          </outputPaths>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Hồ sơ mà vtJavaPipeline gọi: ./mvnw -B -ntp verify -Pci -->
    <profile>
      <id>ci</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>${jacoco.version}</version>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals><goal>prepare-agent</goal></goals>
              </execution>
              <execution>
                <id>report</id>
                <phase>verify</phase>
                <goals><goal>report</goal></goals>
              </execution>
              <execution>
                <id>check</id>
                <phase>verify</phase>
                <goals><goal>check</goal></goals>
                <configuration>
                  <rules>
                    <rule>
                      <element>BUNDLE</element>
                      <limits>
                        <limit>
                          <counter>LINE</counter>
                          <value>COVEREDRATIO</value>
                          <minimum>0.80</minimum>
                        </limit>
                      </limits>
                    </rule>
                  </rules>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
