               "type": "prometheus",
               "uid": "thanos"
            },
            "includeAll": true,
            "label": "Cell",
            "name": "cell",
            "query": "label_values(up, cell)",
            "refresh": "time",
            "type": "query"
         },
         {
            "allValue": ".*",
            "current": {
               "text": "All",
               "value": "$__all"
            },
            "datasource": {
               "type": "prometheus",
               "uid": "thanos"
            },
            "includeAll": true,
            "label": "Dịch vụ",
