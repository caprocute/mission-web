@@ -0,0 +1,80 @@
+package vn.viettel.okrkpi.contract.codegen;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import io.swagger.v3.oas.models.OpenAPI;
+import io.swagger.v3.oas.models.Operation;
+import io.swagger.v3.oas.models.PathItem;
+import io.swagger.v3.oas.models.Paths;
+import java.util.Map;
+import java.util.Set;
+import org.junit.jupiter.api.Test;
+
+class OwnerFilterTest {
+
+  private static Operation op(String id, String owner) {
+    Operation operation = new Operation().operationId(id);
+    if (owner != null) {
+      operation.addExtension(OwnerFilter.X_MISSION, Map.of("owner", owner, "qt", "QT-05"));
+    }
+    return operation;
+  }
+
+  private static OpenAPI api(Operation get, Operation post) {
+    return new OpenAPI()
+        .paths(new Paths().addPathItem("/appraisals/{id}", new PathItem().get(get).post(post)));
+  }
+
+  @Test
+  void tachDanhSachChuSoHuu() {
+    assertThat(OwnerFilter.parseOwners("MOD-01|MOD-02, SVC-05"))
+        .containsExactly("MOD-01", "MOD-02", "SVC-05");
+    assertThatThrownBy(() -> OwnerFilter.parseOwners(" "))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> OwnerFilter.parseOwners(null))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+
+  @Test
+  void danhDauThaoTacNgoaiDonVi() {
+    Operation core = op("getAppraisal", "MOD-04");
+    Operation scoring = op("recomputeScore", "SVC-07");
+
+    int kept = OwnerFilter.markForeignOperations(api(core, scoring), Set.of("MOD-04"));
+
+    assertThat(kept).isEqualTo(1);
+    assertThat(core.getExtensions()).doesNotContainKey(OwnerFilter.X_INTERNAL);
+    assertThat(scoring.getExtensions()).containsEntry(OwnerFilter.X_INTERNAL, Boolean.TRUE);
+  }
+
+  @Test
+  void thieuChuSoHuuThiBaoLoi() {
+    OpenAPI api = api(op("getAppraisal", "MOD-04"), op("noOwner", null));
+
+    assertThatThrownBy(() -> OwnerFilter.markForeignOperations(api, Set.of("MOD-04")))
+        .isInstanceOf(IllegalStateException.class)
+        .hasMessageContaining("x-mission.owner");
+  }
+
+  @Test
+  void khongConThaoTacNaoThiBaoLoi() {
+    OpenAPI api = api(op("getAppraisal", "MOD-04"), op("recomputeScore", "SVC-07"));
+
+    assertThatThrownBy(() -> OwnerFilter.markForeignOperations(api, Set.of("SVC-99")))
+        .isInstanceOf(IllegalStateException.class)
+        .hasMessageContaining("SVC-99");
+  }
+
+  @Test
+  void taiLieuKhongCoDuongDanVaPhanMoRongLa() {
+    assertThat(OwnerFilter.markForeignOperations(new OpenAPI(), Set.of("MOD-04"))).isZero();
+    Operation odd = new Operation().operationId("x");
+    odd.addExtension(OwnerFilter.X_MISSION, "khong-phai-map");
+    assertThat(OwnerFilter.ownerOf(odd)).isNull();
+    assertThat(OwnerFilter.ownerOf(new Operation())).isNull();
+    Operation noOwner = new Operation();
+    noOwner.addExtension(OwnerFilter.X_MISSION, Map.of("qt", "QT-01"));
+    assertThat(OwnerFilter.ownerOf(noOwner)).isNull();
+  }
+}
