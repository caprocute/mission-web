+<?xml version="1.0" encoding="UTF-8"?>
+<!--
+  NEN-006 · ADR-32 (BS-02) · YC-PT-05.
+
+  Phần mở rộng của openapi-generator dùng lúc sinh mã, không chạy trong ứng dụng: bộ chuẩn hoá
+  MissionContractNormalizer chỉ giữ thao tác có x-mission.owner thuộc một đơn vị triển khai, để mỗi
+  đơn vị (mission-core, org-service, evidence-service...) nhận đúng phần interface của mình mà
+  không phải sửa hợp đồng (YC-PT-09). Mô-đun vt-api-contract khai jar này làm phụ thuộc của plugin.
+-->
+<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <parent>
+    <groupId>vn.viettel.okrkpi</groupId>
+    <artifactId>libs</artifactId>
+    <version>0.1.0-SNAPSHOT</version>
+    <relativePath>../../pom.xml</relativePath>
+  </parent>
+
+  <artifactId>vt-api-contract-codegen</artifactId>
+
+  <name>Mission · phần mở rộng sinh mã hợp đồng API</name>
+
+  <dependencies>
+    <!--
+      Chỉ cần lớp OpenAPINormalizer để biên dịch; lúc chạy, lớp này nằm sẵn trên classpath của
+      openapi-generator-maven-plugin. Loại toàn bộ phụ thuộc bắc cầu để không kéo cây phụ thuộc
+      lớn của generator vào hội tụ phụ thuộc.
+    -->
+    <dependency>
+      <groupId>org.openapitools</groupId>
+      <artifactId>openapi-generator</artifactId>
+      <scope>provided</scope>
+      <exclusions>
+        <exclusion>
+          <groupId>*</groupId>
+          <artifactId>*</artifactId>
+        </exclusion>
+      </exclusions>
+    </dependency>
+    <dependency>
+      <groupId>io.swagger.parser.v3</groupId>
+      <artifactId>swagger-parser-v3</artifactId>
+      <scope>provided</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.assertj</groupId>
+      <artifactId>assertj-core</artifactId>
+      <scope>test</scope>
+    </dependency>
+    <dependency>
+      <groupId>org.junit.jupiter</groupId>
+      <artifactId>junit-jupiter</artifactId>
+      <scope>test</scope>
+    </dependency>
+  </dependencies>
+</project>
diff --git a/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/BooleanConstSimplifier.java b/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/BooleanConstSimplifier.java
new file mode 100644
index 0000000..48517ed
--- /dev/null
+++ b/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/BooleanConstSimplifier.java
@@ -0,0 +1,83 @@
+package vn.viettel.okrkpi.contract.codegen;
+
+import io.swagger.v3.oas.models.OpenAPI;
+import io.swagger.v3.oas.models.media.Schema;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.IdentityHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Bỏ {@code const}/{@code enum} trên lược đồ kiểu {@code boolean} trước khi sinh mã.
+ *
+ * <p>Lý do: generator {@code spring} 7.x sinh {@code const: true} thành {@code enum AttestedEnum {
+ * TRUE("true") }} với trường {@code Boolean}, không biên dịch được (lỗi của generator với OpenAPI
+ * 3.1; quy tắc chuẩn {@code SIMPLIFY_BOOLEAN_ENUM} không bắt được {@code const}). Sau khi bỏ, trường
+ * là {@code Boolean}; ràng buộc "phải là true" do máy chủ kiểm trong nghiệp vụ, và kiểm thử hợp đồng
+ * vẫn đối chiếu theo tệp hợp đồng gốc. Tệp hợp đồng không bị sửa (YC-PT-09).
+ */
+public final class BooleanConstSimplifier {
+
+  private BooleanConstSimplifier() {}
+
+  /**
+   * Duyệt mọi lược đồ trong {@code components.schemas} (gồm thuộc tính lồng, phần tử mảng và
+   * thành phần allOf/oneOf/anyOf).
+   *
+   * @return số lược đồ boolean đã bỏ const/enum
+   */
+  public static int simplify(OpenAPI openApi) {
+    if (openApi.getComponents() == null || openApi.getComponents().getSchemas() == null) {
+      return 0;
+    }
+    Set<Schema<?>> visited = Collections.newSetFromMap(new IdentityHashMap<>());
+    int count = 0;
+    for (Schema<?> schema : openApi.getComponents().getSchemas().values()) {
+      count += visit(schema, visited);
+    }
+    return count;
+  }
+
+  @SuppressWarnings({"rawtypes", "unchecked"})
+  private static int visit(Schema<?> schema, Set<Schema<?>> visited) {
+    if (schema == null || !visited.add(schema)) {
+      return 0;
+    }
+    int count = 0;
+    if (isBoolean(schema) && (schema.getConst() != null || schema.getEnum() != null)) {
+      ((Schema) schema).setConst(null);
+      schema.setEnum(null);
+      count++;
+    }
+    List<Schema> children = new ArrayList<>();
+    Map<String, Schema> properties = schema.getProperties();
+    if (properties != null) {
+      children.addAll(properties.values());
+    }
+    children.add(schema.getItems());
+    if (schema.getAdditionalProperties() instanceof Schema<?> additional) {
+      children.add(additional);
+    }
+    addAll(children, schema.getAllOf());
+    addAll(children, schema.getOneOf());
+    addAll(children, schema.getAnyOf());
+    for (Schema child : children) {
+      count += visit(child, visited);
+    }
+    return count;
+  }
+
+  @SuppressWarnings("rawtypes")
+  private static void addAll(List<Schema> target, List<Schema> source) {
+    if (source != null) {
+      target.addAll(source);
+    }
+  }
+
+  private static boolean isBoolean(Schema<?> schema) {
+    return "boolean".equals(schema.getType())
+        || (schema.getTypes() != null && schema.getTypes().contains("boolean"));
+  }
+}
diff --git a/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/ExampleStripper.java b/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/ExampleStripper.java
new file mode 100644
index 0000000..ade7370
--- /dev/null
+++ b/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/ExampleStripper.java
@@ -0,0 +1,81 @@
+package vn.viettel.okrkpi.contract.codegen;
+
+import io.swagger.v3.oas.models.OpenAPI;
+import io.swagger.v3.oas.models.Operation;
+import io.swagger.v3.oas.models.PathItem;
+import io.swagger.v3.oas.models.media.Content;
+import io.swagger.v3.oas.models.media.MediaType;
+import io.swagger.v3.oas.models.parameters.RequestBody;
+import io.swagger.v3.oas.models.responses.ApiResponse;
+import java.util.Collection;
+
+/**
+ * Bỏ {@code example}/{@code examples} của nội dung yêu cầu và phản hồi khỏi mô hình trong bộ nhớ
+ * trước khi sinh mã.
+ *
+ * <p>Lý do: generator {@code spring} 7.x chép ví dụ vào {@code @ExampleObject(value = "...")} mà
+ * không thoát đúng chuỗi JSON lồng dấu nháy (ví dụ {@code bpmnXml} chứa {@code xmlns="..."}), làm
+ * mã sinh ra không biên dịch được. Ví dụ không cần cho interface: kiểm thử hợp đồng đọc ví dụ thẳng
+ * từ {@code contracts/dist} (vt-contract-test). Tệp hợp đồng không bị sửa (YC-PT-09).
+ */
+public final class ExampleStripper {
+
+  private ExampleStripper() {}
+
+  /**
+   * Bỏ ví dụ ở mọi phản hồi, thân yêu cầu của thao tác và ở {@code components}.
+   *
+   * @return số kiểu nội dung (media type) đã bỏ ví dụ
+   */
+  public static int strip(OpenAPI openApi) {
+    int count = 0;
+    if (openApi.getPaths() != null) {
+      for (PathItem pathItem : openApi.getPaths().values()) {
+        for (Operation operation : pathItem.readOperations()) {
+          count += strip(operation.getRequestBody());
+          if (operation.getResponses() != null) {
+            count += stripResponses(operation.getResponses().values());
+          }
+        }
+      }
+    }
+    if (openApi.getComponents() != null) {
+      if (openApi.getComponents().getResponses() != null) {
+        count += stripResponses(openApi.getComponents().getResponses().values());
+      }
+      if (openApi.getComponents().getRequestBodies() != null) {
+        for (RequestBody body : openApi.getComponents().getRequestBodies().values()) {
+          count += strip(body);
+        }
+      }
+    }
+    return count;
+  }
+
+  private static int stripResponses(Collection<ApiResponse> responses) {
+    int count = 0;
+    for (ApiResponse response : responses) {
+      count += strip(response.getContent());
+    }
+    return count;
+  }
+
+  private static int strip(RequestBody body) {
+    return body == null ? 0 : strip(body.getContent());
+  }
+
+  private static int strip(Content content) {
+    if (content == null) {
+      return 0;
+    }
+    int count = 0;
+    for (MediaType mediaType : content.values()) {
+      if (mediaType.getExamples() != null || mediaType.getExample() != null) {
+        mediaType.setExamples(null);
+        mediaType.setExample(null);
+        count++;
+      }
+    }
+    return count;
+  }
+}
diff --git a/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/MissionContractNormalizer.java b/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/MissionContractNormalizer.java
new file mode 100644
index 0000000..bc0358c
--- /dev/null
+++ b/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/MissionContractNormalizer.java
@@ -0,0 +1,51 @@
+package vn.viettel.okrkpi.contract.codegen;
+
+import io.swagger.v3.oas.models.OpenAPI;
+import java.util.Map;
+import java.util.Set;
+import org.openapitools.codegen.OpenAPINormalizer;
+
+/**
+ * Bộ chuẩn hoá tuỳ biến của openapi-generator (quy tắc {@code NORMALIZER_CLASS}) cho hợp đồng
+ * Mission. Chỉ thay đổi mô hình trong bộ nhớ của lần sinh mã, không sửa tệp hợp đồng (YC-PT-09):
+ *
+ * <ul>
+ *   <li>chỉ giữ thao tác của một đơn vị triển khai theo {@code x-mission.owner} ({@link
+ *       OwnerFilter});
+ *   <li>bỏ ví dụ của nội dung yêu cầu, phản hồi ({@link ExampleStripper});
+ *   <li>bỏ {@code const}/{@code enum} trên lược đồ boolean ({@link BooleanConstSimplifier}).
+ * </ul>
+ *
+ * <p>Cấu hình trong plugin Maven (danh sách {@code KHOÁ=giá trị}):
+ *
+ * <pre>{@code
+ * <openapiNormalizer>
+ *   <rule>NORMALIZER_CLASS=vn.viettel.okrkpi.contract.codegen.MissionContractNormalizer</rule>
+ *   <rule>X_MISSION_OWNERS=MOD-01|MOD-02|SVC-05</rule>
+ * </openapiNormalizer>
+ * }</pre>
+ *
+ * <p>openapi-generator ghi cảnh báo "Invalid openapi-normalizer rule name: X_MISSION_OWNERS" vì
+ * không biết quy tắc riêng này; cảnh báo đó vô hại.
+ */
+public class MissionContractNormalizer extends OpenAPINormalizer {
+
+  /** Tên quy tắc mang danh sách chủ sở hữu được giữ. */
+  public static final String RULE_OWNERS = "X_MISSION_OWNERS";
+
+  private final Set<String> owners;
+
+  /** Hàm dựng theo chữ ký mà openapi-generator gọi bằng phản chiếu. */
+  public MissionContractNormalizer(OpenAPI openApi, Map<String, String> inputRules) {
+    super(openApi, inputRules);
+    this.owners = OwnerFilter.parseOwners(inputRules.get(RULE_OWNERS));
+  }
+
+  @Override
+  protected void normalize() {
+    OwnerFilter.markForeignOperations(openAPI, owners);
+    ExampleStripper.strip(openAPI);
+    BooleanConstSimplifier.simplify(openAPI);
+    super.normalize();
+  }
+}
diff --git a/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/OwnerFilter.java b/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/OwnerFilter.java
new file mode 100644
index 0000000..1f12b4b
--- /dev/null
+++ b/backend/libs/vt-api-contract/codegen/src/main/java/vn/viettel/okrkpi/contract/codegen/OwnerFilter.java
@@ -0,0 +1,93 @@
+package vn.viettel.okrkpi.contract.codegen;
+
+import io.swagger.v3.oas.models.OpenAPI;
+import io.swagger.v3.oas.models.Operation;
+import io.swagger.v3.oas.models.PathItem;
+import java.util.Arrays;
+import java.util.LinkedHashSet;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Collectors;
+
+/**
+ * Lọc thao tác theo phần mở rộng truy vết {@code x-mission.owner} của hợp đồng (BS-02, ADR-32).
+ *
+ * <p>Thao tác có chủ sở hữu ngoài tập cho phép được đánh dấu {@code x-internal: true}; openapi-generator
+ * bỏ qua thao tác mang dấu này khi sinh interface. Hợp đồng gốc không bị sửa (YC-PT-09): việc đánh
+ * dấu chỉ xảy ra trên mô hình trong bộ nhớ của lần sinh mã.
+ */
+public final class OwnerFilter {
+
+  /** Tên phần mở rộng truy vết của hợp đồng. */
+  public static final String X_MISSION = "x-mission";
+
+  /** Phần mở rộng openapi-generator dùng để bỏ qua thao tác. */
+  public static final String X_INTERNAL = "x-internal";
+
+  private OwnerFilter() {}
+
+  /**
+   * Tách danh sách chủ sở hữu dạng {@code MOD-01|MOD-02|SVC-05}.
+   *
+   * @throws IllegalArgumentException khi chuỗi rỗng, để lần sinh mã không lặng lẽ bỏ hết thao tác
+   */
+  public static Set<String> parseOwners(String value) {
+    if (value == null || value.isBlank()) {
+      throw new IllegalArgumentException(
+          "Thiếu danh sách chủ sở hữu x-mission.owner (dạng MOD-01|SVC-05)");
+    }
+    return Arrays.stream(value.split("[|,\\s]+"))
+        .map(String::trim)
+        .filter(s -> !s.isEmpty())
+        .collect(Collectors.toCollection(LinkedHashSet::new));
+  }
+
+  /**
+   * Đánh dấu {@code x-internal} cho mọi thao tác không thuộc {@code owners}.
+   *
+   * @return số thao tác được giữ lại để sinh mã
+   * @throws IllegalStateException khi một thao tác thiếu {@code x-mission.owner} (hợp đồng chưa
+   *     qua lint) hoặc khi không còn thao tác nào được giữ
+   */
+  public static int markForeignOperations(OpenAPI openApi, Set<String> owners) {
+    if (openApi.getPaths() == null) {
+      return 0;
+    }
+    int kept = 0;
+    for (Map.Entry<String, PathItem> path : openApi.getPaths().entrySet()) {
+      for (Map.Entry<PathItem.HttpMethod, Operation> entry :
+          path.getValue().readOperationsMap().entrySet()) {
+        Operation operation = entry.getValue();
+        String owner = ownerOf(operation);
+        if (owner == null) {
+          throw new IllegalStateException(
+              "Thao tác "
+                  + entry.getKey()
+                  + " "
+                  + path.getKey()
+                  + " thiếu x-mission.owner; chạy npm run lint trong contracts/");
+        }
+        if (owners.contains(owner)) {
+          kept++;
+        } else {
+          operation.addExtension(X_INTERNAL, Boolean.TRUE);
+        }
+      }
+    }
+    if (kept == 0) {
+      throw new IllegalStateException(
+          "Không có thao tác nào thuộc " + owners + "; kiểm lại cấu hình đơn vị triển khai");
+    }
+    return kept;
+  }
+
+  /** Đọc {@code x-mission.owner} của một thao tác, {@code null} khi không có. */
+  public static String ownerOf(Operation operation) {
+    Map<String, Object> extensions = operation.getExtensions();
+    if (extensions == null || !(extensions.get(X_MISSION) instanceof Map<?, ?> mission)) {
+      return null;
+    }
+    Object owner = mission.get("owner");
+    return owner == null ? null : owner.toString();
+  }
+}
diff --git a/backend/libs/vt-api-contract/codegen/src/test/java/vn/viettel/okrkpi/contract/codegen/ExampleStripperTest.java b/backend/libs/vt-api-contract/codegen/src/test/java/vn/viettel/okrkpi/contract/codegen/ExampleStripperTest.java
new file mode 100644
index 0000000..4860fe9
--- /dev/null
+++ b/backend/libs/vt-api-contract/codegen/src/test/java/vn/viettel/okrkpi/contract/codegen/ExampleStripperTest.java
@@ -0,0 +1,81 @@
+package vn.viettel.okrkpi.contract.codegen;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import io.swagger.v3.oas.models.Components;
+import io.swagger.v3.oas.models.OpenAPI;
+import io.swagger.v3.oas.models.Operation;
+import io.swagger.v3.oas.models.PathItem;
+import io.swagger.v3.oas.models.Paths;
+import io.swagger.v3.oas.models.examples.Example;
+import io.swagger.v3.oas.models.media.Content;
+import io.swagger.v3.oas.models.media.MediaType;
+import io.swagger.v3.oas.models.parameters.RequestBody;
+import io.swagger.v3.oas.models.responses.ApiResponse;
+import io.swagger.v3.oas.models.responses.ApiResponses;
+import java.util.Map;
+import org.junit.jupiter.api.Test;
+
+class ExampleStripperTest {
+
+  private static MediaType withExamples() {
+    return new MediaType()
+        .examples(Map.of("dang-chay", new Example().value(Map.of("status", "DANG_CHAY"))));
+  }
+
+  @Test
+  void boViDuOThaoTacVaComponents() {
+    MediaType responseMedia = withExamples();
+    MediaType requestMedia = new MediaType().example(Map.of("reason", "Đề nghị gia hạn"));
+    MediaType componentMedia = withExamples();
+    MediaType componentBody = withExamples();
+    MediaType plain = new MediaType();
+    Operation operation =
+        new Operation()
+            .requestBody(new RequestBody().content(new Content().addMediaType("a/json", requestMedia)))
+            .responses(
+                new ApiResponses()
+                    .addApiResponse(
+                        "200",
+                        new ApiResponse()
+                            .content(
+                                new Content()
+                                    .addMediaType("application/json", responseMedia)
+                                    .addMediaType("application/problem+json", plain)))
+                    .addApiResponse("204", new ApiResponse()));
+    OpenAPI api =
+        new OpenAPI()
+            .paths(new Paths().addPathItem("/jobs/{id}", new PathItem().post(operation)))
+            .components(
+                new Components()
+                    .responses(
+                        Map.of(
+                            "Conflict",
+                            new ApiResponse()
+                                .content(new Content().addMediaType("a/json", componentMedia))))
+                    .requestBodies(
+                        Map.of(
+                            "Body",
+                            new RequestBody()
+                                .content(new Content().addMediaType("a/json", componentBody)))));
+
+    int stripped = ExampleStripper.strip(api);
+
+    assertThat(stripped).isEqualTo(4);
+    assertThat(responseMedia.getExamples()).isNull();
+    assertThat(requestMedia.getExample()).isNull();
+    assertThat(componentMedia.getExamples()).isNull();
+    assertThat(componentBody.getExamples()).isNull();
+  }
+
+  @Test
+  void taiLieuRong() {
+    assertThat(ExampleStripper.strip(new OpenAPI())).isZero();
+    assertThat(ExampleStripper.strip(new OpenAPI().components(new Components()))).isZero();
+    Operation noBody = new Operation();
+    assertThat(
+            ExampleStripper.strip(
+                new OpenAPI().paths(new Paths().addPathItem("/x", new PathItem().get(noBody)))))
+        .isZero();
+  }
+}
diff --git a/backend/libs/vt-api-contract/codegen/src/test/java/vn/viettel/okrkpi/contract/codegen/OwnerFilterTest.java b/backend/libs/vt-api-contract/codegen/src/test/java/vn/viettel/okrkpi/contract/codegen/OwnerFilterTest.java
