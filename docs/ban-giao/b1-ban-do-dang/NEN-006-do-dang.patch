+package vn.viettel.okrkpi.contract;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import io.swagger.v3.oas.annotations.Operation;
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.lang.reflect.Method;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.stream.Collectors;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.Test;
+import org.springframework.web.bind.annotation.RequestMapping;
+import vn.viettel.okrkpi.contract.ContractFixtures.ContractOperation;
+import vn.viettel.okrkpi.contract.ContractFixtures.Unit;
+
+/**
+ * Đối chiếu số interface và phương thức sinh ra với số thao tác đếm từ hợp đồng nguồn
+ * ({@code contracts/openapi/modules}), theo từng (đơn vị triển khai, tệp). Thất bại khi hợp đồng
+ * thêm thao tác mà chưa sinh lại, khi bản gộp {@code contracts/dist} cũ, hoặc khi hợp đồng có owner
+ * mới chưa gán đơn vị trong {@code pom.xml}.
+ */
+class GeneratedOperationsTest {
+
+  private static final Path CLASSES = Path.of("target", "classes");
+
+  @Test
+  void moiThaoTacThuocDungMotDonVi() {
+    List<String> files = ContractFixtures.moduleFiles();
+    assertThat(files).as("tệp module của hợp đồng").hasSize(11);
+    List<String> unassigned = new ArrayList<>();
+    for (String file : files) {
+      for (ContractOperation op : ContractFixtures.operations(file, "modules")) {
+        long units =
+            ContractFixtures.UNITS.stream()
+                .filter(u -> u.file().equals(file) && u.owners().contains(op.owner()))
+                .count();
+        if (units != 1) {
+          unassigned.add(file + ":" + op.operationId() + " (owner " + op.owner() + ", " + units + ")");
+        }
+      }
+    }
+    assertThat(unassigned)
+        .as("thao tác chưa gán đúng một đơn vị; thêm execution vào pom.xml, README.md, ContractFixtures")
+        .isEmpty();
+  }
+
+  @Test
+  void banGopKhopHopDongNguon() {
+    for (String file : ContractFixtures.moduleFiles()) {
+      Set<String> source = ids(ContractFixtures.operations(file, "modules"));
+      Set<String> dist = ids(ContractFixtures.operations(file, "dist"));
+      assertThat(dist)
+          .as("contracts/dist/%s.yaml cũ so với openapi/modules; chạy tools/contracts-bundle.sh", file)
+          .isEqualTo(source);
+    }
+  }
+
+  @Test
+  void sinhDuPhuongThucChoMoiThaoTac() {
+    StringBuilder report = new StringBuilder("\nĐơn vị      Tệp          Interface Phương thức Thao tác\n");
+    int totalMethods = 0;
+    int totalInterfaces = 0;
+    for (Unit unit : ContractFixtures.UNITS) {
+      Set<String> expected =
+          ContractFixtures.operations(unit.file(), "modules").stream()
+              .filter(op -> unit.owners().contains(op.owner()))
+              .map(ContractOperation::operationId)
+              .collect(Collectors.toCollection(TreeSet::new));
+      List<Class<?>> interfaces = apiInterfaces(unit.basePackage() + ".api");
+      Set<String> generated = new TreeSet<>();
+      for (Class<?> api : interfaces) {
+        assertThat(api.isInterface()).as(api.getName()).isTrue();
+        assertThat(api.getAnnotation(RequestMapping.class).value())
+            .as("đường dẫn gốc của %s", api.getSimpleName())
+            .containsExactly("${openapi.mission.base-path:/api/v1}");
+        for (Method method : api.getDeclaredMethods()) {
+          Operation operation = method.getAnnotation(Operation.class);
+          if (operation != null) {
+            assertThat(method.getName()).isEqualTo(operation.operationId());
+            generated.add(operation.operationId());
+          }
+        }
+      }
+      assertThat(generated).as("%s/%s", unit.classifier(), unit.file()).isEqualTo(expected);
+      totalMethods += generated.size();
+      totalInterfaces += interfaces.size();
+      report.append(
+          String.format(
+              "%-11s %-12s %9d %11d %8d%n",
+              unit.classifier(), unit.file(), interfaces.size(), generated.size(), expected.size()));
+    }
+    int contractOps =
+        ContractFixtures.moduleFiles().stream()
+            .mapToInt(f -> ContractFixtures.operations(f, "modules").size())
+            .sum();
+    report.append(
+        String.format("%-24s %9d %11d %8d%n", "Tổng", totalInterfaces, totalMethods, contractOps));
+    System.out.println(report);
+    assertThat(totalMethods).isEqualTo(contractOps);
+  }
+
+  private static Set<String> ids(List<ContractOperation> ops) {
+    return ops.stream()
+        .map(ContractOperation::operationId)
+        .collect(Collectors.toCollection(TreeSet::new));
+  }
+
+  private static List<Class<?>> apiInterfaces(String apiPackage) {
+    Path dir = CLASSES.resolve(apiPackage.replace('.', '/'));
+    try (Stream<Path> files = Files.list(dir)) {
+      return files
+          .map(p -> p.getFileName().toString())
+          .filter(n -> n.endsWith("Api.class"))
+          .sorted()
+          .<Class<?>>map(
+              n -> load(apiPackage + "." + n.substring(0, n.length() - ".class".length())))
+          .toList();
+    } catch (IOException e) {
+      throw new UncheckedIOException("Không đọc được " + dir, e);
+    }
+  }
+
+  private static Class<?> load(String name) {
+    try {
+      return Class.forName(name);
+    } catch (ClassNotFoundException e) {
+      throw new IllegalStateException(e);
+    }
+  }
+}
