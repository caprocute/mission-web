+++ b/backend/tools/contracts-bundle.sh
@@ -0,0 +1,16 @@
+#!/usr/bin/env bash
+# NEN-006 · ADR-32 (BS-02): gộp hợp đồng OpenAPI contracts/openapi/modules/*.yaml thành
+# contracts/dist/*.yaml (không còn $ref ra ngoài) trước khi build backend.
+#
+# vt-api-contract sinh interface Spring từ contracts/dist/ (giữ tên lược đồ dùng chung như
+# ProblemDetails, Job) và vt-contract-test so springdoc với contracts/dist/ bằng openapi-diff.
+# Jenkins (INF-05) gọi lại script này trước "./mvnw verify".
+#
+# Dùng: backend/tools/contracts-bundle.sh   (chạy được từ thư mục bất kỳ)
+set -euo pipefail
+
+backend_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+contracts_dir="${backend_dir}/../contracts"
+
+npm --prefix "${contracts_dir}" ci --no-audit --no-fund
+npm --prefix "${contracts_dir}" run bundle
