+package vn.viettel.okrkpi.contract;
+
+import com.fasterxml.jackson.databind.JsonNode;
+import com.fasterxml.jackson.databind.ObjectMapper;
+import com.fasterxml.jackson.dataformat.yaml.YAMLFactory;
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.stream.Stream;
+
+/**
+ * Bảng đơn vị triển khai và bộ đọc hợp đồng dùng trong kiểm thử. Bảng phải khớp các execution của
+ * openapi-generator trong {@code pom.xml} và bảng ánh xạ trong {@code README.md}.
+ */
+final class ContractFixtures {
+
+  /** Một lần sinh: đơn vị triển khai, tệp hợp đồng, gói cơ sở, tập owner. */
+  record Unit(String classifier, String file, String basePackage, Set<String> owners) {}
+
+  /** Một thao tác đọc từ hợp đồng nguồn. */
+  record ContractOperation(String file, String operationId, String owner) {}
+
+  static final Set<String> CORE_OWNERS =
+      Set.of("MOD-01", "MOD-02", "MOD-03", "MOD-04", "MOD-05", "MOD-06", "MOD-07", "MOD-08", "SVC-05");
+
+  static final List<String> CORE_FILES =
+      List.of(
+          "okr", "tasks", "products", "appraisals", "policies", "dossiers", "oversight", "config",
+          "jobs");
+
+  static final List<Unit> UNITS = buildUnits();
+
+  static final Path CONTRACTS = Path.of("..", "..", "..", "contracts").toAbsolutePath().normalize();
+
+  private static final ObjectMapper YAML = new ObjectMapper(new YAMLFactory());
+
+  private ContractFixtures() {}
+
+  private static List<Unit> buildUnits() {
+    List<Unit> units = new ArrayList<>();
+    for (String file : CORE_FILES) {
+      units.add(new Unit("core", file, "vn.viettel.okrkpi.contract." + file, CORE_OWNERS));
+    }
+    units.add(unit("org", "org", "vn.viettel.okrkpi.contract.org", "SVC-04"));
+    units.add(unit("scoring", "appraisals", "vn.viettel.okrkpi.contract.appraisals.scoring", "SVC-07"));
+    units.add(unit("evidence", "products", "vn.viettel.okrkpi.contract.products.evidence", "SVC-08"));
+    units.add(unit("ledger", "oversight", "vn.viettel.okrkpi.contract.oversight.ledger", "SVC-09"));
+    units.add(unit("esign", "dossiers", "vn.viettel.okrkpi.contract.dossiers.esign", "SVC-10"));
+    units.add(unit("docgen", "dossiers", "vn.viettel.okrkpi.contract.dossiers.docgen", "SVC-11"));
+    String platform = "vn.viettel.okrkpi.contract.platform.";
+    units.add(unit("registry", "platform", platform + "registry", "SVC-03"));
+    units.add(unit("workflow", "platform", platform + "workflow", "SVC-06"));
+    units.add(unit("notification", "platform", platform + "notification", "SVC-12"));
+    units.add(unit("ai", "platform", platform + "ai", "SVC-14"));
+    units.add(unit("analytics", "platform", platform + "analytics", "SVC-15"));
+    units.add(unit("search", "platform", platform + "search", "SVC-16"));
+    return List.copyOf(units);
+  }
+
+  private static Unit unit(String classifier, String file, String basePackage, String owner) {
+    return new Unit(classifier, file, basePackage, Set.of(owner));
+  }
+
+  /** Đọc YAML. */
+  static JsonNode readYaml(Path path) {
+    try {
+      return YAML.readTree(path.toFile());
+    } catch (IOException e) {
+      throw new UncheckedIOException(e);
+    }
+  }
+
+  /** Tên các tệp module (không đuôi) trong {@code contracts/openapi/modules}. */
+  static List<String> moduleFiles() {
+    try (Stream<Path> files = Files.list(CONTRACTS.resolve("openapi/modules"))) {
+      return files
+          .map(p -> p.getFileName().toString())
+          .filter(n -> n.endsWith(".yaml"))
+          .map(n -> n.substring(0, n.length() - ".yaml".length()))
+          .sorted()
+          .toList();
+    } catch (IOException e) {
+      throw new UncheckedIOException(e);
+    }
+  }
+
+  /** Mọi thao tác của một tệp hợp đồng (bản nguồn trong {@code openapi/modules}). */
+  static List<ContractOperation> operations(String file, String folder) {
+    Path path =
+        "dist".equals(folder)
+            ? CONTRACTS.resolve("dist").resolve(file + ".yaml")
+            : CONTRACTS.resolve("openapi/modules").resolve(file + ".yaml");
+    JsonNode paths = readYaml(path).path("paths");
+    List<ContractOperation> result = new ArrayList<>();
+    for (Iterator<Map.Entry<String, JsonNode>> it = paths.fields(); it.hasNext(); ) {
+      JsonNode item = it.next().getValue();
+      for (String method : List.of("get", "put", "post", "delete", "patch", "head", "options")) {
+        JsonNode op = item.get(method);
+        if (op != null) {
+          result.add(
+              new ContractOperation(
+                  file, op.path("operationId").asText(), op.path("x-mission").path("owner").asText()));
+        }
+      }
+    }
+    return result;
+  }
+}
diff --git a/backend/libs/vt-api-contract/src/test/java/vn/viettel/okrkpi/contract/GeneratedModelsTest.java b/backend/libs/vt-api-contract/src/test/java/vn/viettel/okrkpi/contract/GeneratedModelsTest.java
new file mode 100644
index 0000000..5721a11
--- /dev/null
+++ b/backend/libs/vt-api-contract/src/test/java/vn/viettel/okrkpi/contract/GeneratedModelsTest.java
@@ -0,0 +1,166 @@
+package vn.viettel.okrkpi.contract;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import com.fasterxml.jackson.annotation.JsonProperty;
+import com.fasterxml.jackson.annotation.JsonValue;
+import com.fasterxml.jackson.databind.JsonNode;
+import java.lang.reflect.Field;
+import java.lang.reflect.Method;
+import java.time.LocalDate;
+import java.time.OffsetDateTime;
+import java.util.ArrayList;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeSet;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import vn.viettel.okrkpi.contract.ContractFixtures.Unit;
+import vn.viettel.okrkpi.contract.jobs.model.Job;
+import vn.viettel.okrkpi.contract.jobs.model.JobStatus;
+import vn.viettel.okrkpi.contract.jobs.model.ProblemDetails;
+import vn.viettel.okrkpi.contract.tasks.model.PeriodRef;
+import vn.viettel.okrkpi.contract.tasks.model.TaskStatus;
+
+/**
+ * Kiểm kiểu sinh ra giữ đúng hợp đồng: tên trường JSON camelCase như lược đồ, giá trị liệt kê mã
+ * tiếng Việt (DA_GIAO, CHO_NGHIEM_THU...), kiểu Uuid, Date, DateTime, ProblemDetails, Job.
+ */
+class GeneratedModelsTest {
+
+  @Test
+  void kieuDungChungAnhXaDung() throws Exception {
+    assertThat(PeriodRef.class.getDeclaredField("id").getType()).isEqualTo(UUID.class);
+    assertThat(PeriodRef.class.getDeclaredField("startDate").getType()).isEqualTo(LocalDate.class);
+    assertThat(Job.class.getDeclaredField("updatedAt").getType()).isEqualTo(OffsetDateTime.class);
+    assertThat(Job.class.getDeclaredField("status").getType()).isEqualTo(JobStatus.class);
+    assertThat(Job.class.getDeclaredField("problem").getType()).isEqualTo(ProblemDetails.class);
+    assertThat(jsonNames(ProblemDetails.class))
+        .containsExactlyInAnyOrder(
+            "type", "title", "status", "detail", "instance", "code", "msg", "errors", "traceId");
+    assertThat(enumValues(JobStatus.class))
+        .containsExactly("CHO", "DANG_CHAY", "HOAN_TAT", "THAT_BAI", "DA_HUY");
+    assertThat(enumValues(TaskStatus.class)).contains("DA_GIAO", "CHO_NGHIEM_THU");
+  }
+
+  @Test
+  void moiLuocDoKhopTenTruongVaGiaTriLietKe() {
+    List<String> problems = new ArrayList<>();
+    int objects = 0;
+    int enums = 0;
+    for (Unit unit : ContractFixtures.UNITS) {
+      JsonNode document =
+          ContractFixtures.readYaml(ContractFixtures.CONTRACTS.resolve("dist/" + unit.file() + ".yaml"));
+      JsonNode schemas = document.path("components").path("schemas");
+      Set<String> formSchemas = multipartSchemas(document);
+      for (Iterator<Map.Entry<String, JsonNode>> it = schemas.fields(); it.hasNext(); ) {
+        Map.Entry<String, JsonNode> entry = it.next();
+        String className = unit.basePackage() + ".model." + entry.getKey();
+        JsonNode schema = entry.getValue();
+        if (formSchemas.contains(entry.getKey())) {
+          // Thân multipart/form-data sinh thành tham số @RequestPart, không có lớp model.
+          continue;
+        }
+        if (schema.has("properties") && !isComposed(schema)) {
+          objects++;
+          Class<?> type = loadOrNull(className);
+          if (type == null) {
+            problems.add("thiếu lớp " + className);
+            continue;
+          }
+          Set<String> expected = new TreeSet<>();
+          schema.path("properties").fieldNames().forEachRemaining(expected::add);
+          Set<String> actual = jsonNames(type);
+          if (!actual.equals(expected)) {
+            problems.add(className + ": hợp đồng " + expected + ", mã " + actual);
+          }
+        } else if (schema.has("enum") && schema.path("enum").get(0).isTextual()) {
+          Class<?> type = loadOrNull(className);
+          if (type != null && type.isEnum()) {
+            enums++;
+            List<String> expected = new ArrayList<>();
+            schema.path("enum").forEach(v -> expected.add(v.asText()));
+            List<String> actual = enumValues(type);
+            if (!actual.equals(expected)) {
+              problems.add(className + ": hợp đồng " + expected + ", mã " + actual);
+            }
+          }
+        }
+      }
+    }
+    assertThat(problems).isEmpty();
+    assertThat(objects).as("số lược đồ object đã kiểm").isGreaterThan(500);
+    assertThat(enums).as("số enum đã kiểm").isGreaterThan(100);
+  }
+
+  private static Set<String> multipartSchemas(JsonNode document) {
+    Set<String> names = new TreeSet<>();
+    document
+        .path("paths")
+        .forEach(
+            item ->
+                item.forEach(
+                    op -> {
+                      String ref =
+                          op.path("requestBody")
+                              .path("content")
+                              .path("multipart/form-data")
+                              .path("schema")
+                              .path("$ref")
+                              .asText("");
+                      if (!ref.isEmpty()) {
+                        names.add(ref.substring(ref.lastIndexOf('/') + 1));
+                      }
+                    }));
+    return names;
+  }
+
+  private static boolean isComposed(JsonNode schema) {
+    return schema.has("allOf") || schema.has("oneOf") || schema.has("anyOf");
+  }
+
+  private static Class<?> loadOrNull(String name) {
+    try {
+      return Class.forName(name);
+    } catch (ClassNotFoundException e) {
+      return null;
+    }
+  }
+
+  static Set<String> jsonNames(Class<?> type) {
+    Set<String> names = new TreeSet<>();
+    for (Field field : type.getDeclaredFields()) {
+      JsonProperty property = field.getAnnotation(JsonProperty.class);
+      if (property != null) {
+        names.add(property.value());
+      }
+    }
+    for (Method method : type.getDeclaredMethods()) {
+      JsonProperty property = method.getAnnotation(JsonProperty.class);
+      if (property != null) {
+        names.add(property.value());
+      }
+    }
+    return names;
+  }
+
+  static List<String> enumValues(Class<?> type) {
+    Method valueMethod = null;
+    for (Method method : type.getDeclaredMethods()) {
+      if (method.isAnnotationPresent(JsonValue.class)) {
+        valueMethod = method;
+      }
+    }
+    List<String> values = new ArrayList<>();
+    for (Object constant : type.getEnumConstants()) {
+      try {
+        values.add(String.valueOf(valueMethod == null ? constant : valueMethod.invoke(constant)));
+      } catch (ReflectiveOperationException e) {
+        throw new IllegalStateException(e);
+      }
+    }
+    return values;
+  }
+}
