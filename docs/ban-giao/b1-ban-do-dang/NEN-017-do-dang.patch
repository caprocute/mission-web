+++ b/services-go/vtplatform/db/db.go
@@ -0,0 +1,89 @@
+// Gói db mở giao dịch pgx có ngữ cảnh tenant cục bộ giao dịch (TL-03 "Đặt ngữ cảnh tenant an toàn
+// qua PgBouncer chế độ giao dịch", L706-734): ngay sau BeginTx gọi
+// `select set_config('app.tenant_id', $1, true)`, tự huỷ khi COMMIT hoặc ROLLBACK. Gói cố ý không
+// có API đặt tenant mức phiên (SET không LOCAL) vì PgBouncer chế độ giao dịch trả kết nối máy chủ
+// cho khách khác sau mỗi giao dịch, tham số phiên sẽ rò sang tenant khác.
+package db
+
+import (
+	"context"
+	"errors"
+	"fmt"
+
+	"github.com/google/uuid"
+	"github.com/jackc/pgx/v5"
+
+	"okrkpi.vn/vtplatform/tenant"
+)
+
+// SetTenantSQL là câu lệnh duy nhất đặt ngữ cảnh tenant (tham số thứ ba true = cục bộ giao dịch).
+const SetTenantSQL = "select set_config('app.tenant_id', $1, true)"
+
+// Beginner là thứ mở được giao dịch: *pgxpool.Pool, *pgx.Conn, hoặc pgx.Tx (savepoint).
+type Beginner interface {
+	BeginTx(ctx context.Context, opts pgx.TxOptions) (pgx.Tx, error)
+}
+
+// TxFunc là phần việc chạy trong giao dịch; trả lỗi thì giao dịch bị huỷ.
+type TxFunc func(ctx context.Context, tx pgx.Tx) error
+
+// InTx chạy fn trong một giao dịch đọc ghi với tenant lấy từ ctx (tenant.With hoặc
+// tenant.Middleware). Thiếu tenant thì vẫn mở giao dịch nhưng đặt chuỗi rỗng, để chính sách RLS
+// nullif(current_setting(app.tenant_id), chuỗi rỗng)::uuid cho NULL và trả rỗng ("mặc định từ
+// chối"), cùng hành vi TenantJpaTransactionManager của Java (NEN-010).
+func InTx(ctx context.Context, b Beginner, fn TxFunc) error {
+	return InTxOptions(ctx, b, pgx.TxOptions{}, fn)
+}
+
+// InReadTx như InTx nhưng giao dịch chỉ đọc (tương đương @Transactional(readOnly = true)): mọi
+// truy vấn đọc cũng phải nằm trong giao dịch tường minh để có ngữ cảnh tenant.
+func InReadTx(ctx context.Context, b Beginner, fn TxFunc) error {
+	return InTxOptions(ctx, b, pgx.TxOptions{AccessMode: pgx.ReadOnly}, fn)
+}
+
+// InTxOptions như InTx với tuỳ chọn giao dịch cho trước.
+func InTxOptions(ctx context.Context, b Beginner, opts pgx.TxOptions, fn TxFunc) error {
+	value := ""
+	if id, ok := tenant.From(ctx); ok {
+		value = id.String()
+	}
+	tx, err := b.BeginTx(ctx, opts)
+	if err != nil {
+		return fmt.Errorf("mở giao dịch: %w", err)
+	}
+	if _, err := tx.Exec(ctx, SetTenantSQL, value); err != nil {
+		_ = tx.Rollback(context.WithoutCancel(ctx))
+		return fmt.Errorf("đặt ngữ cảnh tenant: %w", err)
+	}
+	if err := fn(ctx, tx); err != nil {
+		if rbErr := tx.Rollback(context.WithoutCancel(ctx)); rbErr != nil && !errors.Is(rbErr, pgx.ErrTxClosed) {
+			return errors.Join(err, fmt.Errorf("huỷ giao dịch: %w", rbErr))
+		}
+		return err
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return fmt.Errorf("cam kết giao dịch: %w", err)
+	}
+	return nil
+}
+
+// InTenantTx gắn tenant id vào ctx rồi chạy InTx; dùng cho consumer và job không có yêu cầu HTTP.
+func InTenantTx(ctx context.Context, b Beginner, id uuid.UUID, fn TxFunc) error {
+	if id == uuid.Nil {
+		return tenant.ErrMissing
+	}
+	return InTx(tenant.With(ctx, id), b, fn)
+}
+
+// CurrentTenant đọc app.tenant_id của giao dịch hiện hành (rỗng nếu chưa đặt); dùng để kiểm thử
+// và chẩn đoán.
+func CurrentTenant(ctx context.Context, tx pgx.Tx) (string, error) {
+	var v *string
+	if err := tx.QueryRow(ctx, "select current_setting('app.tenant_id', true)").Scan(&v); err != nil {
+		return "", err
+	}
+	if v == nil {
+		return "", nil
+	}
+	return *v, nil
+}
diff --git a/services-go/vtplatform/events/catalog.go b/services-go/vtplatform/events/catalog.go
new file mode 100644
index 0000000..2af6480
--- /dev/null
+++ b/services-go/vtplatform/events/catalog.go
@@ -0,0 +1,133 @@
+// Gói events nạp hợp đồng sự kiện của NEN-007 (contracts/events/catalog.yaml và lược đồ Avro
+// avro/<miền>/<Tên>.avsc, nhúng bằng go:embed) và tra global id lược đồ trong Apicurio Registry.
+// Đồng thời định nghĩa tên header Kafka của phong bì CloudEvents chế độ nhị phân (TL-03 "Phong bì
+// sự kiện", contracts/events/README.md).
+package events
+
+import (
+	"embed"
+	"fmt"
+	"path"
+	"sync"
+
+	"github.com/hamba/avro/v2"
+	"gopkg.in/yaml.v3"
+)
+
+// Bản chép của contracts/events, sinh bằng `go generate ./...`, không sửa tay.
+//
+//go:embed contracts/catalog.yaml contracts/avro
+var contractFS embed.FS
+
+// Entry là một sự kiện hoặc topic kỹ thuật của danh mục.
+type Entry struct {
+	Code           string   `yaml:"code"` // EVT-xx; rỗng với topic kỹ thuật
+	Name           string   `yaml:"name"` // tên nghiệp vụ = tên record Avro
+	Topic          string   `yaml:"topic"`
+	Key            string   `yaml:"key"`
+	Outbox         *string  `yaml:"outbox"` // nil khi không đi qua outbox PostgreSQL
+	Classification string   `yaml:"classification"`
+	Producer       string   `yaml:"producer"`
+	Consumers      []string `yaml:"consumers"`
+	Note           string   `yaml:"note"`
+	SchemaPath     string   `yaml:"schema"`
+	ArtifactID     string   `yaml:"artifactId"`
+
+	schemaJSON string
+	schema     avro.Schema
+}
+
+// SchemaJSON là nội dung tệp .avsc nguyên văn (dùng để tra Apicurio theo nội dung).
+func (e *Entry) SchemaJSON() string { return e.schemaJSON }
+
+// Schema là lược đồ Avro đã phân tích.
+func (e *Entry) Schema() avro.Schema { return e.schema }
+
+// ViaOutbox cho biết sự kiện có đi qua outbox PostgreSQL không.
+func (e *Entry) ViaOutbox() bool { return e.Outbox != nil && *e.Outbox != "" }
+
+// AllowsOutboxSchema cho biết schema CSDL có được ghi outbox của sự kiện này không: khớp
+// "<schema>.outbox_event" hoặc "*.outbox_event" (sự kiện phát bởi mọi module, ví dụ EVT-21).
+func (e *Entry) AllowsOutboxSchema(schema string) bool {
+	if !e.ViaOutbox() {
+		return false
+	}
+	return *e.Outbox == "*.outbox_event" || *e.Outbox == schema+".outbox_event"
+}
+
+// Catalog là danh mục sự kiện theo topic.
+type Catalog struct {
+	Version       int
+	Compatibility string
+	byTopic       map[string]*Entry
+	topics        []string
+}
+
+// Lookup tra theo topic.
+func (c *Catalog) Lookup(topic string) (*Entry, bool) {
+	e, ok := c.byTopic[topic]
+	return e, ok
+}
+
+// Topics trả mọi topic theo thứ tự trong danh mục.
+func (c *Catalog) Topics() []string { return append([]string(nil), c.topics...) }
+
+var (
+	loadOnce sync.Once
+	loaded   *Catalog
+	loadErr  error
+)
+
+// Load nạp danh mục nhúng (một lần cho cả tiến trình).
+func Load() (*Catalog, error) {
+	loadOnce.Do(func() { loaded, loadErr = parse() })
+	return loaded, loadErr
+}
+
+// MustLoad như Load nhưng panic khi tệp nhúng sai (lỗi đóng gói).
+func MustLoad() *Catalog {
+	c, err := Load()
+	if err != nil {
+		panic("vtplatform/events: " + err.Error())
+	}
+	return c
+}
+
+func parse() (*Catalog, error) {
+	raw, err := contractFS.ReadFile("contracts/catalog.yaml")
+	if err != nil {
+		return nil, err
+	}
+	var doc struct {
+		Version         int      `yaml:"version"`
+		Compatibility   string   `yaml:"compatibility"`
+		Events          []*Entry `yaml:"events"`
+		TechnicalTopics []*Entry `yaml:"technicalTopics"`
+	}
+	if err := yaml.Unmarshal(raw, &doc); err != nil {
+		return nil, fmt.Errorf("không đọc được catalog.yaml: %w", err)
+	}
+	c := &Catalog{Version: doc.Version, Compatibility: doc.Compatibility, byTopic: map[string]*Entry{}}
+	for _, e := range append(doc.Events, doc.TechnicalTopics...) {
+		if e.Topic == "" || e.SchemaPath == "" {
+			return nil, fmt.Errorf("mục danh mục thiếu topic hoặc schema: %+v", *e)
+		}
+		if _, dup := c.byTopic[e.Topic]; dup {
+			return nil, fmt.Errorf("topic trùng trong danh mục: %s", e.Topic)
+		}
+		b, err := contractFS.ReadFile(path.Join("contracts", e.SchemaPath))
+		if err != nil {
+			return nil, fmt.Errorf("thiếu lược đồ %s của %s: %w", e.SchemaPath, e.Topic, err)
+		}
+		e.schemaJSON = string(b)
+		// Mỗi lược đồ phân tích trong cache riêng để tên record trùng giữa các tệp không xung đột.
+		s, err := avro.ParseWithCache(e.schemaJSON, "", &avro.SchemaCache{})
+		if err != nil {
+			return nil, fmt.Errorf("lược đồ %s sai: %w", e.SchemaPath, err)
+		}
+		e.schema = s
+		c.byTopic[e.Topic] = e
+		c.topics = append(c.topics, e.Topic)
+	}
+	return c, nil
+}
