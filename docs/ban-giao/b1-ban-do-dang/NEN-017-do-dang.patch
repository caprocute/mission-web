diff --git a/services-go/vtplatform/problem/problem.go b/services-go/vtplatform/problem/problem.go
new file mode 100644
index 0000000..0aaca66
--- /dev/null
+++ b/services-go/vtplatform/problem/problem.go
@@ -0,0 +1,338 @@
+package problem
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"log/slog"
+	"net/http"
+	"net/url"
+	"regexp"
+	"strconv"
+	"strings"
+
+	"go.opentelemetry.io/otel/trace"
+)
+
+// ContentType là kiểu nội dung của phản hồi lỗi.
+const ContentType = "application/problem+json"
+
+// FieldError là lỗi theo trường, đúng lược đồ FieldError của common.yaml.
+type FieldError struct {
+	Field   string `json:"field"`
+	Message string `json:"message"`
+	Rule    string `json:"rule,omitempty"` // mã quy tắc nghiệp vụ, ví dụ BR-05-01
+}
+
+// Details là thân application/problem+json, đúng lược đồ ProblemDetails của common.yaml:
+// type, title, status, detail, instance và phần mở rộng code, msg, errors[], traceId.
+type Details struct {
+	Type     string       `json:"type"`
+	Title    string       `json:"title"`
+	Status   int          `json:"status"`
+	Detail   string       `json:"detail,omitempty"`
+	Instance string       `json:"instance,omitempty"`
+	Code     string       `json:"code,omitempty"`
+	Msg      string       `json:"msg,omitempty"`
+	Errors   []FieldError `json:"errors,omitempty"`
+	TraceID  string       `json:"traceId,omitempty"`
+}
+
+// Error là lỗi nghiệp vụ mang một mã của danh mục (tương đương BusinessException của Java).
+// Mã phải có trong danh mục hợp đồng; dựng bằng New hoặc NewWith.
+type Error struct {
+	code    Code
+	Detail  string
+	Msg     string
+	Errors  []FieldError
+	Headers http.Header // header phản hồi thêm, ví dụ Retry-After
+}
+
+func (e *Error) Error() string { return e.code.Code }
+
+// Code trả mã lỗi.
+func (e *Error) Code() Code { return e.code }
+
+// New dựng lỗi nghiệp vụ theo mã của danh mục chuẩn; panic nếu mã không có (lỗi lập trình, giống
+// ErrorCatalog.require của Java).
+func New(code, detail string, fieldErrors ...FieldError) *Error {
+	return NewWith(StandardCatalog().Require(code), detail, "", fieldErrors...)
+}
+
+// NewWith dựng lỗi từ một Code đã tra (ví dụ Catalog.VersionConflict) với msg ghi đè tuỳ chọn.
+func NewWith(code Code, detail, msg string, fieldErrors ...FieldError) *Error {
+	if msg != "" && !MsgPattern.MatchString(msg) {
+		panic("vtplatform/problem: msg sai dạng MSG-xx-yy: " + msg)
+	}
+	if msg == "" {
+		msg = code.Msg
+	}
+	return &Error{code: code, Detail: detail, Msg: msg, Errors: fieldErrors}
+}
+
+// VersionConflict là lỗi 409 <MODULE>-409-VERSION-CONFLICT khi If-Match lệch phiên bản.
+func VersionConflict(module, detail string) *Error {
+	c, err := StandardCatalog().VersionConflict(module)
+	if err != nil {
+		panic("vtplatform/problem: " + err.Error())
+	}
+	if detail == "" {
+		detail = "Dữ liệu đã thay đổi kể từ lần bạn mở. Vui lòng tải lại để xem bản mới nhất."
+	}
+	return NewWith(c, detail, "")
+}
+
+// StatusError là lỗi khung theo HTTP status (không có mã nghiệp vụ), ví dụ 401, 404, 428, 503.
+type StatusError struct {
+	Status  int
+	Detail  string
+	Errors  []FieldError
+	Headers http.Header
+}
+
+func (e *StatusError) Error() string { return "http " + strconv.Itoa(e.Status) }
+
+// Status dựng lỗi khung theo status; detail rỗng dùng mô tả chung.
+func Status(status int, detail string) *StatusError {
+	return &StatusError{Status: status, Detail: detail}
+}
+
+// Writer dựng và ghi Problem Details. Giá trị không là Writer mặc định dùng danh mục chuẩn và
+// nhật ký slog mặc định.
+type Writer struct {
+	Catalog *Catalog
+	Logger  *slog.Logger
+}
+
+// Default là Writer dùng danh mục chuẩn.
+var Default = &Writer{}
+
+func (w *Writer) catalog() *Catalog {
+	if w == nil || w.Catalog == nil {
+		return StandardCatalog()
+	}
+	return w.Catalog
+}
+
+func (w *Writer) logger() *slog.Logger {
+	if w == nil || w.Logger == nil {
+		return slog.Default()
+	}
+	return w.Logger
+}
+
+// FromCode dựng Problem của một mã trong danh mục.
+func (w *Writer) FromCode(r *http.Request, code Code, detail, msg string, fieldErrors []FieldError) Details {
+	if msg == "" {
+		msg = code.Msg
+	}
+	d := Details{Type: code.Type, Title: code.Title, Status: code.Status, Detail: detail,
+		Code: code.Code, Msg: msg}
+	return w.finish(r, d, fieldErrors)
+}
+
+// Standard dựng Problem chuẩn của một HTTP status. Status 403 mang mã COMMON-403-OUT-OF-SCOPE
+// của hợp đồng, như ProblemFactory.standard của Java.
+func (w *Writer) Standard(r *http.Request, status int, detail string, fieldErrors []FieldError) Details {
+	if status == http.StatusForbidden {
+		c := w.catalog().Require(ForbiddenCode)
+		if detail == "" {
+			detail = ForStatus(403).Detail
+		}
+		return w.FromCode(r, c, detail, "", fieldErrors)
+	}
+	if status == http.StatusUnprocessableEntity && len(fieldErrors) > 0 {
+		if c, ok := w.catalog().Find(ValidationCode); ok {
+			if detail == "" {
+				detail = ForStatus(422).Detail
+			}
+			return w.FromCode(r, c, detail, "", fieldErrors)
+		}
+	}
+	std := ForStatus(status)
+	if detail == "" {
+		detail = std.Detail
+	}
+	return w.finish(r, Details{Type: std.Type, Title: std.Title, Status: status, Detail: detail}, fieldErrors)
+}
+
+func (w *Writer) finish(r *http.Request, d Details, fieldErrors []FieldError) Details {
+	if r != nil && r.URL != nil {
+		d.Instance = safePath(r.URL.EscapedPath())
+	}
+	if len(fieldErrors) > 0 {
+		d.Errors = append([]FieldError(nil), fieldErrors...)
+	}
+	d.TraceID = TraceID(r)
+	return d
+}
+
+// Write ghi lỗi err thành application/problem+json: *Error theo mã danh mục, *StatusError theo
+// status, lỗi khác thành 500 chung (chi tiết chỉ vào nhật ký, không lộ ra phản hồi).
+func (w *Writer) Write(rw http.ResponseWriter, r *http.Request, err error) {
+	var (
+		d       Details
+		headers http.Header
+		be      *Error
+		se      *StatusError
+	)
+	switch {
+	case errors.As(err, &be):
+		d = w.FromCode(r, be.code, be.Detail, be.Msg, be.Errors)
+		headers = be.Headers
+		w.logger().LogAttrs(ctxOf(r), slog.LevelInfo, "Lỗi phía khách",
+			slog.String("code", d.Code), slog.Int("status", d.Status), slog.String("instance", d.Instance))
+	case errors.As(err, &se):
+		d = w.Standard(r, se.Status, se.Detail, se.Errors)
+		headers = se.Headers
+		level := slog.LevelInfo
+		if se.Status >= 500 {
+			level = slog.LevelWarn
+		}
+		w.logger().LogAttrs(ctxOf(r), level, "Lỗi khung",
+			slog.Int("status", d.Status), slog.String("instance", d.Instance))
+	default:
+		d = w.Standard(r, http.StatusInternalServerError, "", nil)
+		msg := "<nil>"
+		if err != nil {
+			msg = err.Error()
+		}
+		w.logger().LogAttrs(ctxOf(r), slog.LevelError, "Lỗi ngoài dự kiến",
+			slog.String("traceId", d.TraceID), slog.String("instance", d.Instance), slog.String("error", msg))
+	}
+	WriteDetails(rw, d, headers)
+}
+
+// WriteStatus ghi Problem chuẩn của một status.
+func (w *Writer) WriteStatus(rw http.ResponseWriter, r *http.Request, status int, detail string) {
+	WriteDetails(rw, w.Standard(r, status, detail, nil), nil)
+}
+
+// WriteDetails ghi một Problem đã dựng.
+func WriteDetails(rw http.ResponseWriter, d Details, headers http.Header) {
+	for k, vs := range headers {
+		for _, v := range vs {
+			rw.Header().Add(k, v)
+		}
+	}
+	rw.Header().Set("Content-Type", ContentType)
+	rw.Header().Set("Cache-Control", "no-store")
+	rw.WriteHeader(d.Status)
+	_ = json.NewEncoder(rw).Encode(d)
+}
+
+// Write ghi lỗi bằng Writer mặc định.
+func Write(rw http.ResponseWriter, r *http.Request, err error) { Default.Write(rw, r, err) }
+
+// WriteStatus ghi Problem chuẩn bằng Writer mặc định.
+func WriteStatus(rw http.ResponseWriter, r *http.Request, status int, detail string) {
+	Default.WriteStatus(rw, r, status, detail)
+}
+
+// HandlerFunc là handler trả lỗi; lỗi khác nil được ghi thành Problem Details.
+type HandlerFunc func(http.ResponseWriter, *http.Request) error
+
+// Handler chuyển HandlerFunc thành http.Handler dùng Writer w (nil dùng Default).
+func (w *Writer) Handler(h HandlerFunc) http.Handler {
+	return http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		if err := h(rw, r); err != nil {
+			w.Write(rw, r, err)
+		}
+	})
+}
+
+// Recover bắt panic của handler phía sau và trả 500 chung (không lộ stack trace).
+func (w *Writer) Recover(next http.Handler) http.Handler {
+	return http.HandlerFunc(func(rw http.ResponseWriter, r *http.Request) {
+		defer func() {
+			if v := recover(); v != nil {
+				if v == http.ErrAbortHandler {
+					panic(v)
+				}
+				w.Write(rw, r, fmt.Errorf("panic: %v", v))
+			}
+		}()
+		next.ServeHTTP(rw, r)
+	})
+}
+
+func ctxOf(r *http.Request) context.Context {
+	if r == nil {
+		return context.Background()
+	}
+	return r.Context()
+}
+
+// safePath chỉ giữ đường dẫn hợp lệ làm URI tương đối; đường dẫn lạ bỏ qua.
+func safePath(p string) string {
+	if p == "" {
+		return ""
+	}
+	u, err := url.Parse(p)
+	if err != nil || u.Scheme != "" || u.Host != "" {
+		return ""
+	}
+	return u.EscapedPath()
+}
+
+var (
+	traceparentRe = regexp.MustCompile(`^[0-9a-f]{2}-([0-9a-f]{32})-[0-9a-f]{16}-[0-9a-f]{2}$`)
+	traceIDRe     = regexp.MustCompile(`^[0-9a-f]{32}$`)
+)
+
+type traceKey struct{}
+
+// TraceID là mã vết (32 hex) của yêu cầu theo thứ tự: span OpenTelemetry hiện hành; header W3C
+// traceparent hợp lệ; mã đã sinh cho yêu cầu này; nếu không có thì sinh ngẫu nhiên. Cùng hành vi
+// với W3cTraceIdResolver/OtelTraceIdResolver của Java.
+func TraceID(r *http.Request) string {
+	if r == nil {
+		return randomTraceID()
+	}
+	if sc := trace.SpanContextFromContext(r.Context()); sc.HasTraceID() {
+		return sc.TraceID().String()
+	}
+	if id := FromTraceparent(r.Header.Get("traceparent")); id != "" {
+		return id
+	}
+	if v, ok := r.Context().Value(traceKey{}).(*string); ok && v != nil {
+		if *v == "" {
+			*v = randomTraceID()
+		}
+		return *v
+	}
+	return randomTraceID()
+}
+
+// WithTraceSlot gắn vào ngữ cảnh yêu cầu một chỗ giữ mã vết sinh ngẫu nhiên, để phản hồi và nhật
+// ký của cùng một yêu cầu không có span dùng chung một mã. Middleware otel.HTTP tự gọi.
+func WithTraceSlot(ctx context.Context) context.Context {
+	s := ""
+	return context.WithValue(ctx, traceKey{}, &s)
+}
+
+// FromTraceparent lấy trace id từ header traceparent hợp lệ, rỗng nếu không hợp lệ.
+func FromTraceparent(h string) string {
+	m := traceparentRe.FindStringSubmatch(strings.ToLower(strings.TrimSpace(h)))
+	if m == nil {
+		return ""
+	}
+	return validTraceID(m[1])
+}
+
+func validTraceID(v string) string {
+	v = strings.ToLower(strings.TrimSpace(v))
+	if !traceIDRe.MatchString(v) || v == strings.Repeat("0", 32) {
+		return ""
+	}
+	return v
+}
+
+func randomTraceID() string {
+	b := make([]byte, 16)
+	_, _ = rand.Read(b)
+	return hex.EncodeToString(b)
+}
diff --git a/services-go/vtplatform/problem/types.go b/services-go/vtplatform/problem/types.go
new file mode 100644
index 0000000..70091cb
--- /dev/null
+++ b/services-go/vtplatform/problem/types.go
@@ -0,0 +1,73 @@
+package problem
+
+// Loại lỗi chuẩn theo HTTP status cho lỗi khung (không có mã nghiệp vụ), giữ nguyên URI, tiêu đề
+// và mô tả của ProblemTypes.java để Go và Java trả cùng một nội dung.
+
+// BaseURI là gốc URI type của hợp đồng (common.yaml, TL-01).
+const BaseURI = "https://okrkpi.vn/problems/"
+
+const (
+	// ConcurrentModification là type của xung đột ghi đồng thời (BS-02 HD-01).
+	ConcurrentModification = BaseURI + "concurrent-modification"
+	// ConcurrentModificationTitle là tiêu đề theo ví dụ của common.yaml.
+	ConcurrentModificationTitle = "Dữ liệu đã được người khác cập nhật"
+	// ValidationCode là mã lỗi khung kiểm dữ liệu theo trường.
+	ValidationCode = "COMMON-422-VALIDATION"
+	// ForbiddenCode là mã lỗi khung khi RBAC/OPA hoặc ngữ cảnh tenant từ chối.
+	ForbiddenCode = "COMMON-403-OUT-OF-SCOPE"
+)
+
+// Standard là loại lỗi chuẩn của một HTTP status.
+type Standard struct {
+	Type   string
+	Title  string
+	Detail string
+}
+
+var (
+	fallback4xx = Standard{BaseURI + "bad-request", "Yêu cầu không hợp lệ",
+		"Yêu cầu không thực hiện được. Vui lòng kiểm tra lại."}
+	internal = Standard{BaseURI + "internal-error", "Hệ thống đang gặp sự cố",
+		"Đã có lỗi ngoài dự kiến. Vui lòng thử lại sau; nếu lỗi lặp lại, liên hệ quản trị và cung cấp mã tra cứu."}
+	byStatus = map[int]Standard{
+		400: fallback4xx,
+		401: {BaseURI + "unauthorized", "Chưa đăng nhập hoặc phiên làm việc đã hết hạn",
+			"Vui lòng đăng nhập lại để tiếp tục."},
+		403: {BaseURI + "forbidden", "Không có quyền thực hiện thao tác này",
+			"Tài khoản không có quyền với dữ liệu hoặc thao tác này."},
+		404: {BaseURI + "not-found", "Không tìm thấy dữ liệu",
+			"Dữ liệu không tồn tại hoặc nằm ngoài phạm vi được xem."},
+		405: {BaseURI + "method-not-allowed", "Thao tác không được hỗ trợ",
+			"Thao tác này không áp dụng cho dữ liệu đã chọn."},
+		406: {BaseURI + "not-acceptable", "Định dạng phản hồi không được hỗ trợ",
+			"Hệ thống không trả được dữ liệu theo định dạng yêu cầu."},
+		409: {BaseURI + "conflict", "Xung đột dữ liệu",
+			"Thao tác không thực hiện được ở trạng thái hiện tại của dữ liệu."},
+		413: {BaseURI + "payload-too-large", "Dữ liệu gửi lên quá lớn",
+			"Vui lòng giảm kích thước dữ liệu hoặc tệp đính kèm."},
+		415: {BaseURI + "unsupported-media-type", "Định dạng dữ liệu không được hỗ trợ",
+			"Vui lòng gửi dữ liệu đúng định dạng."},
+		421: {BaseURI + "misdirected-request", "Đơn vị đã chuyển sang máy chủ khác",
+			"Vui lòng tải lại trang để tiếp tục."},
+		422: {BaseURI + "validation", "Dữ liệu chưa hợp lệ", "Vui lòng kiểm tra lại dữ liệu."},
+		428: {BaseURI + "precondition-required", "Thiếu thông tin phiên bản dữ liệu",
+			"Yêu cầu cập nhật phải kèm phiên bản dữ liệu đã đọc trước đó."},
+		429: {BaseURI + "too-many-requests", "Thao tác quá nhanh", "Vui lòng chờ một lát rồi thử lại."},
+		500: internal,
+		502: {BaseURI + "bad-gateway", "Hệ thống liên quan không phản hồi", "Vui lòng thử lại sau."},
+		503: {BaseURI + "service-unavailable", "Hệ thống đang bận",
+			"Hệ thống đang quá tải hoặc bảo trì. Vui lòng thử lại sau."},
+		504: {BaseURI + "gateway-timeout", "Hệ thống phản hồi quá lâu", "Vui lòng thử lại sau."},
+	}
+)
+
+// ForStatus trả loại lỗi chuẩn của một HTTP status; status lạ dùng loại chung của nhóm 4xx hoặc 5xx.
+func ForStatus(status int) Standard {
+	if s, ok := byStatus[status]; ok {
+		return s
+	}
+	if status >= 500 {
+		return internal
+	}
+	return fallback4xx
+}
diff --git a/services-go/vtplatform/tenant/tenant.go b/services-go/vtplatform/tenant/tenant.go
new file mode 100644
index 0000000..03a0eec
--- /dev/null
+++ b/services-go/vtplatform/tenant/tenant.go
@@ -0,0 +1,132 @@
+// Gói tenant giữ ngữ cảnh khách thuê (tenant) của yêu cầu hoặc của sự kiện trong context.Context
+// và cung cấp middleware net/http đọc claim tenant từ JWT đã được xác thực (ADR-22; TL-01 "Lan
+// truyền ngữ cảnh tenant từ JWT tới RLS"; tương đương TenantContext/TenantContextFilter của
+// NEN-010). Gói không tự kiểm chữ ký JWT: bộ xác thực phía trước (cổng APISIX hoặc middleware
+// OIDC của service) đặt claim đã kiểm vào ngữ cảnh bằng WithClaims.
+package tenant
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"strings"
+
+	"github.com/google/uuid"
+
+	"okrkpi.vn/vtplatform/problem"
+)
+
+// DefaultClaim là tên claim tenant mặc định theo TL-01 L881. TL-03 L758 dùng `tid`, realm dev dùng
+// `tenant`: service đặt Config.Claim theo realm (điểm lệch ghi ở báo cáo NEN-010).
+const DefaultClaim = "tenant_id"
+
+// ErrMissing báo ngữ cảnh không có tenant.
+var ErrMissing = errors.New("thiếu ngữ cảnh tenant")
+
+type tenantKey struct{}
+type claimsKey struct{}
+
+// With gắn tenant vào ngữ cảnh (dùng cho job, consumer; yêu cầu HTTP do Middleware gắn).
+func With(ctx context.Context, id uuid.UUID) context.Context {
+	return context.WithValue(ctx, tenantKey{}, id)
+}
+
+// From đọc tenant của ngữ cảnh.
+func From(ctx context.Context) (uuid.UUID, bool) {
+	id, ok := ctx.Value(tenantKey{}).(uuid.UUID)
+	return id, ok && id != uuid.Nil
+}
+
+// Require đọc tenant của ngữ cảnh, trả ErrMissing nếu thiếu.
+func Require(ctx context.Context) (uuid.UUID, error) {
+	id, ok := From(ctx)
+	if !ok {
+		return uuid.Nil, ErrMissing
+	}
+	return id, nil
+}
+
+// Parse đọc mã tenant dạng UUID; chuỗi rỗng, sai dạng hoặc UUID rỗng đều lỗi.
+func Parse(s string) (uuid.UUID, error) {
+	id, err := uuid.Parse(strings.TrimSpace(s))
+	if err != nil || id == uuid.Nil {
+		return uuid.Nil, ErrMissing
+	}
+	return id, nil
+}
+
+// WithClaims gắn claim của JWT đã xác thực vào ngữ cảnh; bộ xác thực gọi trước Middleware.
+func WithClaims(ctx context.Context, claims map[string]any) context.Context {
+	return context.WithValue(ctx, claimsKey{}, claims)
+}
+
+// Claims đọc claim đã xác thực của ngữ cảnh.
+func Claims(ctx context.Context) (map[string]any, bool) {
+	c, ok := ctx.Value(claimsKey{}).(map[string]any)
+	return c, ok
+}
+
+// Config cấu hình Middleware.
+type Config struct {
+	// Claim là tên claim chứa mã tenant; rỗng dùng DefaultClaim. Hỗ trợ đường dẫn chấm cho claim
+	// lồng nhau, ví dụ "org.tenant_id".
+	Claim string
+	// ClaimsFrom lấy claim đã xác thực của yêu cầu; nil dùng Claims(r.Context()).
+	ClaimsFrom func(*http.Request) (map[string]any, bool)
+	// Problems ghi phản hồi 403; nil dùng problem.Default.
+	Problems *problem.Writer
+}
+
+// Middleware đọc claim tenant từ JWT đã xác thực, gắn tenant vào ngữ cảnh và trả 403 Problem
+// Details (COMMON-403-OUT-OF-SCOPE) khi thiếu hoặc sai dạng.
+func Middleware(cfg Config) func(http.Handler) http.Handler {
+	claim := cfg.Claim
+	if claim == "" {
+		claim = DefaultClaim
+	}
+	claimsFrom := cfg.ClaimsFrom
+	if claimsFrom == nil {
+		claimsFrom = func(r *http.Request) (map[string]any, bool) { return Claims(r.Context()) }
+	}
+	pw := cfg.Problems
+	if pw == nil {
+		pw = problem.Default
+	}
+	return func(next http.Handler) http.Handler {
+		return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			claims, ok := claimsFrom(r)
+			var id uuid.UUID
+			var err error = ErrMissing
+			if ok {
+				if s, found := lookup(claims, claim); found {
+					id, err = Parse(s)
+				}
+			}
+			if err != nil {
+				pw.WriteStatus(w, r, http.StatusForbidden, "")
+				return
+			}
+			next.ServeHTTP(w, r.WithContext(With(r.Context(), id)))
+		})
+	}
+}
+
+func lookup(claims map[string]any, path string) (string, bool) {
+	if v, ok := claims[path]; ok {
+		s, ok := v.(string)
+		return s, ok
+	}
+	var cur any = claims
+	for _, part := range strings.Split(path, ".") {
+		m, ok := cur.(map[string]any)
+		if !ok {
+			return "", false
+		}
+		cur, ok = m[part]
+		if !ok {
+			return "", false
+		}
+	}
+	s, ok := cur.(string)
+	return s, ok
+}
