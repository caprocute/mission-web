diff --git a/services-go/vtplatform/events/headers.go b/services-go/vtplatform/events/headers.go
new file mode 100644
index 0000000..9c3cb83
--- /dev/null
+++ b/services-go/vtplatform/events/headers.go
@@ -0,0 +1,111 @@
+package events
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"strconv"
+	"strings"
+)
+
+// Tên header Kafka của phong bì CloudEvents 1.0 chế độ nhị phân (CloudEvents Kafka Protocol
+// Binding: thuộc tính `x` thành header `ce_x`), theo bảng phong bì của contracts/events/README.md
+// và các header ce_type, ce_tenantid, ce_classification, traceparent, apicurio.value.globalId của
+// cấu hình connector mẫu TL-03 "Transactional Outbox và Debezium".
+const (
+	HeaderSpecVersion      = "ce_specversion"
+	HeaderID               = "ce_id"
+	HeaderSource           = "ce_source"
+	HeaderType             = "ce_type" // tên topic
+	HeaderTime             = "ce_time" // occurredAt, RFC 3339
+	HeaderSubject          = "ce_subject"
+	HeaderTenantID         = "ce_tenantid"
+	HeaderActorID          = "ce_actorid"
+	HeaderPolicyVersion    = "ce_policyversion"
+	HeaderClassification   = "ce_classification"
+	HeaderAggregateVersion = "ce_aggregateversion"
+	HeaderContentType      = "content-type"
+	HeaderTraceparent      = "traceparent"
+	HeaderTracestate       = "tracestate"
+	HeaderGlobalID         = "apicurio.value.globalId"
+
+	// HeaderDebeziumID là header `id` mà Debezium EventRouter tự thêm từ cột id của outbox_event.
+	HeaderDebeziumID = "id"
+	// HeaderOutboxHeaders là header chứa nguyên cột jsonb headers của outbox_event khi connector
+	// đặt cột này thành một header (EventRouter không tách được jsonb thành nhiều header; xem
+	// testdata/debezium-outbox-connector.json). Consumer đọc bổ sung từ đây (suy luận).
+	HeaderOutboxHeaders = "outbox_headers"
+
+	// SpecVersion là phiên bản CloudEvents.
+	SpecVersion = "1.0"
+	// AvroContentType là datacontenttype của thân Avro nhị phân (suy luận).
+	AvroContentType = "application/avro"
+)
+
+// Headers là tập header phẳng của một sự kiện (khoá là tên header Kafka).
+type Headers map[string]string
+
+// Get đọc header theo tên, chấp nhận cả dạng không tiền tố "ce_" (ví dụ "tenantid") mà thẻ
+// NEN-011/NEN-012 dùng, để tương thích hai phía trong thời gian thống nhất tên.
+func (h Headers) Get(name string) string {
+	if v, ok := h[name]; ok {
+		return v
+	}
+	if strings.HasPrefix(name, "ce_") {
+		return h[strings.TrimPrefix(name, "ce_")]
+	}
+	return ""
+}
+
+// FromKafka dựng Headers từ header Kafka: header có tên trùng ưu tiên giá trị đầu; header
+// outbox_headers (JSON) bổ sung các khoá còn thiếu; apicurio.value.globalId nhị phân 8 byte (serde
+// Apicurio) đổi thành số thập phân.
+func FromKafka(keys []string, values [][]byte) Headers {
+	h := Headers{}
+	var outbox []byte
+	for i, k := range keys {
+		v := values[i]
+		if k == HeaderOutboxHeaders {
+			outbox = v
+			continue
+		}
+		if _, seen := h[k]; seen {
+			continue
+		}
+		if k == HeaderGlobalID && len(v) == 8 && !isDigits(v) {
+			h[k] = strconv.FormatInt(int64(binary.BigEndian.Uint64(v)), 10)
+			continue
+		}
+		h[k] = string(v)
+	}
+	if len(outbox) > 0 {
+		var extra map[string]any
+		if err := json.Unmarshal(outbox, &extra); err == nil {
+			for k, v := range extra {
+				if _, ok := h[k]; ok {
+					continue
+				}
+				switch t := v.(type) {
+				case string:
+					h[k] = t
+				case float64:
+					h[k] = strconv.FormatFloat(t, 'f', -1, 64)
+				}
+			}
+		}
+	}
+	if _, ok := h[HeaderID]; !ok {
+		if v, ok := h[HeaderDebeziumID]; ok {
+			h[HeaderID] = v
+		}
+	}
+	return h
+}
+
+func isDigits(b []byte) bool {
+	for _, c := range b {
+		if c < '0' || c > '9' {
+			return false
+		}
+	}
+	return len(b) > 0
+}
diff --git a/services-go/vtplatform/events/memory.go b/services-go/vtplatform/events/memory.go
new file mode 100644
index 0000000..796b80d
--- /dev/null
+++ b/services-go/vtplatform/events/memory.go
@@ -0,0 +1,57 @@
+package events
+
+import (
+	"context"
+	"fmt"
+	"sync"
+)
+
+// MemoryRegistry là Registry trong bộ nhớ cho kiểm thử đơn vị và chạy cục bộ không có Apicurio;
+// không dùng ở môi trường thật.
+type MemoryRegistry struct {
+	mu      sync.Mutex
+	next    int64
+	byKey   map[string]SchemaRef
+	byID    map[int64]string
+	version map[string]int
+}
+
+// Register đăng ký một lược đồ cho artifact và trả tham chiếu (đăng ký lại cùng nội dung trả tham
+// chiếu cũ).
+func (m *MemoryRegistry) Register(artifactID, schema string) SchemaRef {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.byKey == nil {
+		m.byKey, m.byID, m.version = map[string]SchemaRef{}, map[int64]string{}, map[string]int{}
+	}
+	key := artifactID + "\x00" + schema
+	if ref, ok := m.byKey[key]; ok {
+		return ref
+	}
+	m.next++
+	m.version[artifactID]++
+	ref := SchemaRef{GlobalID: m.next, Version: m.version[artifactID]}
+	m.byKey[key] = ref
+	m.byID[ref.GlobalID] = schema
+	return ref
+}
+
+// Resolve thực hiện Registry.Resolve (so khớp nguyên văn nội dung).
+func (m *MemoryRegistry) Resolve(_ context.Context, artifactID, schema string) (SchemaRef, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if ref, ok := m.byKey[artifactID+"\x00"+schema]; ok {
+		return ref, nil
+	}
+	return SchemaRef{}, fmt.Errorf("%w: %s", ErrSchemaNotRegistered, artifactID)
+}
+
+// SchemaByGlobalID thực hiện Registry.SchemaByGlobalID.
+func (m *MemoryRegistry) SchemaByGlobalID(_ context.Context, id int64) (string, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if s, ok := m.byID[id]; ok {
+		return s, nil
+	}
+	return "", fmt.Errorf("%w: globalId %d", ErrSchemaNotRegistered, id)
+}
diff --git a/services-go/vtplatform/events/registry.go b/services-go/vtplatform/events/registry.go
new file mode 100644
index 0000000..b2fed88
--- /dev/null
+++ b/services-go/vtplatform/events/registry.go
@@ -0,0 +1,171 @@
+package events
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"net/url"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+)
+
+// SchemaRef là tham chiếu lược đồ đã đăng ký.
+type SchemaRef struct {
+	GlobalID int64 // global id của phiên bản artifact
+	Version  int   // số phiên bản artifact, ghi vào outbox_event.schema_version
+}
+
+// Registry tra lược đồ Avro trong registry.
+type Registry interface {
+	// Resolve tìm phiên bản của artifactID có nội dung trùng schema (so khớp chuẩn hoá); lỗi nếu
+	// lược đồ chưa đăng ký hoặc registry không phản hồi. Không tự đăng ký lược đồ mới: đăng ký là
+	// việc của pipeline hợp đồng (NEN-007, chế độ BACKWARD_TRANSITIVE).
+	Resolve(ctx context.Context, artifactID, schema string) (SchemaRef, error)
+	// SchemaByGlobalID trả nội dung lược đồ của một global id (lược đồ bên ghi).
+	SchemaByGlobalID(ctx context.Context, globalID int64) (string, error)
+}
+
+// ErrSchemaNotRegistered báo lược đồ cục bộ chưa có trong registry.
+var ErrSchemaNotRegistered = errors.New("lược đồ chưa đăng ký trong registry")
+
+// Apicurio là client Registry cho Apicurio Registry 3.x qua API lõi v3
+// (`/apis/registry/v3`): tra theo nội dung bằng `POST /search/versions?canonical=true` và đọc lược
+// đồ bằng `GET /ids/globalIds/{id}`. Kết quả tra được đệm trong bộ nhớ (lược đồ của một global id
+// không đổi). Lựa chọn API v3 thay vì API tương thích Confluent (ccompat) là suy luận: ccompat trả
+// contentId thay vì globalId khi không bật chế độ id cũ.
+type Apicurio struct {
+	// BaseURL là gốc API v3, ví dụ http://apicurio:8080/apis/registry/v3.
+	BaseURL string
+	// Group là nhóm artifact; rỗng dùng "default" (NEN-007).
+	Group string
+	// HTTP là client HTTP; nil dùng client có timeout 5 giây.
+	HTTP *http.Client
+
+	mu      sync.RWMutex
+	refs    map[string]SchemaRef
+	schemas map[int64]string
+}
+
+var defaultHTTP = &http.Client{Timeout: 5 * time.Second}
+
+func (a *Apicurio) client() *http.Client {
+	if a.HTTP != nil {
+		return a.HTTP
+	}
+	return defaultHTTP
+}
+
+func (a *Apicurio) group() string {
+	if a.Group == "" {
+		return "default"
+	}
+	return a.Group
+}
+
+// Resolve thực hiện Registry.Resolve.
+func (a *Apicurio) Resolve(ctx context.Context, artifactID, schema string) (SchemaRef, error) {
+	key := artifactID + "\x00" + schema
+	a.mu.RLock()
+	ref, ok := a.refs[key]
+	a.mu.RUnlock()
+	if ok {
+		return ref, nil
+	}
+	q := url.Values{}
+	q.Set("canonical", "true")
+	q.Set("artifactType", "AVRO")
+	q.Set("groupId", a.group())
+	q.Set("artifactId", artifactID)
+	q.Set("limit", "100")
+	u := strings.TrimRight(a.BaseURL, "/") + "/search/versions?" + q.Encode()
+	req, err := http.NewRequestWithContext(ctx, http.MethodPost, u, bytes.NewBufferString(schema))
+	if err != nil {
+		return SchemaRef{}, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Accept", "application/json")
+	resp, err := a.client().Do(req)
+	if err != nil {
+		return SchemaRef{}, fmt.Errorf("registry không phản hồi: %w", err)
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if resp.StatusCode != http.StatusOK {
+		return SchemaRef{}, fmt.Errorf("registry trả %d khi tra %s", resp.StatusCode, artifactID)
+	}
+	var res struct {
+		Versions []struct {
+			GlobalID int64  `json:"globalId"`
+			Version  string `json:"version"`
+			State    string `json:"state"`
+		} `json:"versions"`
+	}
+	if err := json.Unmarshal(body, &res); err != nil {
+		return SchemaRef{}, fmt.Errorf("phản hồi registry sai dạng: %w", err)
+	}
+	found := false
+	for _, v := range res.Versions {
+		if v.State == "DISABLED" {
+			continue
+		}
+		n, err := strconv.Atoi(v.Version)
+		if err != nil {
+			continue
+		}
+		if !found || v.GlobalID > ref.GlobalID {
+			ref = SchemaRef{GlobalID: v.GlobalID, Version: n}
+			found = true
+		}
+	}
+	if !found {
+		return SchemaRef{}, fmt.Errorf("%w: %s", ErrSchemaNotRegistered, artifactID)
+	}
+	a.mu.Lock()
+	if a.refs == nil {
+		a.refs = map[string]SchemaRef{}
+	}
+	a.refs[key] = ref
+	a.mu.Unlock()
+	return ref, nil
+}
+
+// SchemaByGlobalID thực hiện Registry.SchemaByGlobalID.
+func (a *Apicurio) SchemaByGlobalID(ctx context.Context, globalID int64) (string, error) {
+	a.mu.RLock()
+	s, ok := a.schemas[globalID]
+	a.mu.RUnlock()
+	if ok {
+		return s, nil
+	}
+	u := strings.TrimRight(a.BaseURL, "/") + "/ids/globalIds/" + strconv.FormatInt(globalID, 10)
+	req, err := http.NewRequestWithContext(ctx, http.MethodGet, u, nil)
+	if err != nil {
+		return "", err
+	}
+	resp, err := a.client().Do(req)
+	if err != nil {
+		return "", fmt.Errorf("registry không phản hồi: %w", err)
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if resp.StatusCode == http.StatusNotFound {
+		return "", fmt.Errorf("%w: globalId %d", ErrSchemaNotRegistered, globalID)
+	}
+	if resp.StatusCode != http.StatusOK {
+		return "", fmt.Errorf("registry trả %d khi đọc globalId %d", resp.StatusCode, globalID)
+	}
+	s = string(body)
+	a.mu.Lock()
+	if a.schemas == nil {
+		a.schemas = map[int64]string{}
+	}
+	a.schemas[globalID] = s
+	a.mu.Unlock()
+	return s, nil
+}
