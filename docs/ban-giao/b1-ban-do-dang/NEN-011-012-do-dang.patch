@@ -0,0 +1,46 @@
+package vn.viettel.okrkpi.shared.outbox;
+
+/**
+ * Tên khoá trong cột {@code headers} (jsonb) của {@code outbox_event}; {@code
+ * OutboxHeadersTransform} chuyển từng khoá thành một tiêu đề Kafka cùng tên. Tên viết thường theo
+ * quy ước thuộc tính mở rộng CloudEvents ở {@code contracts/events/README.md} (TL-01 "Phong bì sự
+ * kiện"); {@link #CE_TYPE} và {@link #APICURIO_GLOBAL_ID} theo cấu hình connector mẫu của TL-03.
+ * Consumer NEN-012 đọc các tiêu đề này.
+ */
+public final class OutboxHeaders {
+
+  /** W3C Trace Context của giao dịch phát sự kiện. */
+  public static final String TRACEPARENT = "traceparent";
+
+  /** Người thực hiện. */
+  public static final String ACTOR_ID = "actorid";
+
+  /** Tenant. */
+  public static final String TENANT_ID = "tenantid";
+
+  /** Phân loại cao nhất của dữ liệu trong sự kiện (C0, C1). */
+  public static final String CLASSIFICATION = "classification";
+
+  /** Phiên bản Policy Pack, chỉ có khi sự kiện gắn với một Policy Pack. */
+  public static final String POLICY_VERSION = "policyversion";
+
+  /** {@code aggregate_version} dạng chuỗi số thập phân. */
+  public static final String AGGREGATE_VERSION = "aggregateversion";
+
+  /** Tên nghiệp vụ của sự kiện (cột {@code event_type}), như {@code event_type:header:ce_type}. */
+  public static final String CE_TYPE = "ce_type";
+
+  /** Thời điểm xảy ra, ISO-8601 UTC (TL-03 cột {@code headers}: {@code occurredAt}). */
+  public static final String OCCURRED_AT = "occurredat";
+
+  /**
+   * Global id lược đồ Apicurio; trong jsonb là số, trên Kafka là 8 byte big-endian đúng định dạng
+   * mà {@code DefaultHeadersHandler} của serde Apicurio đọc.
+   */
+  public static final String APICURIO_GLOBAL_ID = "apicurio.value.globalId";
+
+  /** Tiêu đề mã sự kiện do Debezium EventRouter đặt từ cột {@code id}. */
+  public static final String EVENT_ID = "id";
+
+  private OutboxHeaders() {}
+}
diff --git a/backend/libs/vt-platform-starter/src/main/java/vn/viettel/okrkpi/shared/outbox/OutboxPayloadSerializer.java b/backend/libs/vt-platform-starter/src/main/java/vn/viettel/okrkpi/shared/outbox/OutboxPayloadSerializer.java
new file mode 100644
index 0000000..b586cf4
--- /dev/null
+++ b/backend/libs/vt-platform-starter/src/main/java/vn/viettel/okrkpi/shared/outbox/OutboxPayloadSerializer.java
@@ -0,0 +1,65 @@
+package vn.viettel.okrkpi.shared.outbox;
+
+import java.util.Objects;
+import org.apache.avro.specific.SpecificRecord;
+
+/**
+ * Tuần tự hoá thân sự kiện sang Avro nhị phân theo lược đồ đã đăng ký (TL-03 "Transactional Outbox
+ * và Debezium"). Hiện thực chuẩn là {@link ApicurioPayloadSerializer}; kiểm thử đơn vị có thể thay
+ * bằng bản giả.
+ */
+@FunctionalInterface
+public interface OutboxPayloadSerializer {
+
+  /**
+   * Tra lược đồ của {@code payload} trong registry theo topic rồi tuần tự hoá.
+   *
+   * @throws OutboxSerializationException khi registry không phản hồi, lược đồ chưa đăng ký hoặc
+   *     không tuần tự hoá được; giao dịch nghiệp vụ phải thất bại theo
+   */
+  SerializedPayload serialize(String topic, SpecificRecord payload);
+
+  /**
+   * Thân đã tuần tự hoá.
+   *
+   * @param bytes Avro nhị phân, không có tiền tố mã lược đồ (mã lược đồ nằm ở tiêu đề)
+   * @param globalId global id của phiên bản lược đồ trong Apicurio
+   * @param schemaVersion số phiên bản lược đồ trong artifact (cột {@code schema_version})
+   */
+  record SerializedPayload(byte[] bytes, long globalId, int schemaVersion) {
+
+    public SerializedPayload {
+      Objects.requireNonNull(bytes, "bytes");
+      bytes = bytes.clone();
+    }
+
+    @Override
+    public byte[] bytes() {
+      return bytes.clone();
+    }
+
+    @Override
+    public boolean equals(Object o) {
+      return o instanceof SerializedPayload other
+          && java.util.Arrays.equals(bytes, other.bytes)
+          && globalId == other.globalId
+          && schemaVersion == other.schemaVersion;
+    }
+
+    @Override
+    public int hashCode() {
+      return 31 * (31 * java.util.Arrays.hashCode(bytes) + Long.hashCode(globalId)) + schemaVersion;
+    }
+
+    @Override
+    public String toString() {
+      return "SerializedPayload[bytes="
+          + bytes.length
+          + "B, globalId="
+          + globalId
+          + ", schemaVersion="
+          + schemaVersion
+          + "]";
+    }
+  }
+}
