diff --git a/backend/libs/vt-platform-starter/src/main/java/vn/viettel/okrkpi/shared/job/JobQueryService.java b/backend/libs/vt-platform-starter/src/main/java/vn/viettel/okrkpi/shared/job/JobQueryService.java
new file mode 100644
