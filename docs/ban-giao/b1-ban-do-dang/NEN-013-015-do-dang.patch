+package vn.viettel.okrkpi.shared.job;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.time.OffsetDateTime;
+import java.util.List;
+import java.util.Optional;
+import java.util.UUID;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.ResponseEntity;
+import vn.viettel.okrkpi.shared.error.BusinessException;
+import vn.viettel.okrkpi.shared.kernel.ActorId;
+import vn.viettel.okrkpi.shared.kernel.TenantId;
+
+class JobQueryServiceTest {
+
+  private static final TenantId TENANT = TenantId.of(UUID.randomUUID());
+  private static final ActorId OWNER = ActorId.of(UUID.randomUUID());
+  private static final ActorId OTHER = ActorId.of(UUID.randomUUID());
+  private static final OffsetDateTime AT = OffsetDateTime.parse("2026-12-31T17:05:00+07:00");
+
+  private static JobSource source(String id, JobStatus status, boolean cancellable, boolean stops) {
+    return new JobSource() {
+      @Override
+      public String name() {
+        return "thu." + id;
+      }
+
+      @Override
+      public Optional<TrackedJob> find(TenantId tenant, String jobId) {
+        if (!jobId.equals(id)) {
+          return Optional.empty();
+        }
+        return Optional.of(
+            new TrackedJob(
+                new Job(id, "PERIOD_LOCK", status, 45, "Đang chốt", null, null, AT),
+                OWNER,
+                cancellable));
+      }
+
+      @Override
+      public boolean requestCancel(TenantId tenant, String jobId) {
+        return stops;
+      }
+    };
+  }
+
+  private final JobQueryService service =
+      new JobQueryService(
+          List.of(
+              source("a", JobStatus.DANG_CHAY, true, true),
+              source("b", JobStatus.HOAN_TAT, true, true),
+              source("c", JobStatus.DANG_CHAY, false, true),
+              source("d", JobStatus.CHO, true, false),
+              new JobSource() {
+                @Override
+                public String name() {
+                  return "mac-dinh";
+                }
+
+                @Override
+                public Optional<TrackedJob> find(TenantId tenant, String jobId) {
+                  return jobId.equals("e")
+                      ? Optional.of(new TrackedJob(Job.accepted("e", "EXPORT", AT), OWNER, true))
+                      : Optional.empty();
+                }
+              }));
+
+  @Test
+  void chiNguoiKhoiTaoXemDuoc() {
+    assertThat(service.get(TENANT, OWNER, "a").progress()).isEqualTo(45);
+    assertThat(service.find(TENANT, OTHER, "a")).isEmpty();
+    assertThatThrownBy(() -> service.get(TENANT, OTHER, "a"))
+        .isInstanceOf(JobNotFoundException.class);
+    assertThatThrownBy(() -> service.get(TENANT, OWNER, "khong-co"))
+        .isInstanceOf(JobNotFoundException.class);
+    assertThat(service.find(TENANT, OWNER, " ")).isEmpty();
+    assertThat(service.find(TENANT, OWNER, null)).isEmpty();
+  }
+
+  @Test
+  void huyTacVu() {
+    assertThat(service.cancel(TENANT, OWNER, "a").id()).isEqualTo("a");
+    for (String id : List.of("b", "c", "d", "e")) {
+      assertThatThrownBy(() -> service.cancel(TENANT, OWNER, id))
+          .as(id)
+          .isInstanceOfSatisfying(
+              BusinessException.class,
+              e -> assertThat(e.errorCode().code()).isEqualTo("JOB-409-NOT-CANCELLABLE"));
+    }
+    assertThatThrownBy(() -> service.cancel(TENANT, OTHER, "a"))
+        .isInstanceOf(JobNotFoundException.class);
+  }
+
+  @Test
+  void phanHoi202VaTrangThai() {
+    Job job = Job.accepted("01928f3e-7b1a-7c3e-9a51-3f2d9c1b0a77", "EXPORT", AT);
+    ResponseEntity<Job> r = Jobs.accepted(job);
+    assertThat(r.getStatusCode().value()).isEqualTo(202);
+    assertThat(r.getHeaders().getLocation())
+        .hasToString("/api/v1/jobs/01928f3e-7b1a-7c3e-9a51-3f2d9c1b0a77");
+    assertThat(r.getHeaders().getFirst("Retry-After")).isEqualTo("2");
+    assertThat(Jobs.accepted(job, -5).getHeaders().getFirst("Retry-After")).isEqualTo("0");
+    assertThat(Jobs.location("a b/c")).hasToString("/api/v1/jobs/a%20b%2Fc");
+    assertThat(Jobs.status(job).getHeaders().getFirst("Retry-After")).isEqualTo("2");
+    Job done = new Job("x", "EXPORT", JobStatus.HOAN_TAT, 100, null, "/api/v1/files/1", null, AT);
+    assertThat(Jobs.status(done).getHeaders().containsKey("Retry-After")).isFalse();
+    assertThat(JobStatus.THAT_BAI.isTerminal()).isTrue();
+    assertThat(JobStatus.CHO.isTerminal()).isFalse();
+  }
+
+  @Test
+  void jobHopLe() {
+    assertThatThrownBy(() -> new Job(" ", "EXPORT", JobStatus.CHO, 0, null, null, null, AT))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> new Job("a", "EXPORT", JobStatus.CHO, 101, null, null, null, AT))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> new Job("a", "EXPORT", JobStatus.CHO, -1, null, null, null, AT))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThat(new Job("a", "EXPORT", JobStatus.CHO, null, null, null, null, null).progress())
+        .isNull();
+  }
+}
diff --git a/backend/libs/vt-platform-starter/src/test/java/vn/viettel/okrkpi/shared/paging/CursorCodecTest.java b/backend/libs/vt-platform-starter/src/test/java/vn/viettel/okrkpi/shared/paging/CursorCodecTest.java
new file mode 100644
index 0000000..c314521
--- /dev/null
+++ b/backend/libs/vt-platform-starter/src/test/java/vn/viettel/okrkpi/shared/paging/CursorCodecTest.java
@@ -0,0 +1,139 @@
+package vn.viettel.okrkpi.shared.paging;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.time.Instant;
+import java.time.LocalDate;
+import java.util.ArrayList;
+import java.util.Base64;
+import java.util.List;
+import java.util.UUID;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.stream.IntStream;
+import org.junit.jupiter.api.Test;
+import vn.viettel.okrkpi.shared.kernel.Clock;
+
+class CursorCodecTest {
+
+  private static final byte[] KEY =
+      "khoa-ky-con-tro-thu-nghiem-32-byte!!".getBytes(StandardCharsets.UTF_8);
+  private final AtomicReference<Instant> now =
+      new AtomicReference<>(Instant.parse("2026-10-20T01:00:00Z"));
+  private final Clock clock = () -> now.get();
+  private final CursorCodec codec = new CursorCodec(KEY, Duration.ofHours(24), clock);
+
+  @Test
+  void maHoaRoiDocLaiKeyset() {
+    UUID id = UUID.randomUUID();
+    Instant at = Instant.parse("2026-10-19T08:30:00.123456Z");
+    String cursor =
+        codec.encode("ds", CursorKey.of(at, id, 7L, "Quý IV", LocalDate.of(2026, 12, 31)));
+    assertThat(cursor).matches("[A-Za-z0-9_-]+").hasSizeLessThanOrEqualTo(CursorCodec.MAX_LENGTH);
+    CursorKey k = codec.decode("ds", cursor);
+    assertThat(k.size()).isEqualTo(5);
+    assertThat(k.getInstant(0)).isEqualTo(at);
+    assertThat(k.getUuid(1)).isEqualTo(id);
+    assertThat(k.getLong(2)).isEqualTo(7);
+    assertThat(k.getString(3)).isEqualTo("Quý IV");
+    assertThat(k.getDate(4)).isEqualTo(LocalDate.of(2026, 12, 31));
+    assertThat(k).isEqualTo(CursorKey.of(at, id, 7L, "Quý IV", LocalDate.of(2026, 12, 31)));
+    assertThat(k.hashCode())
+        .isEqualTo(CursorKey.of(at, id, 7L, "Quý IV", LocalDate.of(2026, 12, 31)).hashCode());
+    assertThat(k.toString()).startsWith("CursorKey[");
+  }
+
+  @Test
+  void conTroBiSuaSaiPhamViHetHanDeuBiTuChoi() {
+    String cursor = codec.encode("ds-a", CursorKey.of("x", 1));
+    byte[] raw = Base64.getUrlDecoder().decode(cursor);
+    raw[3] ^= 1;
+    String tampered = Base64.getUrlEncoder().withoutPadding().encodeToString(raw);
+    assertInvalid("ds-a", tampered);
+    assertInvalid("ds-b", cursor);
+    assertInvalid("ds-a", "!!!");
+    assertInvalid("ds-a", "");
+    assertInvalid("ds-a", "AAAA");
+    assertInvalid("ds-a", "A".repeat(513));
+    // Con trỏ do client tự dựng (không có MAC đúng).
+    String forged =
+        Base64.getUrlEncoder()
+            .withoutPadding()
+            .encodeToString(
+                ("{\"v\":1,\"t\":1792459200,\"k\":[\"x\"]}" + "0123456789abcdef")
+                    .getBytes(StandardCharsets.UTF_8));
+    assertInvalid("ds-a", forged);
+
+    now.set(now.get().plus(Duration.ofHours(25)));
+    assertInvalid("ds-a", cursor);
+    // Phát hành ở "tương lai" quá độ lệch đồng hồ cho phép.
+    CursorCodec future =
+        new CursorCodec(KEY, Duration.ofHours(24), () -> now.get().plus(Duration.ofMinutes(5)));
+    assertInvalid("ds-a", future.encode("ds-a", CursorKey.of("x")));
+  }
+
+  @Test
+  void kiemLimitMacDinh20ToiDa200() {
+    assertThat(codec.pageRequest(null, null, "ds").limit()).isEqualTo(20);
+    assertThat(codec.pageRequest(200, "", "ds").firstPage()).isTrue();
+    assertThat(codec.pageRequest(1, null, "ds").fetchSize()).isEqualTo(2);
+    for (int bad : new int[] {0, -1, 201}) {
+      assertThatThrownBy(() -> codec.pageRequest(bad, null, "ds"))
+          .isInstanceOfSatisfying(
+              InvalidPageRequestException.class,
+              e -> {
+                assertThat(e.parameter()).isEqualTo("limit");
+                assertThat(e.userMessage()).contains("1 đến 200");
+              });
+    }
+    assertThatThrownBy(() -> new PageRequest(0, null, "ds"))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+
+  @Test
+  void dungTrangTuLimitCongMot() {
+    List<Integer> rows = new ArrayList<>(IntStream.rangeClosed(1, 450).boxed().toList());
+    List<Integer> all = new ArrayList<>();
+    PageRequest req = codec.pageRequest(200, null, "so");
+    int pages = 0;
+    while (true) {
+      int from = req.firstPage() ? 0 : (int) req.after().getLong(0);
+      List<Integer> fetched = rows.subList(from, Math.min(rows.size(), from + req.fetchSize()));
+      CursorPage<Integer> page = codec.page(fetched, req, r -> CursorKey.of(r));
+      pages++;
+      all.addAll(page.items());
+      if (!page.hasNext()) {
+        break;
+      }
+      req = codec.pageRequest(200, page.nextCursor(), "so");
+      assertThat(req.afterKey()).isPresent();
+    }
+    assertThat(pages).isEqualTo(3);
+    assertThat(all).isEqualTo(rows);
+    assertThat(CursorPage.last(List.of(1)).nextCursor()).isNull();
+  }
+
+  @Test
+  void dauVaoSai() {
+    assertThatThrownBy(() -> new CursorCodec(new byte[31], Duration.ofHours(1), clock))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> new CursorCodec(KEY, Duration.ZERO, clock))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(CursorKey::of).isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> CursorKey.of(new Object()))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThatThrownBy(() -> CursorKey.of((Object) null))
+        .isInstanceOf(IllegalArgumentException.class);
+    assertThat(CursorKey.of(Thread.State.NEW, true).getString(0)).isEqualTo("NEW");
+    assertThatThrownBy(() -> codec.encode("ds", CursorKey.of("x".repeat(600))))
+        .isInstanceOf(IllegalArgumentException.class);
+  }
+
+  private void assertInvalid(String scope, String cursor) {
+    assertThatThrownBy(() -> codec.decode(scope, cursor))
+        .isInstanceOfSatisfying(
+            InvalidPageRequestException.class, e -> assertThat(e.parameter()).isEqualTo("cursor"));
+  }
+}
