# Thông tin kết nối máy chủ dev Mission. Chép tệp này thành cau-hinh.env (cùng thư mục với mo-web.sh) rồi điền.
# Không gửi tệp cau-hinh.env đã điền qua kênh công khai.
DEV_SERVER_HOST=
DEV_SERVER_SSH_PORT=2222
DEV_SERVER_USER=provision
# Cách đăng nhập SSH, chọn một:
# 1) Khoá SSH (khuyến nghị): đường dẫn tệp khoá riêng, ví dụ /Users/ten/.ssh/id_ed25519
DEV_SERVER_SSH_KEY=
# 2) Mật khẩu: cần cài sshpass (macOS: brew install sshpass; Ubuntu: sudo apt install sshpass)
DEV_SERVER_PASSWORD=
