{
  "ci": {
    "collect": {
      "staticDistDir": "./lhci",
      "isSinglePageApplication": true,
      "url": ["http://localhost/", "http://localhost/tasks", "http://localhost/khong-co-quyen"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "throttlingMethod": "simulate",
        "throttling": {
          "rttMs": 150,
          "throughputKbps": 1638.4,
          "requestLatencyMs": 562.5,
          "downloadThroughputKbps": 1474.56,
          "uploadThroughputKbps": 675,
          "cpuSlowdownMultiplier": 4
        },
        "onlyCategories": ["performance", "accessibility"],
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              { "maxNumericValue": 2500, "aggregationMethod": "median-run" }
            ],
            "cumulative-layout-shift": [
              "error",
              { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }
            ],
            "categories:accessibility": [
              "error",
              { "minScore": 0.95, "aggregationMethod": "median-run" }
            ]
          }
        },
        {
          "matchingUrlPattern": "/khong-co-quyen$",
          "assertions": {
            "resource-summary:total:size": [
              "error",
              { "maxNumericValue": 256000, "aggregationMethod": "median-run" }
            ]
          }
        },
        {
          "matchingUrlPattern": "^http://[^/]+/(tasks)?$",
          "assertions": {
            "resource-summary:total:size": [
              "warn",
              { "maxNumericValue": 471040, "aggregationMethod": "median-run" }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lhci-report"
    }
  }
}
