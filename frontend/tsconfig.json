{
  "compileOnSave": false,
  "compilerOptions": {
    "paths": {
      "@vt/design-system": [
        "./projects/design-system/src/public-api.ts"
      ],
      "@vt/auth": [
        "./projects/auth/src/public-api.ts"
      ],
      "@vt/sdui-renderer": [
        "./projects/sdui-renderer/src/public-api.ts"
      ],
      "@vt/form-engine": [
