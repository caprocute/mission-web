{
  "$schema": "https://schemas.okr.viettel.vn/ui-pack/1.0.json",
  "pack": "mau-loi/ui",
  "version": "1.0.0",
  "requires": {
    "registry": "^2.4.0"
  },
  "tokens": {
    "color": {
      "primary": {
        "$type": "color",
        "$value": "#EE0033"
      },
      "primaryStrong": {
        "$type": "color",
        "$value": "#EE0033"
      },
      "onPrimaryStrong": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "background": {
        "$type": "color",
        "$value": "#F5F6F8"
      },
      "text": {
        "$type": "color",
        "$value": "#1F2329"
      },
      "textMuted": {
        "$type": "color",
        "$value": "#9AA3AF"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": [
          "Be Vietnam Pro",
          "Roboto",
          "sans-serif"
        ]
      },
      "size": {
        "body": {
          "$type": "dimension",
          "$value": "14px"
        }
      }
    },
    "radius": {
      "card": {
        "$type": "dimension",
        "$value": "8px"
      }
    },
    "brand": {
      "logo": {
        "$type": "asset",
        "$value": "logo.svg"
      }
    }
  },
  "modes": {
    "elderly": {
      "font": {
        "size": {
          "body": {
            "$value": "18px"
          }
        }
      },
      "color": {
        "text": {
          "$value": "#000000"
        }
      },
      "flags": {
        "reducedSteps": true,
        "minTouchTarget": "48px"
      }
    }
  },
  "layouts": {
    "home": {
      "component": "vt.layout.grid",
      "props": {
        "columns": {
          "xs": 1,
          "md": 2,
          "xl": 3
        }
      },
      "children": [
        {
          "component": "vt.widget.announcement",
          "props": {
            "i18nKey": "home.notice.q4"
          }
        },
        {
          "component": "vt.widget.myTasksToday",
          "props": {
            "limit": 7
          }
        },
        {
          "component": "vt.widget.okrProgress",
          "props": {
            "scope": "unit"
          },
          "visibleWhen": "user.roles.exists(r, r in ['leader', 'manager'])"
        },
        {
          "component": "vt.widget.pendingApprovals",
          "visibleWhen": "'manager' in user.roles"
        }
      ]
    }
  },
  "plugins": [],
  "i18n": {
    "vi": {
      "home.notice.q4": "Hạn nộp hồ sơ đánh giá quý IV là ngày 10/01/2027."
    }
  }
}
