{
  "name": "mission-web-frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint .",
    "format": "prettier --write \"projects/**/*.{ts,html,scss,css,json}\" \"*.{js,json}\"",
    "format:check": "prettier --check \"projects/**/*.{ts,html,scss,css,json}\" \"*.{js,json}\"",
    "test:all": "node tools/remotes/workspace.mjs test",
    "prebuild:all": "node tools/skeleton/check.mjs",
    "build:all": "node tools/remotes/workspace.mjs build",
    "api:gen": "node tools/openapi/generate.mjs",
    "api:check": "node tools/openapi/generate.mjs --check",
    "pact": "vitest run --config pact/vitest.config.mts",
    "pact:check": "vitest run --config pact/vitest.config.mts --mode kiem",
    "perf:prepare": "npm run build:all && node tools/remotes/workspace.mjs assemble dist/lhci && node tools/perf/cau-hinh-do.mjs",
    "perf:lhci": "npm run perf:prepare && cd dist && lhci autorun --config=../lighthouserc.json",
    "perf:budget": "node tools/perf/ngan-sach.mjs",
    "check:ui-text": "node tools/ui-text/check.mjs",
    "check:skeleton": "node tools/skeleton/check.mjs",
    "check:permissions": "python3 ../docs/phan-quyen/gen_matrix.py --check",
    "e2e:prepare": "npm run build:all && node tools/remotes/workspace.mjs assemble dist/e2e",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "e2e:he-thong": "playwright test -c e2e/playwright.config.ts",
    "e2e:hanh-trinh": "playwright test -c e2e/playwright.config.ts",
    "storybook": "ng run vt-storybook:storybook",
    "build-storybook": "ng run vt-storybook:build-storybook",
    "test:visual": "npm run build-storybook && playwright test -c e2e/playwright.visual.config.ts"
  },
  "private": true,
  "packageManager": "npm@10.9.4",
  "dependencies": {
    "@angular/animations": "^21.2.0",
    "@angular/cdk": "^21.2.0",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/elements": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@grafana/faro-web-sdk": "^2.13.0",
    "@grafana/faro-web-tracing": "^2.13.0",
    "@marcbachmann/cel-js": "8.0.0",
    "@ngx-formly/core": "10.0.1",
    "@primeuix/themes": "^2.0.0",
    "@softarc/native-federation-node": "^3.3.4",
    "angular-oauth2-oidc": "^21.0.3",
    "cel-js": "^0.8.2",
    "d3-drag": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0",
    "es-module-shims": "^2.8.4",
    "ngx-vflow": "^2.7.0",
    "primeicons": "^7.0.0",
    "primeng": "21.1.10",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-architects/native-federation": "21.2.6",
    "@angular-devkit/build-angular": "^21.2.27",
    "@angular/build": "^21.2.27",
    "@angular/cli": "^21.2.27",
    "@angular/compiler-cli": "^21.2.0",
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "1.56.1",
    "@storybook/angular": "10.6.1",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-zoom": "^3.0.9",
    "@types/json-schema": "^7.0.15",
    "angular-eslint": "^21.4.0",
    "eslint": "^9.39.5",
    "jsdom": "^28.0.0",
    "ng-packagr": "^21.2.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.8.1",
    "storybook": "10.6.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.71.2",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "lodash-es": "4.18.1"
  }
}
