{
  "$schema": "https://schemas.okr.viettel.vn/ui-pack/1.0.json",
  "pack": "default/ui",
  "version": "1.0.0",
  "requires": {
    "registry": "^2.4.0"
  },
  "tokens": {
    "color": {
      "primary": {
        "$type": "color",
        "$value": "#EE0033"
      },
      "primaryStrong": {
        "$type": "color",
        "$value": "#D1002D"
      },
      "onPrimaryStrong": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "surface": {
        "$type": "color",
        "$value": "#FFFFFF"
      },
      "background": {
        "$type": "color",
        "$value": "#F5F6F8"
      },
      "text": {
        "$type": "color",
        "$value": "#1F2329"
      },
      "textMuted": {
        "$type": "color",
        "$value": "#566275"
      }
    },
    "font": {
      "family": {
        "$type": "fontFamily",
        "$value": [
          "Be Vietnam Pro",
          "Roboto",
          "sans-serif"
        ]
      },
      "size": {
        "body": {
          "$type": "dimension",
          "$value": "14px"
        }
      }
    },
    "radius": {
      "card": {
        "$type": "dimension",
        "$value": "8px"
      }
    },
    "brand": {
      "logo": {
        "$type": "asset",
        "$value": "logo.svg"
      }
    }
  },
  "modes": {
    "elderly": {
      "font": {
        "size": {
          "body": {
            "$value": "18px"
          }
        }
      },
      "color": {
        "text": {
          "$value": "#000000"
        },
        "textMuted": {
          "$value": "#3D4756"
        },
        "primaryStrong": {
          "$value": "#A30023"
        }
      },
      "flags": {
        "reducedSteps": true,
        "minTouchTarget": "48px"
      }
    }
  },
  "layouts": {
    "home": {
      "component": "vt.layout.grid",
      "props": {
        "columns": {
          "xs": 1,
          "md": 2,
          "xl": 3
        }
      },
      "children": [
        {
          "component": "vt.widget.announcement",
          "props": {
            "i18nKey": "home.notice.q4"
          }
        },
        {
          "component": "vt.widget.myTasksToday",
          "props": {
            "limit": 7
          }
        },
        {
          "component": "vt.widget.okrProgress",
          "props": {
            "scope": "unit"
          },
          "visibleWhen": "user.roles.exists(r, r in ['leader', 'manager'])"
        },
        {
          "component": "vt.widget.pendingApprovals",
          "visibleWhen": "'manager' in user.roles"
        }
      ]
    }
  },
  "plugins": [],
  "i18n": {
    "vi": {
      "home.notice.q4": "Hạn nộp hồ sơ đánh giá quý IV là ngày 10/01/2027."
    }
  },
  "compiledCss": ":root[data-tenant]{--vt-color-primary:#EE0033;--vt-color-primary-strong:#D1002D;--vt-color-on-primary-strong:#FFFFFF;--vt-color-surface:#FFFFFF;--vt-color-background:#F5F6F8;--vt-color-text:#1F2329;--vt-color-text-muted:#566275;--vt-font-family:\"Be Vietnam Pro\", Roboto, sans-serif;--vt-font-size-body:14px;--vt-radius-card:8px}\n:root[data-tenant][data-mode=\"elderly\"]{--vt-font-size-body:18px;--vt-color-text:#000000;--vt-color-text-muted:#3D4756;--vt-color-primary-strong:#A30023}"
}
