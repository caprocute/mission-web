{
  "suite": "okr-rules",
  "version": "1.0.0",
  "description": "Bộ ca dùng chung cho bộ kiểm tra quy tắc OKR BR-02-01..07 của máy chủ (cel-java, CORE-01-04) và trình duyệt (cel-js, fe-okr/okr-rules.ts). Ca phạm vi mục tiêu cho sẵn biến o.*; ca phạm vi KR cho dữ liệu KR thô, hai bên tự tính biến kr.* rồi phải ra cùng expectedVars và cùng danh sách quy tắc vi phạm. Ca serverOnly bên trình duyệt bỏ qua.",
  "policy": {
    "recommendedMax": 3,
    "vagueWords": [
      "tăng cường",
      "đẩy mạnh",
      "kịp thời",
      "nâng cao",
      "chú trọng",
      "quan tâm"
    ],
    "taskVerbs": [
      "tổ chức",
      "ban hành",
      "xây dựng",
      "triển khai",
      "họp",
      "tập huấn"
    ],
    "units": [
      "%",
      "người",
      "hồ sơ",
      "ngày",
      "lần",
      "mốc",
      "chi bộ",
      "tổ chức"
    ]
  },
  "rules": [
    {
      "id": "O-TEN",
      "br": "SCR-0202",
      "scope": "objective",
      "severity": "CHAN",
      "when": "true",
      "assert": "o.titleLength > 0 && o.titleLength <= 200",
      "message": "Tên mục tiêu không được trống và tối đa 200 ký tự.",
      "passLabel": null,
      "serverOnly": false
    },
    {
      "id": "BR-02-02-CC",
      "br": "BR-02-02",
      "scope": "objective",
      "severity": "CHAN",
      "when": "true",
      "assert": "o.basisCount >= 1",
      "message": "Mục tiêu phải có ít nhất một căn cứ.",
      "passLabel": "Có căn cứ",
      "serverOnly": false
    },
    {
      "id": "BR-02-02-CT",
      "br": "BR-02-02",
      "scope": "objective",
      "severity": "CHAN",
      "when": "!o.isTopLevel",
      "assert": "o.hasParent",
      "message": "Mục tiêu phải liên kết mục tiêu cấp trên.",
      "passLabel": "Có mục tiêu cấp trên",
      "serverOnly": false
    },
    {
      "id": "MSG-02-03",
      "br": "BR-02-02",
      "scope": "objective",
      "severity": "CHAN",
      "when": "o.hasParent",
      "assert": "o.parentApproved",
      "message": "Mục tiêu cấp trên {parentCode} chưa được duyệt. Đồng chí có thể soạn nhưng chưa trình được.",
      "passLabel": null,
      "serverOnly": false
    },
    {
      "id": "BR-02-01",
      "br": "BR-02-01",
      "scope": "objective",
      "severity": "CANH_BAO",
      "when": "true",
      "assert": "o.totalObjectives <= o.recommendedMax",
      "message": "{totalObjectives} mục tiêu trong kỳ, vượt khuyến nghị {recommendedMax}.",
      "passLabel": null,
      "serverOnly": false
    },
    {
      "id": "BR-02-01-LD",
      "br": "BR-02-01",
      "scope": "objective",
      "severity": "CHAN",
      "when": "o.totalObjectives > o.recommendedMax",
      "assert": "o.overLimitReasonLength > 0",
      "message": "Vui lòng ghi lý do vượt {recommendedMax} mục tiêu.",
      "passLabel": null,
      "serverOnly": false
    },
    {
      "id": "BR-02-03",
      "br": "BR-02-03",
      "scope": "objective",
      "severity": "CANH_BAO",
      "when": "true",
      "assert": "o.krCount >= 2 && o.krCount <= 5",
      "message": "Mục tiêu nên có từ 2 đến 5 KR (hiện có {krCount}).",
      "passLabel": null,
      "serverOnly": false
    },
    {
      "id": "BR-02-07",
      "br": "BR-02-07",
      "scope": "objective",
      "severity": "CHAN",
      "when": "true",
      "assert": "o.totalWeight == 100",
      "message": "Tổng trọng số KR là {totalWeight}%, cần bằng 100%.",
      "passLabel": "Tổng trọng số KR = 100%",
      "serverOnly": false
    },
    {
      "id": "KR-ND",
      "br": "SCR-0202",
      "scope": "kr",
      "severity": "CHAN",
      "when": "true",
      "assert": "kr.titleLength > 0 && kr.titleLength <= 300",
      "message": "{code} cần nội dung, tối đa 300 ký tự.",
      "passLabel": null,
      "serverOnly": false
    },
    {
      "id": "BR-02-05",
      "br": "BR-02-05",
      "scope": "kr",
      "severity": "CHAN",
      "when": "kr.vagueWord != \"\"",
      "assert": "kr.hasTarget && kr.unit != \"\"",
      "message": "KPI mơ hồ: \"{vagueWord}\" không đo được. Vui lòng bổ sung chỉ tiêu và đơn vị đo.",
      "passLabel": null,
      "serverOnly": false
    },
    {
      "id": "BR-02-04",
      "br": "BR-02-04",
      "scope": "kr",
      "severity": "CHAN",
      "when": "true",
      "assert": "kr.missing == \"\"",
      "message": "{code} thiếu {missing}.",
      "passLabel": "Mọi KR có đơn vị đo, giá trị đầu, chỉ tiêu, hạn, người xác nhận",
      "serverOnly": false
    },
    {
      "id": "KR-CT",
      "br": "SCR-0202",
      "scope": "kr",
      "severity": "CHAN",
      "when": "kr.hasTarget && kr.hasBaseline",
      "assert": "kr.targetDiffers",
      "message": "{code}: chỉ tiêu phải khác giá trị đầu.",
      "passLabel": null,
      "serverOnly": false
    },
    {
      "id": "BR-02-06",
      "br": "BR-02-06",
      "scope": "kr",
      "severity": "CANH_BAO",
      "when": "true",
      "assert": "kr.taskVerb == \"\"",
      "message": "{code} giống một nhiệm vụ, không phải kết quả đo được. Cân nhắc chuyển sang Kế hoạch quý.",
      "passLabel": null,
      "serverOnly": false
    },
    {
      "id": "KR-XN",
      "br": "SCR-0202",
      "scope": "kr",
      "severity": "CHAN",
      "when": "kr.hasVerifier",
      "assert": "kr.verifierDiffers",
      "message": "Người xác nhận phải khác chủ sở hữu KR.",
      "passLabel": null,
      "serverOnly": true
    }
  ],
