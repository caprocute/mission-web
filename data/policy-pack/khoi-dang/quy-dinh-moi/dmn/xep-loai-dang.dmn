<?xml version="1.0" encoding="UTF-8"?>
<!-- BẢN NHÁP chờ nghiệp vụ duyệt. BR-09-05..BR-09-10; dòng 1-3 loại trừ, dòng 4 HTXSNV, dòng 5 HTTNV, dòng 6 HTNV (TL-02b); table_key xep_loai -->
<definitions xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/" id="xep-loai-dang-dinh-nghia" name="Xếp loại chất lượng quý, luồng Đảng"
             namespace="https://policy.okrkpi.vn/khoi-dang/quy-dinh-moi" expressionLanguage="https://www.omg.org/spec/DMN/20211108/FEEL/" typeLanguage="https://www.omg.org/spec/DMN/20211108/FEEL/">
  <decision id="xep-loai-dang" name="Xếp loại chất lượng, luồng Đảng">
    <variable id="xep-loai-dang-var" name="xep_loai" typeRef="string"/>
    <decisionTable id="xep-loai-dang-bang" hitPolicy="FIRST" outputLabel="Mức xếp loại theo kết quả nhiệm vụ">
      <input id="xep-loai-dang-in1" label="Điểm kết quả thực hiện nhiệm vụ">
        <inputExpression id="xep-loai-dang-in1-expr" typeRef="number"><text>diem</text></inputExpression>
      </input>
      <input id="xep-loai-dang-in2" label="Mức tiêu chí chung">
        <inputExpression id="xep-loai-dang-in2-expr" typeRef="string"><text>muc_tieu_chi_chung</text></inputExpression>
        <inputValues id="xep-loai-dang-in2-values"><text>"THUC_HIEN_TOT","DAM_BAO","CO_BAN_DAM_BAO","KHONG_DAM_BAO"</text></inputValues>
      </input>
      <input id="xep-loai-dang-in3" label="Thuộc điều kiện loại trừ">
        <inputExpression id="xep-loai-dang-in3-expr" typeRef="boolean"><text>loai_tru</text></inputExpression>
      </input>
      <input id="xep-loai-dang-in4" label="Tỷ lệ hoàn thành mục tiêu">
        <inputExpression id="xep-loai-dang-in4-expr" typeRef="number"><text>ty_le_O</text></inputExpression>
      </input>
      <input id="xep-loai-dang-in5" label="Đạt tỷ lệ nhiệm vụ vượt mục tiêu">
        <inputExpression id="xep-loai-dang-in5-expr" typeRef="boolean"><text>dat_ty_le_vuot</text></inputExpression>
      </input>
      <input id="xep-loai-dang-in6" label="Có giải pháp đột phá được kiểm chứng">
        <inputExpression id="xep-loai-dang-in6-expr" typeRef="boolean"><text>giai_phap_dot_pha_da_kiem_chung</text></inputExpression>
      </input>
      <input id="xep-loai-dang-in7" label="Có nhiệm vụ then chốt chưa hoàn thành do chủ quan">
        <inputExpression id="xep-loai-dang-in7-expr" typeRef="boolean"><text>truot_then_chot_chu_quan</text></inputExpression>
      </input>
      <output id="xep-loai-dang-out" name="xep_loai" typeRef="string">
        <outputValues id="xep-loai-dang-out-values"><text>"HTXSNV","HTTNV","HTNV","KHTNV"</text></outputValues>
      </output>
      <annotation name="legal_ref"/>
      <annotation name="dieu_khoan"/>
      <annotation name="giai_thich"/>
      <annotation name="mau_ha_muc"/>
      <rule id="xep-loai-dang-dong-1">
        <description>Dưới 60 điểm</description>
        <inputEntry id="xep-loai-dang-dong-1-in1"><text>&lt; 60</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-1-in2"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-1-in3"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-1-in4"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-1-in5"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-1-in6"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-1-in7"><text>-</text></inputEntry>
        <outputEntry id="xep-loai-dang-dong-1-out"><text>"KHTNV"</text></outputEntry>
        <annotationEntry><text>QĐ Điều 11; BR-09-09</text></annotationEntry>
        <annotationEntry><text>Điều 11 của Quy định</text></annotationEntry>
        <annotationEntry><text>Điểm kết quả thực hiện nhiệm vụ {diem} dưới 60 nên xếp loại Không hoàn thành nhiệm vụ theo {dieu_khoan}. Bộ quy định đánh giá {phien_ban}.</text></annotationEntry>
        <annotationEntry><text>-</text></annotationEntry>
      </rule>
      <rule id="xep-loai-dang-dong-2">
        <description>Tiêu chí chung Không đảm bảo</description>
        <inputEntry id="xep-loai-dang-dong-2-in1"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-2-in2"><text>"KHONG_DAM_BAO"</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-2-in3"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-2-in4"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-2-in5"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-2-in6"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-2-in7"><text>-</text></inputEntry>
        <outputEntry id="xep-loai-dang-dong-2-out"><text>"KHTNV"</text></outputEntry>
        <annotationEntry><text>QĐ Điều 10, Điều 11; BR-09-09</text></annotationEntry>
        <annotationEntry><text>Điều 10 và Điều 11 của Quy định</text></annotationEntry>
        <annotationEntry><text>Tiêu chí chung được đánh giá Không đảm bảo nên xếp loại Không hoàn thành nhiệm vụ theo {dieu_khoan}. Bộ quy định đánh giá {phien_ban}.</text></annotationEntry>
        <annotationEntry><text>-</text></annotationEntry>
      </rule>
      <rule id="xep-loai-dang-dong-3">
        <description>Thuộc điều kiện loại trừ</description>
        <inputEntry id="xep-loai-dang-dong-3-in1"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-3-in2"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-3-in3"><text>true</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-3-in4"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-3-in5"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-3-in6"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-3-in7"><text>-</text></inputEntry>
        <outputEntry id="xep-loai-dang-dong-3-out"><text>"KHTNV"</text></outputEntry>
        <annotationEntry><text>QĐ khoản 11.2.4; BR-09-09</text></annotationEntry>
        <annotationEntry><text>khoản 11.2.4 Điều 11 của Quy định</text></annotationEntry>
        <annotationEntry><text>Thuộc trường hợp loại trừ nên xếp loại Không hoàn thành nhiệm vụ theo {dieu_khoan}. Bộ quy định đánh giá {phien_ban}.</text></annotationEntry>
        <annotationEntry><text>-</text></annotationEntry>
      </rule>
      <rule id="xep-loai-dang-dong-4">
        <description>Hoàn thành xuất sắc: đủ đồng thời mọi điều kiện</description>
        <inputEntry id="xep-loai-dang-dong-4-in1"><text>&gt;= 90</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-4-in2"><text>"THUC_HIEN_TOT"</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-4-in3"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-4-in4"><text>&gt;= 1</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-4-in5"><text>true</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-4-in6"><text>true</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-4-in7"><text>false</text></inputEntry>
        <outputEntry id="xep-loai-dang-dong-4-out"><text>"HTXSNV"</text></outputEntry>
        <annotationEntry><text>QĐ Điều 11; BR-09-07</text></annotationEntry>
        <annotationEntry><text>Điều 11 của Quy định</text></annotationEntry>
        <annotationEntry><text>Đạt {diem} điểm và đủ các điều kiện của mức Hoàn thành xuất sắc nhiệm vụ theo {dieu_khoan}. Bộ quy định đánh giá {phien_ban}.</text></annotationEntry>
        <annotationEntry><text>-</text></annotationEntry>
      </rule>
      <rule id="xep-loai-dang-dong-5">
        <description>Hoàn thành tốt; cũng là mức liền kề khi thiếu điều kiện xuất sắc</description>
        <inputEntry id="xep-loai-dang-dong-5-in1"><text>&gt;= 80</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-5-in2"><text>"THUC_HIEN_TOT","DAM_BAO"</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-5-in3"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-5-in4"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-5-in5"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-5-in6"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-5-in7"><text>false</text></inputEntry>
        <outputEntry id="xep-loai-dang-dong-5-out"><text>"HTTNV"</text></outputEntry>
        <annotationEntry><text>QĐ Điều 11; PL 6 §12; BR-09-08; BR-09-10</text></annotationEntry>
        <annotationEntry><text>Điều 11 và Phụ lục 6, mục 12 của Quy định</text></annotationEntry>
        <annotationEntry><text>Đạt {diem} điểm và đủ các điều kiện của mức Hoàn thành tốt nhiệm vụ theo {dieu_khoan}. Bộ quy định đánh giá {phien_ban}.</text></annotationEntry>
        <annotationEntry><text>ha_muc</text></annotationEntry>
      </rule>
      <rule id="xep-loai-dang-dong-6">
        <description>Hoàn thành; cũng là mức liền kề khi thiếu điều kiện hoàn thành tốt</description>
        <inputEntry id="xep-loai-dang-dong-6-in1"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-6-in2"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-6-in3"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-6-in4"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-6-in5"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-6-in6"><text>-</text></inputEntry>
        <inputEntry id="xep-loai-dang-dong-6-in7"><text>-</text></inputEntry>
        <outputEntry id="xep-loai-dang-dong-6-out"><text>"HTNV"</text></outputEntry>
        <annotationEntry><text>QĐ Điều 11; PL 6 §12; BR-09-09; BR-09-10</text></annotationEntry>
        <annotationEntry><text>Điều 11 và Phụ lục 6, mục 12 của Quy định</text></annotationEntry>
        <annotationEntry><text>Đạt {diem} điểm, tiêu chí chung từ Cơ bản đảm bảo trở lên, xếp loại Hoàn thành nhiệm vụ theo {dieu_khoan}. Bộ quy định đánh giá {phien_ban}.</text></annotationEntry>
        <annotationEntry><text>ha_muc</text></annotationEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
