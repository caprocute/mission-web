<?xml version="1.0" encoding="UTF-8"?>
<!-- BẢN GIẢ LẬP chờ nghiệp vụ duyệt (DL-16). Bước 2 của chuỗi xếp loại; table_key tran_theo_tieu_chi_chung; gói twd/diem-cong-viec -->
<definitions xmlns="https://www.omg.org/spec/DMN/20211108/MODEL/" id="tran-theo-tieu-chi-chung-twd-dinh-nghia" name="Trần mức theo tiêu chí chung"
             namespace="https://policy.okrkpi.vn/twd/diem-cong-viec" expressionLanguage="https://www.omg.org/spec/DMN/20211108/FEEL/" typeLanguage="https://www.omg.org/spec/DMN/20211108/FEEL/">
  <decision id="tran-theo-tieu-chi-chung-twd" name="Trần mức theo tiêu chí chung">
    <variable id="tran-theo-tieu-chi-chung-twd-var" name="tran_theo_tieu_chi_chung" typeRef="string"/>
    <decisionTable id="tran-theo-tieu-chi-chung-twd-bang" hitPolicy="FIRST" outputLabel="Trần theo tiêu chí chung">
      <input id="tran-theo-tieu-chi-chung-twd-in1" label="Mức tiêu chí chung">
        <inputExpression id="tran-theo-tieu-chi-chung-twd-in1-expr" typeRef="string"><text>muc_tieu_chi_chung</text></inputExpression>
        <inputValues id="tran-theo-tieu-chi-chung-twd-in1-values"><text>"THUC_HIEN_TOT","DAM_BAO","CO_BAN_DAM_BAO","KHONG_DAM_BAO"</text></inputValues>
      </input>
      <output id="tran-theo-tieu-chi-chung-twd-out" name="tran_theo_tieu_chi_chung" typeRef="string">
        <outputValues id="tran-theo-tieu-chi-chung-twd-out-values"><text>"HTXSNV","HTTNV","HTNV","KHTNV"</text></outputValues>
      </output>
      <annotation name="legal_ref"/>
      <annotation name="dieu_khoan"/>
      <annotation name="giai_thich"/>
      <rule id="tran-theo-tieu-chi-chung-twd-dong-1">
        <description>Thực hiện tốt</description>
        <inputEntry id="tran-theo-tieu-chi-chung-twd-dong-1-in1"><text>"THUC_HIEN_TOT"</text></inputEntry>
        <outputEntry id="tran-theo-tieu-chi-chung-twd-dong-1-out"><text>"HTXSNV"</text></outputEntry>
        <annotationEntry><text>Đặc tả UEB 18.5 bước 2</text></annotationEntry>
        <annotationEntry><text>Điều 11 của dự thảo Quy định</text></annotationEntry>
        <annotationEntry><text>Tiêu chí chung được đánh giá Thực hiện tốt nên trần theo tiêu chí chung là mức Hoàn thành xuất sắc nhiệm vụ.</text></annotationEntry>
      </rule>
      <rule id="tran-theo-tieu-chi-chung-twd-dong-2">
        <description>Đảm bảo</description>
        <inputEntry id="tran-theo-tieu-chi-chung-twd-dong-2-in1"><text>"DAM_BAO"</text></inputEntry>
        <outputEntry id="tran-theo-tieu-chi-chung-twd-dong-2-out"><text>"HTTNV"</text></outputEntry>
        <annotationEntry><text>Đặc tả UEB 18.5 bước 2</text></annotationEntry>
        <annotationEntry><text>Điều 11 của dự thảo Quy định</text></annotationEntry>
        <annotationEntry><text>Tiêu chí chung được đánh giá Đảm bảo nên trần theo tiêu chí chung là mức Hoàn thành tốt nhiệm vụ.</text></annotationEntry>
      </rule>
      <rule id="tran-theo-tieu-chi-chung-twd-dong-3">
        <description>Cơ bản đảm bảo</description>
        <inputEntry id="tran-theo-tieu-chi-chung-twd-dong-3-in1"><text>"CO_BAN_DAM_BAO"</text></inputEntry>
        <outputEntry id="tran-theo-tieu-chi-chung-twd-dong-3-out"><text>"HTNV"</text></outputEntry>
        <annotationEntry><text>Đặc tả UEB 18.5 bước 2</text></annotationEntry>
        <annotationEntry><text>Điều 11 của dự thảo Quy định</text></annotationEntry>
        <annotationEntry><text>Tiêu chí chung được đánh giá Cơ bản đảm bảo nên trần theo tiêu chí chung là mức Hoàn thành nhiệm vụ.</text></annotationEntry>
      </rule>
      <rule id="tran-theo-tieu-chi-chung-twd-dong-4">
        <description>Không đảm bảo</description>
        <inputEntry id="tran-theo-tieu-chi-chung-twd-dong-4-in1"><text>"KHONG_DAM_BAO"</text></inputEntry>
        <outputEntry id="tran-theo-tieu-chi-chung-twd-dong-4-out"><text>"KHTNV"</text></outputEntry>
        <annotationEntry><text>Đặc tả UEB 18.5 bước 2</text></annotationEntry>
        <annotationEntry><text>Điều 11 của dự thảo Quy định</text></annotationEntry>
        <annotationEntry><text>Tiêu chí chung được đánh giá Không đảm bảo nên trần theo tiêu chí chung là mức Không hoàn thành nhiệm vụ.</text></annotationEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
